#. Tag: title
#: man-plasmaengineexplorer.1.docbook:8
#, no-c-format
msgid "KDE User's Manual"
msgstr "Manual d'usuariu KDE"

#. Tag: date
#: man-plasmaengineexplorer.1.docbook:9
#, no-c-format
msgid "2010-10-06"
msgstr ""

#. Tag: productname
#: man-plasmaengineexplorer.1.docbook:10
#, no-c-format
msgid "K Desktop Environment"
msgstr ""

#. Tag: manvolnum
#: man-plasmaengineexplorer.1.docbook:15
#, no-c-format
msgid "<manvolnum>1</manvolnum>"
msgstr ""

#. Tag: refpurpose
#: man-plasmaengineexplorer.1.docbook:20
#, no-c-format
msgid "Provides direct access to plasma data engines"
msgstr ""

#. Tag: cmdsynopsis
#: man-plasmaengineexplorer.1.docbook:24
#, no-c-format
msgid ""
"<command>plasmaengineexplorer</command> <group choice=\"opt\"><option>--"
"list</option></group> <group choice=\"opt\"><option>--height</option> "
"<replaceable> pixels</replaceable></group> <group choice=\"opt\"><option>--"
"width</option> <replaceable> pixels</replaceable></group> <group choice=\"opt"
"\"><option>-x</option> <replaceable> pixels</replaceable></group> <group "
"choice=\"opt\"><option>-y</option> <replaceable> pixels</replaceable></"
"group> <group choice=\"opt\"><option>--engine</option> <replaceable> data "
"engine</replaceable></group> <group choice=\"opt\"><option>--source</option> "
"<replaceable> data engine</replaceable></group> <group choice=\"opt"
"\"><option>--interval</option> <replaceable> ms</replaceable></group> <group "
"choice=\"opt\"><option>--app</option> <replaceable> application</"
"replaceable></group>"
msgstr ""

#. Tag: cmdsynopsis
#: man-plasmaengineexplorer.1.docbook:38
#, no-c-format
msgid ""
"<command>plasmaengineexplorer</command> <arg choice=\"opt\">KDE Generic "
"Options</arg> <arg choice=\"opt\">Qt Generic Options</arg>"
msgstr ""

#. Tag: title
#: man-plasmaengineexplorer.1.docbook:46
#, no-c-format
msgid "Description"
msgstr ""

#. Tag: para
#: man-plasmaengineexplorer.1.docbook:47
#, no-c-format
msgid ""
"<command>plasmaengineexplorer</command> is a graphical tool allowing "
"developers to test Plasma data engines without writing a Plasma applet."
msgstr ""

#. Tag: para
#: man-plasmaengineexplorer.1.docbook:50
#, no-c-format
msgid ""
"If no options are given, it will start without any data engine selected. The "
"required data engine can be selected from a drop-down list."
msgstr ""

#. Tag: para
#: man-plasmaengineexplorer.1.docbook:53
#, no-c-format
msgid ""
"Only installed data engines will be found. <command>kbuildsycoca4</command> "
"may need to be run for newly-installed data engines to be found."
msgstr ""

#. Tag: title
#: man-plasmaengineexplorer.1.docbook:59
#, no-c-format
msgid "Options"
msgstr ""

#. Tag: option
#: man-plasmaengineexplorer.1.docbook:63
#, no-c-format
msgid "--list <replaceable>pixels</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmaengineexplorer.1.docbook:64
#, no-c-format
msgid "Displays a list of known engines and their descriptions."
msgstr ""

#. Tag: option
#: man-plasmaengineexplorer.1.docbook:67
#, no-c-format
msgid "--height"
msgstr ""

#. Tag: para
#: man-plasmaengineexplorer.1.docbook:68
#, no-c-format
msgid "Sets the height of the window, in pixels."
msgstr ""

#. Tag: option
#: man-plasmaengineexplorer.1.docbook:71
#, no-c-format
msgid "--width <replaceable>pixels</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmaengineexplorer.1.docbook:72
#, no-c-format
msgid "Sets the width of the window, in pixels."
msgstr ""

#. Tag: option
#: man-plasmaengineexplorer.1.docbook:75
#, no-c-format
msgid "-x <replaceable>pixels</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmaengineexplorer.1.docbook:76
#, no-c-format
msgid ""
"Sets the x (horizontal) co-ordinate of the top left corner of the window, in "
"pixels."
msgstr ""

#. Tag: option
#: man-plasmaengineexplorer.1.docbook:79
#, no-c-format
msgid "-y <replaceable>pixels</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmaengineexplorer.1.docbook:80
#, no-c-format
msgid ""
"Sets the y (vertical) co-ordinate of the top left corner of the window, in "
"pixels."
msgstr ""

#. Tag: option
#: man-plasmaengineexplorer.1.docbook:83
#, no-c-format
msgid "--engine <replaceable>data engine</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmaengineexplorer.1.docbook:84
#, no-c-format
msgid ""
"Start <command>plasmaengineexplorer</command> with the given data engine "
"selected. <parameter>data engine</parameter> is the internal name of the "
"data engine given by the X-KDE-PluginInfo-Name key of the desktop file."
msgstr ""

#. Tag: option
#: man-plasmaengineexplorer.1.docbook:89
#, no-c-format
msgid "--source <replaceable>data engine</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmaengineexplorer.1.docbook:90
#, no-c-format
msgid ""
"Only valid in conjunction with <option>--engine</option>. Requests a "
"specific source from the data engine when <command>plasmaengineexplorer</"
"command> is started."
msgstr ""

#. Tag: option
#: man-plasmaengineexplorer.1.docbook:95
#, no-c-format
msgid "--interval <replaceable>time</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmaengineexplorer.1.docbook:96
#, no-c-format
msgid ""
"Sets the default update interval for requested sources to <parameter>time</"
"parameter> milliseconds. If not set, the source will update on demand (for "
"some sources, this will be when new data is available)."
msgstr ""

#. Tag: para
#: man-plasmaengineexplorer.1.docbook:100
#, no-c-format
msgid ""
"If <option>--source</option> is specified, this is the update interval that "
"will be used when requesting that source."
msgstr ""

#. Tag: option
#: man-plasmaengineexplorer.1.docbook:104
#, no-c-format
msgid "--app <replaceable>application</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmaengineexplorer.1.docbook:105
#, no-c-format
msgid ""
"Only show engines associated with the parent application; maps to the X-KDE-"
"ParentApp entry in the DataEngine's .desktop file."
msgstr ""

#. Tag: title
#: man-plasmaengineexplorer.1.docbook:114
#, no-c-format
msgid "See Also"
msgstr ""

#. Tag: para
#: man-plasmaengineexplorer.1.docbook:116
#, no-c-format
msgid ""
"More detailed user documentation is available from <ulink url=\"help:/plasma-"
"desktop\">help:/plasma-desktop</ulink> (either enter this <acronym>URL</"
"acronym> into &konqueror;, or run <userinput><command>khelpcenter</command> "
"<parameter>help:/plasma-desktop</parameter></userinput>)."
msgstr ""

#. Tag: title
#: man-plasmaengineexplorer.1.docbook:125
#, no-c-format
msgid "Examples"
msgstr ""

#. Tag: para
#: man-plasmaengineexplorer.1.docbook:126
#, no-c-format
msgid ""
"Load the time data engine, showing the local time and updating every second:"
msgstr ""

#. Tag: screen
#: man-plasmaengineexplorer.1.docbook:128
#, no-c-format
msgid ""
"<userinput><command>plasmaengineexplorer</command> <option>--engine time</"
"option> <option>--source Local</option> <option>--interval 1000</option></"
"userinput>"
msgstr ""

