msgstr "L'accesu al sistema requier una contraseña."

#: nx/nxview.cpp:208
msgid "The authentication key is invalid."
msgstr "L'autenticación de la contraseña nun ye válida."

#: nx/nxview.cpp:208
msgid "Invalid authentication key"
msgstr "Contraseña d' autenticación no válida"

#: nx/nxview.cpp:211
msgid "The username or password that you have entered is invalid."
msgstr "El nome d'usuariu o la contraseña qu'introduxo nun son válidos."

#: nx/nxview.cpp:211
msgid "Invalid username or password"
msgstr "Nome d'usuariu o contraseña non válidos"

#: nx/nxview.cpp:214
msgid "The host key verification has failed."
msgstr "La verificación de la contraseña de dominiu nun ye válida."

#: nx/nxview.cpp:214
msgid "Host key verification failed"
msgstr "La verificación de la contraseña de dominiu falló"

#: nx/nxview.cpp:217
msgid "An error has occurred during the connection to the NX server."
msgstr "Hebo un fallu durante la conexón al sirvidor NX."

#: nx/nxview.cpp:217
msgid "Process error"
msgstr "Error de procesu"

#: nx/nxview.cpp:241
msgid "This NX server is running at capacity."
msgstr "El sirvidor NX ta executándose a toa capacidá."

#: nx/nxview.cpp:241
msgid "Server at capacity"
msgstr "Sirvidor a toa capacidá"

#: nx/nxviewfactory.cpp:64
msgid "New NX Connection..."
msgstr "Nueva conexón NX"

#: nx/nxviewfactory.cpp:69
msgid "Connect to a NX Remote Desktop"
msgstr "Coneutar a un escritoriu remotu NX"

#: nx/nxviewfactory.cpp:74
msgid ""
"<html>Enter the address here.<br /><i>Example: nxserver (host)</i></html>"
msgstr ""
"<html>Introducir la direición equí.<br /><i>Exemplu: nxserver (host)</i></"
"html>"

#: rdp/rdpview.cpp:251
msgid "Could not start \"rdesktop\"; make sure rdesktop is properly installed."
msgstr ""
"Nun foi dable arrancar «rdesktop»; por favor asegúrese de que lo tien "
"instaláu correcho."

#: rdp/rdpview.cpp:252 rdp/rdpview.cpp:262
msgid "RDP Failure"
msgstr "Fallu RDP"

#: rdp/rdpview.cpp:257
msgid "Connection attempt to host failed."
msgstr "El intento de coneutar a la máquina falló."

#: rdp/rdpview.cpp:258
msgid "Connection Failure"
msgstr "Conexón fallida"

#: rdp/rdpview.cpp:260
#, kde-format
msgid ""
"The version of \"rdesktop\" you are using (%1) is too old:\n"
"rdesktop 1.3.2 or greater is required."
msgstr ""
"La versión del escritoriu que ta usando (%1) ye enforma antigua:\n"
"requierse «rdesktop 1.3.2» o más actual."

#: rdp/rdpviewfactory.cpp:38
msgid "Connect to a Windows Remote Desktop (RDP)"
msgstr "Coneutar a una ventana d'escritoriu remotu (RDP)"

#: rdp/rdpviewfactory.cpp:69
msgid "New RDP Connection..."
msgstr "Nueva conexón RDP"

#: rdp/rdpviewfactory.cpp:79
msgid ""
"<html>Enter the address here. Port is optional.<br /><i>Example: "
"rdpserver:3389 (host:port)</i></html>"
msgstr ""
"<html>Introducir la direición equí. El puertu ye opcional.<br /><i>Exemplu: "
"rdpserver:3389 (host:port)</i></html>"

#: rdp/rdpviewfactory.cpp:86
msgid ""
"The application \"rdesktop\" cannot be found on your system; make sure it is "
"properly installed if you need RDP support."
msgstr ""
"Nun s'alcuentra «rdesktop» nel so sistema; por favor asegúrese de que lu tien "
"instaláu correcho si necesita'l sofitu RDP."

#: vnc/vncclientthread.cpp:140
msgid "Server not found."
msgstr "Sirvidor non alcontráu."

#: vnc/vncclientthread.cpp:144
msgid "VNC authentication failed because of too many authentication tries."
msgstr "Autenticación VNC fallida darréu de munchos intentos d'autenticación."

#: vnc/vncclientthread.cpp:147 vnc/vncclientthread.cpp:188
msgid "VNC authentication failed."
msgstr "Fallu de autenticación VNC."

#: vnc/vncclientthread.cpp:150
msgid "VNC server closed connection."
msgstr "Conexón zarrada col sirvidor VNC."

#: vnc/vncview.cpp:274
msgid "Authentication failed. Please try again."
msgstr "Fallu d'autenticación. Inténtelu otra vegada."

#: vnc/vncview.cpp:298 vnc/vncview.cpp:300
msgid "VNC failure"
msgstr "Fallu VNC"

#: vnc/vncviewfactory.cpp:64
msgid "New VNC Connection..."
msgstr "Nueva conexón VNC"

#: vnc/vncviewfactory.cpp:69
msgid "Connect to a VNC Remote Desktop"
msgstr "Coneutar a un escritoriu remotu VNC"

#: vnc/vncviewfactory.cpp:74
msgid ""
"<html>Enter the address here.<br /><i>Example: vncserver:1 (host:port / "
"screen)</i></html>"
msgstr ""
"<html>Introducir la direición equí.<br /><i>Exemplu: vncserver:1 (host:"
"port / screen)</i></html>"

