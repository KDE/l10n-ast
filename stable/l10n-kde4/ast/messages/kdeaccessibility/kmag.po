#: kmag.cpp:138
msgid "New &Window"
msgstr "Nueva &ventana"

#: kmag.cpp:141
msgid "Open a new KMagnifier window"
msgstr "Abrir una nueva ventana de KMagnifier"

#: kmag.cpp:145
msgid "&Stop"
msgstr "&Detener"

#: kmag.cpp:148
msgid "Click to stop window refresh"
msgstr "Calcar col mur pa detener la renovación de la ventana"

#: kmag.cpp:149
msgid ""
"Clicking on this icon will <b>start</b> / <b>stop</b>  updating of the "
"display. Stopping the update will zero the processing power  required (CPU "
"usage)"
msgstr ""
"Al calcar nesti iconu <b>aniciaráse</b> / <b>detendráse</b> l'anovamientu de "
"la imaxe. Si detién l'anovamientu, el consumu de potencia del procesador "
"sedrá cero."

#: kmag.cpp:155
msgid "&Save Snapshot As..."
msgstr "&Guardar captura como..."

#: kmag.cpp:158
msgid "Saves the zoomed view to an image file."
msgstr "Guarda la vista enantada nun ficheru d'imaxe."

#: kmag.cpp:159
msgid "Save image to a file"
msgstr "Guardar imaxe nún ficheru"

#: kmag.cpp:162
msgid "Click on this button to print the current zoomed view."
msgstr "Calque esti botón pa imprentar la vista enantada."

#: kmag.cpp:165 kmag.cpp:166
msgid "Quits the application"
msgstr "Zarra l'aplicación"

#: kmag.cpp:169
msgid ""
"Click on this button to copy the current zoomed view to the clipboard which "
"you can paste in other applications."
msgstr ""
"Calque esti botón pa copiar la vista enantada al cartafueyu y d'esta miente "
"poder apegala n'otres aplicaciones."

#: kmag.cpp:170
msgid "Copy zoomed image to clipboard"
msgstr "Copiar la vista enantada al cartafueyu"

#: kmag.cpp:172
msgid "Show &Menu"
msgstr "Amosar &Menú"

#: kmag.cpp:177
msgid "Hide &Menu"
msgstr "Anubrir &Menú"

#: kmag.cpp:179
msgid "Show Main &Toolbar"
msgstr "Amos&ar barra de ferramientes principal"

#: kmag.cpp:183
msgid "Hide Main &Toolbar"
msgstr "Anub&rir barra de ferramientas principal"

#: kmag.cpp:185
msgid "Show &View Toolbar"
msgstr "Amo&sar barra de ferramientes Ver"

#: kmag.cpp:189
msgid "Hide &View Toolbar"
msgstr "Anubrir barra de ferramientes &Ver"

#: kmag.cpp:191
msgid "Show &Settings Toolbar"
msgstr "Amosar la barra de ferramientes Preferencie&s"

#: kmag.cpp:195
msgid "Hide &Settings Toolbar"
msgstr "Anubrir la barra de ferramientes de Preferencie&s"

#: kmag.cpp:198
msgid "&Follow Mouse Mode"
msgstr "Mou &siguir al mur"

#: kmag.cpp:202
msgid "Magnify around the mouse cursor"
msgstr "Enantar alrodiu del cursor del mur"

#: kmag.cpp:203
msgid "If selected, the area around the mouse cursor is magnified"
msgstr "Si ta esbilláu, l'área alrodiu del cursor del mur amuésase enantáu"

#: kmag.cpp:205
msgid "Se&lection Window Mode"
msgstr "Mou de se&leición de ventana"

#: kmag.cpp:209
msgid "Show a window for selecting the magnified area"
msgstr "Amuesa una ventana pa esbillar l'área d'ampliación"

#: kmag.cpp:211
msgid "&Whole Screen Mode"
msgstr "Mou de pan&talla completa"

#: kmag.cpp:215
msgid "Magnify the whole screen"
msgstr "Enanta la pantalla completa"

#: kmag.cpp:216
msgid "Click on this button to fit the zoom view to the zoom window."
msgstr "Calque nesti botón p'axustar l'ampliación a la ventana enantada."

#: kmag.cpp:218
msgid "Hide Mouse &Cursor"
msgstr "Anubrir el &cursor del mur"

#: kmag.cpp:223
msgid "Show Mouse &Cursor"
msgstr "Amosar el &cursor del mur"

#: kmag.cpp:225
msgid "Hide the mouse cursor"
msgstr "Anubrir el cursor del mur"

#: kmag.cpp:228
msgid "Click on this button to <b>zoom-in</b> on the selected region."
msgstr "Calque nesti botón pa <b>enantar</b> l'área esbillada."

#: kmag.cpp:230
msgid "&Zoom"
msgstr "Aum&entar"

#: kmag.cpp:233
msgid "Select the zoom factor."
msgstr "Seleicione'l factor d'ampliación."

#: kmag.cpp:234
msgid "Zoom factor"
msgstr "Factor de zoom"

#: kmag.cpp:237
msgid "Click on this button to <b>zoom-out</b> on the selected region."
msgstr "Calque nesti botón p'<b>amenorgar</b> l'área esbillada"

#: kmag.cpp:239
msgid "&Rotation"
msgstr "Xi&ru"

#: kmag.cpp:242
msgid "Select the rotation degree."
msgstr "Seleicione'l grau de xiru."

#: kmag.cpp:243
msgid "Rotation degree"
msgstr "Grau de xiru"

#: kmag.cpp:250
msgid "&Refresh"
msgstr "Refresc&ar"

#: kmag.cpp:253
msgid ""
"Select the refresh rate. The higher the rate, the more computing power (CPU) "
"will be needed."
msgstr ""
"Esbillle una tasa de refrescu. Cuanto más altu seya'l valor, más potencia de "
"procesador (CPU) sedrá necesaria."

#: kmag.cpp:254
msgid "Refresh rate"
msgstr "Tasa de refrescu"

#: kmag.cpp:256
msgctxt "Color-blindness simulation mode"
msgid "&Color"
msgstr "&Color"

#: kmag.cpp:259
msgid "Select a mode to simulate various types of color-blindness."
msgstr "Esbille un mou pa simular distintes tribes de ceguera al color."

#: kmag.cpp:260
msgid "Color-blindness Simulation Mode"
msgstr "Mou de simulación de ceguera al color"

#: kmag.cpp:617
msgid "Save Snapshot As"
msgstr "Guardar captura como"

#: kmag.cpp:627
msgid ""
"Unable to save temporary file (before uploading to the network file you "
"specified)."
msgstr ""
"Nun puede guardase'l ficheru temporal (enantes de xubilu al ficheru de rede "
"que vusté especificó)."

#: kmag.cpp:628 kmag.cpp:632 kmag.cpp:645
msgid "Error Writing File"
msgstr "Fallu al escribir el ficheru"

#: kmag.cpp:631
msgid "Unable to upload file over the network."
msgstr "Nun puede unviase'l ficheru a la rede."

#: kmag.cpp:634 kmag.cpp:647
#, kde-format
msgid ""
"Current zoomed image saved to\n"
"%1"
msgstr ""
"Imaxe enantada actual, guardóse en\n"
"%1"

#: kmag.cpp:635 kmag.cpp:648
msgid "Information"
msgstr "Información"

#: kmag.cpp:644
msgid ""
"Unable to save file. Please check if you have permission to write to the "
"directory."
msgstr ""
"Nun puede guardase'l ficheru. Compruebe que tien permisos d'escritura na "
"carpeta."

#: kmag.cpp:663
msgid "Stop"
msgstr "Parar"

#: kmag.cpp:664
msgid "Click to stop window update"
msgstr "Calque pa detener l'anovamientu de la ventana"

#: kmag.cpp:667
msgctxt "Start updating the window"
msgid "Start"
msgstr "Aniciar"

#: kmag.cpp:668
msgid "Click to start window update"
msgstr "Calque p'aniciar l'anovamientu de la ventana"

