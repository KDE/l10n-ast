#: kcmtrash.cpp:139
#, kde-format
msgctxt ""
"%1 is amount of disk space, %2 the unit, KBytes, MBytes, GBytes, TBytes, etc."
msgid "(%1 %2)"
msgstr "(%1 %2)"

#: kcmtrash.cpp:178 kcmtrash.cpp:278
msgid " day"
msgid_plural " days"
msgstr[0] " día"
msgstr[1] " díes"

#: kcmtrash.cpp:269
msgid "Delete files older than:"
msgstr "Desaniciar ficheros anteriores a:"

#: kcmtrash.cpp:271
msgctxt "@info:whatsthis"
msgid ""
"<para>Check this box to allow <b>automatic deletion</b> of files that are "
"older than the value specified. Leave this disabled to <b>not</b> "
"automatically delete any items after a certain timespan</para>"
msgstr ""
"<para>Marca esti cuadru pa permitir <b>borráu automáticu</b> de ficheros que "
"son anteriores a un valor especificáu. Déxalo desactivao pa <b>nun</b> "
"desaniciar dengún elementu pasáu esi tiempu</para>"

#: kcmtrash.cpp:280
msgctxt "@info:whatsthis"
msgid ""
"<para>Set the number of days that files can remain in the trash. Any files "
"older than this will be automatically deleted.</para>"
msgstr ""
"<para>Introduz el númberu de díes que los ficheros pueden permanecer na "
"papelera. Cualesquier ficheru más antiguu desaniciaráse automáticamente.</"
"para>."

#: kcmtrash.cpp:287
msgid "Limit to maximum size"
msgstr "Llimitar a un tamañu máximu"

#: kcmtrash.cpp:289
msgctxt "@info:whatsthis"
msgid ""
"<para>Check this box to limit the trash to the maximum amount of disk space "
"that you specify below. Otherwise, it will be unlimited.</para>"
msgstr ""
"<para>Marca esta opción si quies llimitar el tamañu máximu de la papelera al "
"tamañu d'embaxu. Si nun lo faes será illimitáu.</para>"

#: kcmtrash.cpp:300
msgid "Maximum size:"
msgstr "Tamañu máximu:"

#: kcmtrash.cpp:309
msgctxt "@info:whatsthis"
msgid ""
"<para>This is the maximum percent of disk space that will be used for the "
"trash.</para>"
msgstr ""
"<para>Ye'l máximu porcentaxe de discu que va usase pa la papelera.</para>"

#: kcmtrash.cpp:314
msgctxt "@info:whatsthis"
msgid ""
"<para>This is the calculated amount of disk space that will be allowed for "
"the trash, the maximum.</para>"
msgstr ""
"<para>Ye la cantidá d'espaciu en discu permitíu, como máximu, pa la papelera."
"</para>"

#: kcmtrash.cpp:317
msgid "When limit reached:"
msgstr "Al algamar el llímite:"

#: kcmtrash.cpp:321
msgid "Warn Me"
msgstr "Avisame"

#: kcmtrash.cpp:322
msgid "Delete Oldest Files From Trash"
msgstr "Desaniciar los ficheros más vieyos de la papelera"

#: kcmtrash.cpp:323
msgid "Delete Biggest Files From Trash"
msgstr "Desaniciar los ficheros más grandes de la papelera"

#: kcmtrash.cpp:325
msgctxt "@info:whatsthis"
msgid ""
"<para>When the size limit is reached, it will prefer to delete the type of "
"files that you specify, first. If this is set to warn you, it will do so "
"instead of automatically deleting files.</para>"
msgstr ""
"<para>Cuando'l s'algame'l tamañu llímite, ye preferible desaniciar la triba "
"de ficheru qu'especifiques primero. Si ta configuráu p'advertite, fadráse "
"eso, en llugar de desaniciar automáticamente los ficheros.</para>"

#: kio_trash.cpp:92 kio_trash.cpp:155 kio_trash.cpp:307 kio_trash.cpp:339
#: kio_trash.cpp:505 kio_trash.cpp:517
#, kde-format
msgid "Malformed URL %1"
msgstr "URL incorreuta %1"

#: kio_trash.cpp:111
#, kde-format
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore "
"this item to its original location. You can either recreate that directory "
"and use the restore operation again, or drag the item anywhere else to "
"restore it."
msgstr ""
"Ye posible que'l direutoriu %1 ya nun exista, asina que nun puedes "
"restauralu a la so ubicación orixinal. Puedes recrear esi direutoriu y usalu "
"na operación de restauración o arrastralu a cualesquier otru sitiu pa "
"restauralu."

#: kio_trash.cpp:140 kio_trash_win.cpp:228
msgid "This file is already in the trash bin."
msgstr "Esti ficheru yá ta na papelera."

#: kio_trash.cpp:228 kio_trash_win.cpp:252
msgid "Internal error in copyOrMove, should never happen"
msgstr "Fallu internu en copiarOMover, non debería pasar"

#: kio_trash_win.cpp:241
msgid "not supported"
msgstr "non sofitáu"

#: ktrash.cpp:32
msgid "ktrash"
msgstr "ktrash"

#: ktrash.cpp:34
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kioclient move "
"'url' trash:/\""
msgstr ""
"Aida pa remanar la papelera de KDE\n"
"Nota: pa mover ficheros a la papelera, nun uses ktrash sinon «kfmclient move "
"«url» trash:/»"

#: ktrash.cpp:38
msgid "Empty the contents of the trash"
msgstr "Vaciar el conteníu de la papelera"

#: ktrash.cpp:40
msgid "Restore a trashed file to its original location"
msgstr "Devolver un ficheru de la papelera a la so ubicación orixinal"

#: ktrash.cpp:42
msgid "Ignored"
msgstr "Inoráu"

#: trashimpl.cpp:1125
msgid ""
"The trash has reached its maximum size!\n"
"Cleanup the trash manually."
msgstr ""
"La papelera algamó'l so tamañu máximu.\n"
"Llímpiala manualmente."

#: trashimpl.cpp:1136
msgid "The file is too large to be trashed."
msgstr "El ficheru ye mui grande pa movelu a la papelera."
