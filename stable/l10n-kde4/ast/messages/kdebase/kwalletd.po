msgstr "<qt>Escueyi una nueva contraseña pa la cartera «<b>%1</b>».</qt>"

#: kwalletd.cpp:712
msgid "Error re-encrypting the wallet. Password was not changed."
msgstr "Fallu al cifrar de nuevu la cartera. La contraseña nun camudó."

#: kwalletd.cpp:717
msgid "Error reopening the wallet. Data may be lost."
msgstr "Fallu al reabrir la cartera. Los datos pueden habese perdío."

#: kwalletd.cpp:1227
msgid ""
"There have been repeated failed attempts to gain access to a wallet. An "
"application may be misbehaving."
msgstr ""
"Fexéronse dellos intentos fallíos d'accesu a la cartera. Puede qu'heba una "
"aplicación desbocada."

