#: main.cpp:52
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"L'alministrador de sesiones fiable de KDE que se comunica col protocolu estándar \n"
"p'alministración de sesiones de X11R6 (XSMP)."

#: main.cpp:233
msgid "The KDE Session Manager"
msgstr "El Xestor de Sesión KDE"

#: main.cpp:235
msgid "(C) 2000, The KDE Developers"
msgstr "(C) 2000, The KDE Developers"

#: main.cpp:236
msgid "Matthias Ettrich"
msgstr "Matthias Ettrich"

#: main.cpp:237
msgid "Luboš Luňák"
msgstr "Luboš Luňák"

#: main.cpp:237
msgid "Maintainer"
msgstr "Caltenimientu"

#: main.cpp:245
msgid "Restores the saved user session if available"
msgstr "Restaurar la sesión grabada del usuariu si ta algamable"

#: main.cpp:247
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Aniciar 'wm' si dengún xestor de ventanes\n"
"ta participando na sesión. Por defectu ye 'kwin'"

#: main.cpp:248
msgid "Also allow remote connections"
msgstr "Permitir tamién conexones remotes"

