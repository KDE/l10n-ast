#: random.cpp:45
#, kde-format
msgid ""
"Usage: %1 [-setup] [args]\n"
"Starts a random screen saver.\n"
"Any arguments (except -setup) are passed on to the screen saver."
msgstr ""
"Usu: %1 [-setup] [args]\n"
"Anicia un curiapantalles al debalu.\n"
"Tolos argumentos (esceutu -setup) pásense al curiapantalles."

#: random.cpp:52
msgid "Start a random KDE screen saver"
msgstr "Anicia un curiapantalles de KDE al debalu"

#: random.cpp:67
msgid "Random screen saver"
msgstr "Curiapantalles al debalu"

#: random.cpp:73
msgid "Setup screen saver"
msgstr "Configurar el curiapantalles"

#: random.cpp:75
msgid "Run in the specified XWindow"
msgstr "Executar na ventana X especificada"

#: random.cpp:77
msgid "Run in the root XWindow"
msgstr "Executar na ventana X raíz"

#: random.cpp:201
msgid "Setup Random Screen Saver"
msgstr "Configurar curiapantalles al debalu"

#: random.cpp:209
msgid "Use OpenGL screen savers"
msgstr "Usar curiapantalles OpenGL"

#: random.cpp:212
msgid "Use screen savers that manipulate the screen"
msgstr "Usar curiapantalles que remanen la pantalla"
