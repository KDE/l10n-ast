#. i18n: file: element_tiny.xml:4
#: rc.cpp:359
msgid "Greek 'hydro' and 'gennao' for 'forms water'"
msgstr "Del griegu «hydro» y «gennao», que significa «que forma agua»."

#. i18n: file: element_tiny.xml:6
#: rc.cpp:361
msgid "The Greek word for the sun was 'helios'"
msgstr "Del griegu «helios», que significa «sol»."

#. i18n: file: element_tiny.xml:8
#: rc.cpp:363
msgid "Greek 'lithos' means 'stone'"
msgstr "Del griegu «lithos», que significa «piedra»."

#. i18n: file: element_tiny.xml:10
#: rc.cpp:365
msgid "Greek 'beryllos' for 'light-green stone'"
msgstr "Del griegu «beryllos», que significa «piedra verde brillante»."

#. i18n: file: element_tiny.xml:12
#: rc.cpp:367
msgid ""
"Boron means 'Bor(ax) + (carb)on'. It is found in borax and behaves a lot "
"like carbon"
msgstr ""
"De «bórax», del árabe «buraq» y del persa «bure», que tamién signifiquen «bórax»."

#. i18n: file: element_tiny.xml:14
#: rc.cpp:369
msgid "Latin 'carboneum' for carbon"
msgstr "Del llatín «carboneum», que significa «carbón»."

#. i18n: file: element_tiny.xml:16
#: rc.cpp:371
msgid "Latin 'nitrogenium' ('forms saltpeter')"
msgstr "Del llatín «nitrogenium», que significa «que forma nitratos»."

#. i18n: file: element_tiny.xml:18
#: rc.cpp:373
msgid "Latin 'oxygenium' (forms acids)"
msgstr "Del llatín «oxygenium» (forma ácidos)."

#. i18n: file: element_tiny.xml:20
#: rc.cpp:375
msgid "Latin 'fluere' ('floats')"
msgstr "Del llatín «fluere», que significa «que flota»."

#. i18n: file: element_tiny.xml:22
#: rc.cpp:377
msgid "Greek 'neo'. meaning 'new'"
msgstr "Del griegu «neo», que significa «nuevo»."

#. i18n: file: element_tiny.xml:24
#: rc.cpp:379
msgid "Arabic 'natrun' for 'soda'"
msgstr "Del árabe «natrum», que significa «sosa»."

#. i18n: file: element_tiny.xml:26
#: rc.cpp:381
msgid "Named after the city of Magnesia"
msgstr "Nomáu pola ciudá de Magnesia."

#. i18n: file: element_tiny.xml:28
#: rc.cpp:383
msgid "Latin 'alumen'"
msgstr "Del llatín «alumen»."

#. i18n: file: element_tiny.xml:30
#: rc.cpp:385
msgid "Latin 'silex'"
msgstr "Del llatín «silex»."

#. i18n: file: element_tiny.xml:32
#: rc.cpp:387
msgid "Greek 'phosphoros' for 'carries light'"
msgstr "Del griegu «phosphoros», que significa «portador de lluz»."

#. i18n: file: element_tiny.xml:34
#: rc.cpp:389
msgid "In sanskrit 'sweb' means 'to sleep'"
msgstr "En sánscritu «sweb» significa «dormir»."

#. i18n: file: element_tiny.xml:36
#: rc.cpp:391
msgid "Greek 'chloros' for 'yellow-green'"
msgstr "Del griegu «chloros», que significa «verde marillentu»."

#. i18n: file: element_tiny.xml:38
#: rc.cpp:393
msgid "Greek 'aergon' for 'inactive'"
msgstr "Del griegu «aergon», que significa «inactivu»."

#. i18n: file: element_tiny.xml:40
#: rc.cpp:395
msgid "Arabic 'al qaliy' for potash"
msgstr "Del árabe «al qaliy», que significa «potasa»."

#. i18n: file: element_tiny.xml:42
#: rc.cpp:397
msgid "Latin 'calx' for 'lime'"
msgstr "Del llatín «calx», que significa «cal»."

#. i18n: file: element_tiny.xml:44
#: rc.cpp:399
msgid "Named because it was found in Scandinavia"
msgstr "Nomáu así porque alcontróse n'Escandinavia."

#. i18n: file: element_tiny.xml:46
#: rc.cpp:401
msgid "The Titans were giants in Greek mythology"
msgstr "Los titanes foron xigantes na mitoloxía griega."

#. i18n: file: element_tiny.xml:48
#: rc.cpp:403
msgid "'Vanadis' is another name for the Nordic goddess Freyja"
msgstr "«Vanadis» ye otru nome de la diosa nórdica Freyja."

#. i18n: file: element_tiny.xml:50
#: rc.cpp:405
msgid "Greek 'chroma' means 'color'"
msgstr "En griegu «chroma» significa «color»."

#. i18n: file: element_tiny.xml:52
#: rc.cpp:407
msgid ""
"It was discovered near a town named Magnesia in black earth. Thus, it was "
"named 'magnesia nigra', or for short, Manganese."
msgstr ""
"Descubiertu cerca d'una ciudá nomada Magnesia como mineral prietu. Darréu, "
"nomóse «magnesia nigra» o ,abreviáu , Manganesu."

#. i18n: file: element_tiny.xml:54
#: rc.cpp:409
msgid "Latin 'ferrum'"
msgstr "Del llatín «ferrum»."

#. i18n: file: element_tiny.xml:56
#: rc.cpp:411
msgid "Named after the German word 'Kobold' for 'goblin'"
msgstr "Nomáu pola pallabra alemana «Kobold», que significa «trasgu»."

#. i18n: file: element_tiny.xml:58
#: rc.cpp:413
msgid "'Nickel' was the name of a mountain goblin"
msgstr "«Nickel» yera'l nome d'un trasgu de les montañes."

#. i18n: file: element_tiny.xml:60
#: rc.cpp:415
msgid "Greek 'cuprum' for Cypres"
msgstr "Del griegu «kupros», que vien de «Chipre»."

#. i18n: file: element_tiny.xml:62
#: rc.cpp:417
msgid "German 'zinking' for 'rough', because zinc ore is very rough"
msgstr ""
"Del aleman «zinking» o «ásperu», darréu que'l mineral de zinc ye perásperu"

#. i18n: file: element_tiny.xml:64
#: rc.cpp:419
msgid "'Gallia' is an old name for France"
msgstr "Del llatín «gallia», un nome antiguu de Francia."

#. i18n: file: element_tiny.xml:66
#: rc.cpp:421
msgid "Latin 'germania' is an old name for Germany"
msgstr "Del llatín «germania», un nome antiguu d'Alemaña."

#. i18n: file: element_tiny.xml:68
#: rc.cpp:423
msgid "Greek 'arsenikos' for 'male' or 'bold'"
msgstr "Del griegu «arsenikos», que significa «paisanu» o «atrevíu»."

#. i18n: file: element_tiny.xml:70
#: rc.cpp:425
msgid "Greek 'selena' for 'moon'"
msgstr "Del griegu «selena», que significa «lluna»."

#. i18n: file: element_tiny.xml:72
#: rc.cpp:427
msgid "Greek 'bromos' for 'smells badly'"
msgstr "Del griegu «bromos», que significa «qu'arreciende»."

#. i18n: file: element_tiny.xml:74
#: rc.cpp:429
msgid "Greek 'kryptos' for 'hidden'"
msgstr "Del griegu «kryptos», que significa «tapecíu»."

#. i18n: file: element_tiny.xml:76
#: rc.cpp:431
msgid "Latin 'rubidus' for 'dark red'"
msgstr "Del llatín «rubidus», que significa «bermeyu»."

#. i18n: file: element_tiny.xml:78
#: rc.cpp:433
msgid "Named after the mineral Strontianit"
msgstr "Nomáu pol mineral estroncianita."

#. i18n: file: element_tiny.xml:80
#: rc.cpp:435
msgid ""
"Named after the small town of Ytterby near Stockholm in Sweden. Terbium. "
"Ytterbium and Gadolinium are also named after this town."
msgstr ""
"Nomáu pola villa d'Ytterby, cerca d'Estocolmo, en Suecia. El terbiu, el "
"iterbiu y el gadoliniu tienen el mesmu orixe nel nome."

#. i18n: file: element_tiny.xml:82
#: rc.cpp:437
msgid "Named after the mineral zircon"
msgstr "El nome vien del mineral zircón."

#. i18n: file: element_tiny.xml:84
#: rc.cpp:439
msgid "Named after Niobe, the daughter of the Greek god Tantalus."
msgstr "Nomáu por Niobe, la fía del dios griegu Tántalo."

#. i18n: file: element_tiny.xml:86
#: rc.cpp:441
msgid ""
"This name has Greek roots. It means 'like Platinum' - it was difficult to "
"distinguish Molybdenum from Platinum."
msgstr ""
"So nome tien raigaños griegos. Significa «paecíu al platinu» (yera abegoso "
"distinguir ente'l molibdenu y el platinu)."

#. i18n: file: element_tiny.xml:88
#: rc.cpp:443
msgid "Greek 'technetos' for artificial"
msgstr "Del griegu «teknetos», que significa «artificial»."

#. i18n: file: element_tiny.xml:90
#: rc.cpp:445
msgid "Ruthenia is the old name of Russia"
msgstr "Ruthenia ye'l antiguu nome de Rusia."

#. i18n: file: element_tiny.xml:92
#: rc.cpp:447
msgid "Greek 'rhodeos' means 'red like a rose'"
msgstr "Del griego «rhodeos», que significa «encarnáu como una rosa»."

#. i18n: file: element_tiny.xml:94
#: rc.cpp:449
msgid "Named after the asteroid Pallas"
msgstr "Nomáu pol asteroide Palas."

#. i18n: file: element_tiny.xml:96
#: rc.cpp:451
msgid "Latin 'argentum' for silver"
msgstr "Del llatín «argentum», que significa «plata»."

#. i18n: file: element_tiny.xml:98
#: rc.cpp:453
msgid "Greek 'kadmia' ('Galmei' = Zinc carbonate)"
msgstr "Del griegu «kadmia» («Galmei» = carbonatu de cinc)."

#. i18n: file: element_tiny.xml:100
#: rc.cpp:455
msgid "Named after 'Indigo' because of its blue spectrum"
msgstr "So nome vien del color «índigu», pol so espectru azuláu."

#. i18n: file: element_tiny.xml:102
#: rc.cpp:457
msgid "Latin 'stannum' for tin"
msgstr "Del llatín «stannum», que significa «lata»."

#. i18n: file: element_tiny.xml:104
#: rc.cpp:459
msgid "Arabic 'anthos ammonos' for 'blossom of the god Ammon'"
msgstr ""
"Del árabe «anthos ammonos», que significa «flor de Amón». El símbolu vien del "
"so nome antiguu «Stibnium»."

#. i18n: file: element_tiny.xml:106
#: rc.cpp:461
msgid "Latin 'tellus' or 'telluris' for 'Planet Earth'"
msgstr "Del llatín «tellus» (o «telluris»), nome del planeta Tierra."

#. i18n: file: element_tiny.xml:108
#: rc.cpp:463
msgid "Greek 'ioeides' for 'violet'."
msgstr "Del griegu «ioeides» o «viola»."

#. i18n: file: element_tiny.xml:110
#: rc.cpp:465
msgid "Greek 'xenos' for 'foreigner'"
msgstr "Del griegu «xenos», que significa «estranxeru»."

#. i18n: file: element_tiny.xml:112
#: rc.cpp:467
msgid "Latin 'caesius' for 'heaven blue'."
msgstr "Del latín «caesius» o «azul celeste»."

#. i18n: file: element_tiny.xml:114
#: rc.cpp:469
msgid "Greek 'barys' for 'heavy'"
msgstr "Del griegu «barys», que significa «pesáu»."

#. i18n: file: element_tiny.xml:116
#: rc.cpp:471
msgid ""
"Greek 'lanthanein' for 'hidden'. The Lanthanoids are also called the 'rare "
"earth' elements."
msgstr ""
"Del griegu «lanthanein» o «escondíu». Los elementos Lantanoides nómense tamién "
"les «tierres rares»."

#. i18n: file: element_tiny.xml:118
#: rc.cpp:473
msgid "Named after the planetoid Ceres"
msgstr "Nomáu pol planetoide Ceres."

#. i18n: file: element_tiny.xml:120
#: rc.cpp:475
msgid "Greek 'prasinos didymos' for 'green twin'"
msgstr "Del griegu «prasinos didymos», que significa «ximielgu verde»."

#. i18n: file: element_tiny.xml:122
#: rc.cpp:477
msgid "Greek 'neos didymos' for 'new twin'"
msgstr "Del griegu «neos didymos», que significa «nuevu ximielgu»."

#. i18n: file: element_tiny.xml:124
#: rc.cpp:479
msgid ""
"Named after the Greek Prometheus. Prometheus stole the fire from the gods "
"and gave it to mankind."
msgstr ""
"Nomáu pol griegu Prometeo. Prometeo robó el fuéu de los dioses y apurriólu a "
"la humanidá."

#. i18n: file: element_tiny.xml:126
#: rc.cpp:481
msgid "Named after the mineral Samarskit"
msgstr "Nomáu pol mineral samarskita."

#. i18n: file: element_tiny.xml:128
#: rc.cpp:483
msgid "Named after Europe"
msgstr "Nomáu por Europa."

#. i18n: file: element_tiny.xml:130
#: rc.cpp:485
msgid "Named after the Finnish chemist Johan Gadolin"
msgstr "Nomáu pol químicu finlandés Johan Gadolin."

#. i18n: file: element_tiny.xml:132
#: rc.cpp:487
msgid "Named after the Swedish town of Ytterby"
msgstr "Nomáu pola ciudá d'Ytterby, en Suecia."

#. i18n: file: element_tiny.xml:134
#: rc.cpp:489
msgid "Greek 'dysprositor' for 'difficult to reach'"
msgstr "Del griegu «dysprositor», que significa «abegoso d'algamar»."

#. i18n: file: element_tiny.xml:136
#: rc.cpp:491
msgid "Latin 'holmia' for the old name of Stockholm"
msgstr "Del llatín «holmia», pol nome antiguu d'Estocolmo."

#. i18n: file: element_tiny.xml:138
#: rc.cpp:493
msgid ""
"Named ofter the Swedish town of Ytterby. Terbium and Ytterbium are also "
"named after this town."
msgstr ""
"Nomáu pola ciudá d'Ytterby, en Suecia. El terbiu, l'iterbiu y l'itriu "
"comparten el mesmu orixe nel nome."

#. i18n: file: element_tiny.xml:140
#: rc.cpp:495
msgid "Named after the old name of Scandinavia, 'Thule'."
msgstr "Nomáu pol antiguu nome d'Ecandinavia, «Thule»."

#. i18n: file: element_tiny.xml:142
#: rc.cpp:497
msgid ""
"Like Terbium and Gadolinium, this is named after the Swedish town of Ytterby."
msgstr "Igual que'l Terbiu y el Gadoliniu, nómase pola ciudá sueca de Ytterby."

#. i18n: file: element_tiny.xml:144
#: rc.cpp:499
msgid "Named after the Roman name 'Lutetia' for Paris"
msgstr "El nome vien del nome romanu de París, «Lutetia»."

#. i18n: file: element_tiny.xml:146
#: rc.cpp:501
msgid "'Hafnia' is the old name of Kopenhagen (Denmark)"
msgstr "«Hafnia», ye'l nome antiguu de Copenhage (Dinamarca)."

#. i18n: file: element_tiny.xml:148
#: rc.cpp:503
msgid "Named after the Greek myth of Tantalos"
msgstr "Nomáu pol mitu griegu de Tántalo."

#. i18n: file: element_tiny.xml:150
#: rc.cpp:505
msgid ""
"'tung sten' means 'heavy stone' in Swedish. The old name (and thus the "
"symbol 'W') was Wolfram, named after a mineral."
msgstr ""
"«Tung sten» quier dicir «piedra pesada» en suecu. El nome antiguu (y d'equí el "
"símbolu «W») yera Wolfram, nomáu por un mineral."

#. i18n: file: element_tiny.xml:152
#: rc.cpp:507
msgid "Named after the German river Rhine (latin 'Rhenium')."
msgstr ""

#. i18n: file: element_tiny.xml:154
#: rc.cpp:509
msgid "Greek for 'smell'. Its oxides smell strongly like radishes."
msgstr ""

#. i18n: file: element_tiny.xml:156
#: rc.cpp:511
msgid "Greek 'iris' for 'rainbow'"
msgstr "Del griegu «iris», que significa «arcu la vieya»."

#. i18n: file: element_tiny.xml:158
#: rc.cpp:513
msgid "Spanish 'platina' means 'small silver'"
msgstr "Del castellanu «platina», que significa «plata pequeña»."

#. i18n: file: element_tiny.xml:160
#: rc.cpp:515
msgid "Latin 'aurum'. Named after Aurora, the goddess of sunrise"
msgstr ""

#. i18n: file: element_tiny.xml:162
#: rc.cpp:517
msgid "Graeco-Latin 'hydrargyrum' for 'liquid silver'"
msgstr ""
"De la pallabra grecollatina «hydrargyrum», que significa «plata líquida»."

#. i18n: file: element_tiny.xml:164
#: rc.cpp:519
msgid "Greek 'tallos' for 'young twig'"
msgstr "Del griegu «tallos», que significa «ramina xoven»."

#. i18n: file: element_tiny.xml:166
#: rc.cpp:521
msgid "Latin 'plumbum' for Lead"
msgstr "Del llatín «plumbum», que significa «plomu»."

#. i18n: file: element_tiny.xml:168
#: rc.cpp:523
msgid "The old name of Bismuth is 'Wismut', which stood for 'white mass'."
msgstr ""

#. i18n: file: element_tiny.xml:170
#: rc.cpp:525
msgid "Named after Poland to honor Marie Curie"
msgstr "El nome vien de Polonia, en brinde a Marie Curie."

#. i18n: file: element_tiny.xml:172
#: rc.cpp:527
msgid "Greek 'astator' for 'changing'"
msgstr "Del griegu «astator», que significa «cambeante»."

#. i18n: file: element_tiny.xml:174
#: rc.cpp:529
msgid ""
"Named after Radium. It ends with 'on' to make it clear that it is a noble "
"gas."
msgstr ""

#. i18n: file: element_tiny.xml:176
#: rc.cpp:531
msgid "Named after France to honor Marguerite Perey"
msgstr "Nomáu por Francia, en brinde a Marguerite Perey."

#. i18n: file: element_tiny.xml:178
#: rc.cpp:533
msgid "Latin 'radius' for 'beam', as it is radioactive"
msgstr "Del llatín «radius», que significa «rayu», pola so radiactividá."

#. i18n: file: element_tiny.xml:180
#: rc.cpp:535
msgid "Greek 'aktis' for 'beam' - actinium is radioactive"
msgstr "Del griegu «aktis», que significa «rayu», pola so radiactividá."

#. i18n: file: element_tiny.xml:182
#: rc.cpp:537
msgid "Named after the German god of thunder: Thor"
msgstr "Nomáu pol dios escandinavu del truenu, Thor."

#. i18n: file: element_tiny.xml:184
#: rc.cpp:539
msgid ""
"Greek 'protos' for 'ancester'. Protactinium is before Actinium in the "
"periodic table."
msgstr ""
"Del griegu «protos», que ye «antecesor». El protoactiniu ta enantes del "
"actiniu na tabla periódica."

#. i18n: file: element_tiny.xml:186
#: rc.cpp:541
msgid "Greek 'ouranos' for 'heaven'. Named after the planet Uranus."
msgstr ""

#. i18n: file: element_tiny.xml:188
#: rc.cpp:543
msgid "Named after the planet Neptune."
msgstr "Nomáu pol planeta Neptuno."

#. i18n: file: element_tiny.xml:190
#: rc.cpp:545
msgid "Named after the planet Pluto."
msgstr "Nomáu pol planeta Plutón."

#. i18n: file: element_tiny.xml:192
#: rc.cpp:547
msgid "Named after America."
msgstr "El nome ye por América."

#. i18n: file: element_tiny.xml:194
#: rc.cpp:549
msgid "Named after Marie Curie."
msgstr "Nomáu por Marie Curie."

#. i18n: file: element_tiny.xml:196
#: rc.cpp:551
msgid "Named after the town Berkeley where it was discovered."
msgstr "El nome vien de la ciudá de Berkeley, onde se descubrió."

#. i18n: file: element_tiny.xml:198
#: rc.cpp:553
msgid "Named after the US-State of California."
msgstr "Nomáu pol estáu de California, nos Estaos Xuníos."

#. i18n: file: element_tiny.xml:200
#: rc.cpp:555
msgid "Named after the scientist Albert Einstein."
msgstr "Nomáu n'honor al científicu Albert Einstein."

#. i18n: file: element_tiny.xml:202
#: rc.cpp:557
msgid "Named after the scientist Enrico Fermi."
msgstr "Nomáu n'honor al científicu Enrico Fermi."

#. i18n: file: element_tiny.xml:204
#: rc.cpp:559
msgid "Named after the scientist D.I. Mendeleev."
msgstr "Nomáu n'honor al científicu D. I. Mendeleev."

#. i18n: file: element_tiny.xml:206
#: rc.cpp:561
msgid "Named after the scientist Alfred Nobel."
msgstr "Nomáu n'honor al científicu Alfred Nobel."

#. i18n: file: element_tiny.xml:208
#: rc.cpp:563
msgid "Named after the scientist Ernest Orlando Lawrence."
msgstr "Nomáu n'honor al científicu Ernest Orlando Lawrence."

#. i18n: file: element_tiny.xml:210
#: rc.cpp:565
msgid "Named after the scientist Ernest Rutherford"
msgstr "Nomáu n'honor al científicu Ernest Rutherford"

#. i18n: file: element_tiny.xml:212
#: rc.cpp:567
msgid "Named after the science-town Dubna in Russia"
msgstr "Nomáu n'honor a la ciudá científica de Dubna, en Rusia."

#. i18n: file: element_tiny.xml:214
#: rc.cpp:569
msgid "Named after the scientist G. Theodore Seaborg."
msgstr "Nomáu n'honor al científicu G. Theodore Seaborg."

#. i18n: file: element_tiny.xml:216
#: rc.cpp:571
msgid "Named after the scientist Niels Bohr."
msgstr "Nomáu n'honor al científicu Niels Bohr."

#. i18n: file: element_tiny.xml:218
#: rc.cpp:573
msgid ""
"Latin 'hassia' for the German county Hessen. In Hessen a lot elements have "
"been discovered."
msgstr ""
"El nome vien del llatín «hassia» pol condáu alemán de Hessen, onde se tien "
"descubierto dellos elementos."

#. i18n: file: element_tiny.xml:220
#: rc.cpp:575
msgid "Named after the scientist Lise Meitner."
msgstr "Nomáu n'honor a la científica Lise Meitner."

#. i18n: file: element_tiny.xml:222
#: rc.cpp:577
msgid ""
"Named after the German city Darmstadt where many elements have been "
"discovered."
msgstr ""
"El nome vien de la ciudá alemana de Darmstadt, onde se tien descubierto "
"dellos elementos."

#. i18n: file: element_tiny.xml:224
#: rc.cpp:579
msgid "Named after Wilhelm Conrad Röntgen."
msgstr "Nomáu n'honor a Wilhelm Conrad Roentgen."

#. i18n: file: element_tiny.xml:226
#: rc.cpp:581
msgid ""
"Historically known as eka-mercury. Ununbium is a temporary IUPAC systematic "
"element name."
msgstr ""
"Nomáu históricamente eka-mercuriu. Ununbiu ye un nome temporal sistemáticu "
"d'elementu de la IUPAC."

#. i18n: file: element_tiny.xml:228
#: rc.cpp:583
msgid ""
"Historically known as eka-thallium. Ununtrium is a temporary IUPAC "
"systematic element name."
msgstr ""
"Nomáu históricamente eka-taliu. Ununtriu ye un nome temporal sistemáticu "
"d'elementu de la IUPAC."

#. i18n: file: element_tiny.xml:230
#: rc.cpp:585
msgid ""
"Historically known as eka-lead. Ununquadium is a temporary IUPAC systematic "
"element name."
msgstr ""
"Nomáu históricamente eka-plomu. Ununquadiu ye un nome temporal sistemáticu "
"d'elementu de la IUPAC."

#. i18n: file: element_tiny.xml:232
#: rc.cpp:587
msgid ""
"Historically known as eka-bismuth. Ununpentium is a temporary IUPAC "
"systematic element name."
msgstr ""
"Nomáu históricamente eka-bismutu. Ununpentiu ye un nome temporal sistemáticu "
"d'elementu de la IUPAC."

#. i18n: file: element_tiny.xml:234
#: rc.cpp:589
msgid ""
"Historically known as eka-polonium. Ununhexium is a temporary IUPAC "
"systematic element name."
msgstr ""
"Nomáu históricamente eka-poloniu. Ununhexiu ye un nome temporal sistemáticu "
"d'elementu de la IUPAC."

#. i18n: file: element_tiny.xml:236
#: rc.cpp:591
msgid "Temporary symbol and name. Can also be referred to as eka-astatine."
msgstr "Símbolu y nome temporal. Tamién puede nomase como eka-ástatu."

#. i18n: file: element_tiny.xml:238
#: rc.cpp:593
msgid ""
"Historically known as eka-radon, eka-emanation before 1960. Ununoctium is a "
"temporary IUPAC systematic element name."
msgstr ""
"Nomáu históricamente eka-radón; eka-emanación enantes de 1960. Ununoctiu ye "
"un nome temporal sistemáticu d'elementu de la IUPAC."

