#. i18n: ectx: property (toolTip), widget (QPushButton, btEdit)
#: emoticonslist.ui:20
#, kde-format
msgid "Modify the selected emoticon icon or text "
msgstr "Modifica l'iconu o testu del fustaxe esbilláu"

#. i18n: ectx: property (whatsThis), widget (QPushButton, btEdit)
#: emoticonslist.ui:23
#, kde-format
msgid "Edit the selected emoticon to change its icon or its text"
msgstr "Edita'l fustaxe esbilláu pa camudar el so iconu o testu"

#. i18n: ectx: property (text), widget (QPushButton, btEdit)
#: emoticonslist.ui:26
#, kde-format
