msgstr "Arrastra o teclexa l'URL del tema de fustaxes"

#: emoticonslist.cpp:261
#, kde-format
msgid "Emoticon themes must be installed from local files."
msgstr "Los temes de fustaxes tienen d'instalase dende ficheros llocales."

#: emoticonslist.cpp:262
#, kde-format
msgid "Could Not Install Emoticon Theme"
msgstr "Nun pudo instalase'l tema de fustaxes"

