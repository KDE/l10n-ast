#, no-c-format
msgid "KDE User's Manual"
msgstr "Manual d'usuariu KDE"

#. Tag: date
#: man-plasmoidviewer.1.docbook:9
#, no-c-format
msgid "2010-10-21"
msgstr ""

#. Tag: productname
#: man-plasmoidviewer.1.docbook:10
#, no-c-format
msgid "K Desktop Environment"
msgstr ""

#. Tag: manvolnum
#: man-plasmoidviewer.1.docbook:15
#, no-c-format
msgid "<manvolnum>1</manvolnum>"
msgstr ""

#. Tag: refpurpose
#: man-plasmoidviewer.1.docbook:20
#, no-c-format
msgid "Run Plasma widgets in their own window"
msgstr ""

#. Tag: cmdsynopsis
#: man-plasmoidviewer.1.docbook:24
#, no-c-format
msgid ""
"<command>plasmoidviewer</command> <group choice=\"opt\"><option>-c, --"
"containment</option> <replaceable> name</replaceable></group> <group choice="
"\"opt\"><option>-f, --formfactor</option> <replaceable> name</replaceable></"
"group> <group choice=\"opt\"><option>--list</option></group> <group choice="
"\"opt\"><option>--list-wallpapers</option></group> <group choice=\"opt"
"\"><option>--list-containments</option></group> <group choice=\"opt"
"\"><option>-l, --location</option> <replaceable> name</replaceable></group> "
"<group choice=\"opt\"><option>-p, --pixmapcache</option> <replaceable> size</"
"replaceable></group> <group choice=\"opt\"><option>-s, --screenshot</"
"option></group> <group choice=\"opt\"><option>--screenshot-all</option></"
"group> <group choice=\"opt\"><option>-t, --theme</option> <replaceable> "
"name</replaceable></group> <group choice=\"opt\"><option>-w, --wallpaper</"
"option> <replaceable> name</replaceable></group> <arg choice=\"opt\">applet</"
"arg> <arg choice=\"opt\">args</arg> <arg choice=\"opt\">--list-remote</arg> "
"<arg choice=\"opt\">KDE Generic Options</arg> <arg choice=\"opt\">Qt Generic "
"Options</arg>"
msgstr ""

#. Tag: title
#: man-plasmoidviewer.1.docbook:47
#, no-c-format
msgid "Description"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:48
#, no-c-format
msgid ""
"<command>plasmoidviewer</command> is a graphical tool allowing developers to "
"test Plasma applets."
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:51
#, no-c-format
msgid ""
"Only installed applets will be found. <command>kbuildsycoca4</command> may "
"need to be run for newly-installed applets to be found."
msgstr ""

#. Tag: title
#: man-plasmoidviewer.1.docbook:57
#, no-c-format
msgid "Options"
msgstr ""

#. Tag: option
#: man-plasmoidviewer.1.docbook:61
#, no-c-format
msgid "-c, --containment <replaceable>name</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:62
#, no-c-format
msgid "Name of the containment plugin [null]."
msgstr ""

#. Tag: option
#: man-plasmoidviewer.1.docbook:65
#, no-c-format
msgid "-f, --formfactor <replaceable>name</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:66
#, no-c-format
msgid ""
"The formfactor to use (horizontal, vertical, mediacenter or planar) [planar]."
msgstr ""

#. Tag: option
#: man-plasmoidviewer.1.docbook:69
#, no-c-format
msgid "--list"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:70
#, no-c-format
msgid "Displays a list of known applets."
msgstr ""

#. Tag: option
#: man-plasmoidviewer.1.docbook:73
#, no-c-format
msgid "--list-wallpapers"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:74
#, no-c-format
msgid "Displays a list of known wallpapers."
msgstr ""

#. Tag: option
#: man-plasmoidviewer.1.docbook:77
#, no-c-format
msgid "--list-containments"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:78
#, no-c-format
msgid "Displays a list of known containments."
msgstr ""

#. Tag: option
#: man-plasmoidviewer.1.docbook:81
#, no-c-format
msgid "-l, --location <replaceable>name</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:82
#, no-c-format
msgid ""
"The location constraint to start the Containment with (floating, desktop, "
"fullscreen, top, bottom, left, right) [floating]."
msgstr ""

#. Tag: option
#: man-plasmoidviewer.1.docbook:86
#, no-c-format
msgid "-p, --pixmapcache <replaceable>size</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:87
#, no-c-format
msgid "The size in KB to set the pixmap cache to."
msgstr ""

#. Tag: option
#: man-plasmoidviewer.1.docbook:90
#, no-c-format
msgid "-s, --screenshot"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:91
#, no-c-format
msgid ""
"Takes a screenshot of the widget and saves it the working directory as &lt;"
"pluginname&gt;.png."
msgstr ""

#. Tag: option
#: man-plasmoidviewer.1.docbook:95
#, no-c-format
msgid "-s, --screenshot-all"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:96
#, no-c-format
msgid ""
"Takes a screenshot of each widget and saves it the working directory as &lt;"
"pluginname&gt;.png."
msgstr ""

#. Tag: option
#: man-plasmoidviewer.1.docbook:100
#, no-c-format
msgid "-t, --theme <replaceable>name</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:101
#, no-c-format
msgid "Desktop SVG theme to use."
msgstr ""

#. Tag: option
#: man-plasmoidviewer.1.docbook:104
#, no-c-format
msgid "-w, --wallpaper <replaceable>name</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:105
#, no-c-format
msgid ""
"Name of the wallpaper plugin. Requires a containment plugin to be specified."
msgstr ""

#. Tag: replaceable
#: man-plasmoidviewer.1.docbook:109
#, no-c-format
msgid "applet"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:110
#, no-c-format
msgid ""
"Name of applet to view; may refer to the plugin name or be a path (absolute "
"or relative) to a package. If not provided, then an attempt is made to load "
"a package from the current directory."
msgstr ""

#. Tag: replaceable
#: man-plasmoidviewer.1.docbook:115
#, no-c-format
msgid "args"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:116
#, no-c-format
msgid "Optional arguments of the applet to add."
msgstr ""

#. Tag: replaceable
#: man-plasmoidviewer.1.docbook:119
#, no-c-format
msgid "--list-remote"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:120
#, no-c-format
msgid "List zeroconf announced remote widgets."
msgstr ""

#. Tag: title
#: man-plasmoidviewer.1.docbook:128
#, no-c-format
msgid "See Also"
msgstr ""

#. Tag: para
#: man-plasmoidviewer.1.docbook:130
#, no-c-format
msgid ""
"More detailed user documentation is available from <ulink url=\"help:/plasma-"
"desktop\">help:/plasma-desktop</ulink> (either enter this <acronym>URL</"
"acronym> into &konqueror;, or run <userinput><command>khelpcenter</command> "
"<parameter>help:/plasma-desktop</parameter></userinput>)."
msgstr ""

