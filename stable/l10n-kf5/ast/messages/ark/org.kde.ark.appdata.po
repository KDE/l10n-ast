msgid "Ark"
msgstr "Ark"

#. (itstool) path: component/summary
#: org.kde.ark.appdata.xml:7
msgid "Archiving Tool"
msgstr "Ferramienta p'archivar"

#. (itstool) path: description/p
#: org.kde.ark.appdata.xml:9
msgid ""
"Ark is a graphical file compression/decompression utility with support for "
"multiple formats, including tar, gzip, bzip2, rar and zip, as well as CD-ROM "
"images. Ark can be used to browse, extract, create, and modify archives."
msgstr ""
"Ark ye una utilidá gráfica de des/compresión de ficheros con sofitu pa "
"munchos formatos de ficheros, incluyendo TAR, gzip, bzip2, RAR y zip, amás "
"d'imáxenes de DVD/CD-ROM. Ark pue usase pa restolar, estrayer, crear y "
"modificar archivos."

