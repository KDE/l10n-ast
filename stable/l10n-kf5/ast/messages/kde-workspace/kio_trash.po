#: kcmtrash.cpp:158 kcmtrash.cpp:256
msgid " day"
msgid_plural " days"
msgstr[0] " día"
msgstr[1] " díes"

#: kcmtrash.cpp:247
msgid "Delete files older than:"
msgstr "Desaniciar ficheros anteriores a:"

#: kcmtrash.cpp:266
msgid "Limit to maximum size"
msgstr "Llimitar a un tamañu máximu"

#: kcmtrash.cpp:294
msgid "Maximum size:"
msgstr "Tamañu máximu:"

#: kcmtrash.cpp:296
msgid "When limit reached:"
msgstr "Al algamar el llímite:"

#: kcmtrash.cpp:300
msgid "Warn Me"
msgstr "Avisame"

#: kcmtrash.cpp:301
msgid "Delete Oldest Files From Trash"
msgstr "Desaniciar los ficheros más vieyos de la papelera"

#: kcmtrash.cpp:302
msgid "Delete Biggest Files From Trash"
msgstr "Desaniciar los ficheros más grandes de la papelera"

#: kio_trash.cpp:93 kio_trash.cpp:159 kio_trash.cpp:315 kio_trash.cpp:347
#: kio_trash.cpp:513 kio_trash.cpp:525
#, kde-format
msgid "Malformed URL %1"
msgstr "URL incorreuta %1"

#: kio_trash.cpp:115
#, kde-format
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore "
"this item to its original location. You can either recreate that directory "
"and use the restore operation again, or drag the item anywhere else to "
"restore it."
msgstr ""
"Ye posible que'l direutoriu %1 ya nun exista, asina que nun pues restauralu "
"a la so ubicación orixinal. Pues recrear esi direutoriu y usalu na operación "
"de restauración o arrastralu a cualesquier otru sitiu pa restauralu."

#: kio_trash.cpp:144 kio_trash_win.cpp:228
msgid "This file is already in the trash bin."
msgstr "Esti ficheru yá ta na papelera."

#: kio_trash.cpp:233 kio_trash_win.cpp:252
msgid "Internal error in copyOrMove, should never happen"
msgstr "Fallu internu en copiarOMover, non debería pasar"

#: kio_trash_win.cpp:241
msgid "not supported"
msgstr "non sofitáu"

#: ktrash.cpp:38
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kioclient move "
"'url' trash:/\""
msgstr ""
"Ayuda pa remanar la papelera de KDE\n"
"Nota: pa mover ficheros a la papelera, nun uses ktrash sinon «kfmclient move "
"«url» trash:/»"

#: ktrash.cpp:41
msgid "Empty the contents of the trash"
msgstr "Vaciar el conteníu de la papelera"

#: ktrash.cpp:42
msgid "Restore a trashed file to its original location"
msgstr "Devolver un ficheru de la papelera a la so ubicación orixinal"

#: trashimpl.cpp:1123
msgid ""
"The trash has reached its maximum size!\n"
"Cleanup the trash manually."
msgstr ""
"La papelera algamó'l so tamañu máximu.\n"
"Llímpiala manualmente."

#: trashimpl.cpp:1134
msgid "The file is too large to be trashed."
msgstr "El ficheru ye mui grande pa movelu a la papelera."

#~ msgctxt "@info:whatsthis"
#~ msgid ""
#~ "<para>Check this box to allow <b>automatic deletion</b> of files that are "
#~ "older than the value specified. Leave this disabled to <b>not</b> "
#~ "automatically delete any items after a certain timespan</para>"
#~ msgstr ""
#~ "<para>Marca esti cuadru pa permitir <b>borráu automáticu</b> de ficheros "
#~ "que son anteriores a un valor especificáu. Déxalo desactivao pa <b>nun</"
#~ "b> desaniciar dengún elementu pasáu esi tiempu</para>"

#~ msgctxt "@info:whatsthis"
#~ msgid ""
#~ "<para>Set the number of days that files can remain in the trash. Any "
#~ "files older than this will be automatically deleted.</para>"
#~ msgstr ""
#~ "<para>Introduz el númberu de díes que los ficheros puen permanecer na "
#~ "papelera. Cualesquier ficheru más antiguu desaniciaráse automáticamente.</"
#~ "para>."

#~ msgctxt "@info:whatsthis"
#~ msgid ""
#~ "<para>Check this box to limit the trash to the maximum amount of disk "
#~ "space that you specify below. Otherwise, it will be unlimited.</para>"
#~ msgstr ""
#~ "<para>Marca esta opción si quies llimitar el tamañu máximu de la papelera "
#~ "al tamañu d'embaxu. Si nun lo faes será illimitáu.</para>"

#~ msgctxt "@info:whatsthis"
#~ msgid ""
#~ "<para>This is the maximum percent of disk space that will be used for the "
#~ "trash.</para>"
#~ msgstr ""
#~ "<para>Ye'l máximu porcentaxe de discu que va usase pa la papelera.</para>"

#~ msgctxt "@info:whatsthis"
#~ msgid ""
#~ "<para>This is the calculated amount of disk space that will be allowed "
#~ "for the trash, the maximum.</para>"
#~ msgstr ""
#~ "<para>Ye la cantidá d'espaciu en discu permitíu, como máximu, pa la "
#~ "papelera.</para>"

#~ msgctxt "@info:whatsthis"
#~ msgid ""
#~ "<para>When the size limit is reached, it will prefer to delete the type "
#~ "of files that you specify, first. If this is set to warn you, it will do "
#~ "so instead of automatically deleting files.</para>"
#~ msgstr ""
#~ "<para>Cuando'l s'algame'l tamañu llímite, ye preferible desaniciar la "
#~ "triba de ficheru qu'especifiques primero. Si ta configuráu p'advertite, "
#~ "fadráse eso, en llugar de desaniciar automáticamente los ficheros.</para>"

