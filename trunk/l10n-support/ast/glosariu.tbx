<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE martif PUBLIC 'ISO 12200:1999A//DTD MARTIF core (DXFcdV04)//EN' 'TBXcdv04.dtd'>
<martif xml:lang="en_US" type="TBX">
    <text>
        <body>
        <termEntry id="enolp-0">
        <descrip type="subjectField">Sustantivu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Mouse</term>
          </tig>
          <tig>
            <term>Mice</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">Preséu compuestu por tres (o más) botones que sirve pa controlar un cursor nos ordenadores</descrip>
          <tig>
            <term>Mur</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-1">
        <descrip type="subjectField">Sustantivu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Screen</term>
          </tig>
          <tig>
            <term>Display</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">Preséu que sirve p'amosar imáxenes</descrip>
          <tig>
            <term>Pantalla</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-2">
        <descrip type="subjectField">Sustantivu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Keyboard</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">Preséu que contién un conxuntu de tecles y sirve pa teclexar testos nun preséu</descrip>
          <tig>
            <term>Tecláu</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-3">
        <descrip type="subjectField">Sustantivu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Key</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">1.- Pieza d'un tecláu que se calca pa respresentar un caráuter o facer una aición

2.- Ficheru o pallabra secreta que s'usa pa cifrar mensaxes o ficheros</descrip>
          <tig>
            <term>Tecla</term>
          </tig>
          <tig>
            <term>Clave</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-4">
        <descrip type="subjectField">Sustantivu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Button</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">Pieza que se calca p'aicionar o activar daqué</descrip>
          <tig>
            <term>Botón</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-5">
        <descrip type="subjectField">Sustantivu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Tool</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">Utilidá/Conxuntu d'utilidaes que s'usa/usen pa facer dalgúna xera</descrip>
          <tig>
            <term>Ferramienta</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-7">
        <descrip type="subjectField">Sustantivu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Game</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">1.- Aición o efeutu de xugar
- Actividá que se fai pa xugar siguiendo unes regles
- Oxetu o aparatu que val pa xugar

2.- Conxuntu de dellos xuegos</descrip>
          <tig>
            <term>Xuegu</term>
          </tig>
          <tig>
            <term>Partida</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-8">
        <descrip type="subjectField">Sustantivu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Device</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">Oxetu electrónicu que fai o sirve pa facer daqué</descrip>
          <tig>
            <term>Preséu</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-9">
        <descrip type="subjectField">Verbu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Redo</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">Facer de nueves</descrip>
          <tig>
            <term>Refacer</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-10">
        <descrip type="subjectField">Sustantivu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Player</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">1.- Programa que s'usa pa visualizar vídeos y/o sentir música

2.- Persona que xuega</descrip>
          <tig>
            <term>Reproductor</term>
          </tig>
          <tig>
            <term>Xugador</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-11">
        <descrip type="subjectField">Verbu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Add</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">Axuntar dos o más coses pa facer un tou</descrip>
          <tig>
            <term>Amestar</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-12">
        <descrip type="subjectField">Sustantivu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Failure</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">Aición y efeutu de fallar</descrip>
          <tig>
            <term>Fallu</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-13">
        <descrip type="subjectField">Verbu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Tigger</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">Poner en funcionamientu daqué</descrip>
          <tig>
            <term>Aicionar</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-14">
        <descrip type="subjectField">Axetivu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Tigger</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">Persona, mecanismu o programa qu'aiciona daqué</descrip>
          <tig>
            <term>Aicionador -a -oro</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-15">
        <descrip type="subjectField">Sustantivu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Brightness</term>
          </tig>
          <tig>
            <term>Bright</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">Lluz que produz una pantalla</descrip>
          <tig>
            <term>Brilléu</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-16">
        <descrip type="subjectField">Sustantivu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Ringtone</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">Soníu qu'emite un preséu p'avisar al usuariu d'una llamada o avisu</descrip>
          <tig>
            <term>Timbre</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-17">
        <descrip type="subjectField">Axetivu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Legacy</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">Carauterística anticuada d'un programa que s'inclúi en versiones nueves del mesmu por compatibilidá</descrip>
          <tig>
            <term>Heredáu -ada -ao</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="enolp-18">
        <descrip type="subjectField">Verbu</descrip>
        <langSet xml:lang="en-US">
          <tig>
            <term>Print</term>
          </tig>
        </langSet>
        <langSet xml:lang="ast">
          <descrip type="definition">1.- Poner nun papel imáxenes o testos per una imprentadora

2.- Amosar testu per pantalla</descrip>
          <tig>
            <term>Imprentar</term>
          </tig>
          <tig>
            <term>Amosar</term>
          </tig>
        </langSet>
      </termEntry>
    </body>
    </text>
</martif>
