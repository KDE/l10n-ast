#. Tag: guilabel
#: index.docbook:626
#, no-c-format
msgid "Default font size:"
msgstr ""

#. Tag: para
#: index.docbook:627
#, no-c-format
msgid "To configure your preferred size of font."
msgstr ""

#. Tag: guilabel
#: index.docbook:630
#, no-c-format
msgid "Minimal font size:"
msgstr ""

#. Tag: para
#: index.docbook:631
#, no-c-format
msgid ""
"You can configure the minimal size of fonts in &i18n-rekonq;. Every smaller "
"font will grow to that size."
