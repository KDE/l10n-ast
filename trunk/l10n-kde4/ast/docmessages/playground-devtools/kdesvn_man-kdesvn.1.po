#: man-kdesvn.1.docbook:163
#, no-c-format
msgid "--nocrashhandler"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:165
#, no-c-format
msgid "Disable crash handler, to get core dumps"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:169
#, no-c-format
msgid "--waitforwm"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:171
#, no-c-format
msgid "Waits for a WM_NET compatible windowmanager"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:175
#, no-c-format
msgid "--style &lt;style&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:177
#, no-c-format
msgid "sets the application GUI style"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:181
#, no-c-format
msgid "--geometry &lt;geometry&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:183
#, no-c-format
msgid ""
"sets the client geometry of the main widget - see man X for the argument "
"format"
msgstr ""

#. Tag: title
#: man-kdesvn.1.docbook:189
#, no-c-format
msgid "Qt options:"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:192
#, no-c-format
msgid "--display &lt;displayname&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:194
#, no-c-format
msgid "Use the X-server display 'displayname'"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:198
#, no-c-format
msgid "--session &lt;sessionId&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:200
#, no-c-format
msgid "Restore the application for the given 'sessionId'"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:204
#, no-c-format
msgid "--cmap"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:206
#, no-c-format
msgid ""
"Causes the application to install a private color map on an 8-bit display"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:211
#, no-c-format
msgid "--ncols &lt;count&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:213
#, no-c-format
msgid ""
"Limits the number of colors allocated in the color cube on an 8-bit display, "
"if "
"the application is using the QApplication::ManyColor color specification"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:220
#, no-c-format
msgid "--nograb"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:222
#, no-c-format
msgid "tells Qt to never grab the mouse or the keyboard"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:226
#, no-c-format
msgid "--dograb"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:228
#, no-c-format
msgid ""
"running under a debugger can cause an implicit -nograb, use -dograb to "
"override"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:233
#, no-c-format
msgid "--sync"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:235
#, no-c-format
msgid "switches to synchronous mode for debugging"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:239
#, no-c-format
msgid "--fn, --font &lt;fontname&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:241
#, no-c-format
msgid "defines the application font"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:245
#, no-c-format
msgid "--bg, --background &lt;color&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:247
#, no-c-format
msgid ""
"sets the default background color and an application palette (light and dark "
"shades are calculated)"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:253
#, no-c-format
msgid "--fg, --foreground &lt;color&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:255
#, no-c-format
msgid "sets the default foreground color"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:259
#, no-c-format
msgid "--btn, --button &lt;color&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:261
#, no-c-format
msgid "sets the default button color"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:265
#, no-c-format
msgid "--name &lt;name&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:267
#, no-c-format
msgid "sets the application name"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:271
#, no-c-format
msgid "--title &lt;title&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:273
#, no-c-format
msgid "sets the application title (caption)"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:277
#, no-c-format
msgid "--visual TrueColor"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:279
#, no-c-format
msgid "forces the application to use a TrueColor visual on an 8-bit display"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:284
#, no-c-format
msgid "--inputstyle &lt;inputstyle&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:286
#, no-c-format
msgid ""
"sets XIM (X Input Method) input style. Possible values are onthespot, "
"overthespot, offthespot and root"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:292
#, no-c-format
msgid "--im &lt;XIM server&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:294
#, no-c-format
msgid "set XIM server"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:298
#, no-c-format
msgid "--noxim"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:300
#, no-c-format
msgid "disable XIM"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:304
#, no-c-format
msgid "--reverse"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:306
#, no-c-format
msgid "mirrors the whole layout of widgets"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:310
#, no-c-format
msgid "--stylesheet"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:312
#, no-c-format
msgid "&lt;file.qss&gt; applies the Qt stylesheet to the application widgets"
msgstr ""

