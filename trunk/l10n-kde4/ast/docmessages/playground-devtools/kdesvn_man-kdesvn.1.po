#: man-kdesvn.1.docbook:145
#, no-c-format
msgid "--caption &lt;caption&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:147
#, no-c-format
msgid "Use 'caption' as name in the titlebar"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:151
#, no-c-format
msgid "--icon &lt;icon&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:153
#, no-c-format
msgid "Use 'icon' as the application icon"
msgstr ""

#. Tag: option
#: man-kdesvn.1.docbook:157
#, no-c-format
msgid "--config &lt;filename&gt;"
msgstr ""

#. Tag: para
#: man-kdesvn.1.docbook:159
#, no-c-format
msgid "Use alternative configuration file"
msgstr ""

