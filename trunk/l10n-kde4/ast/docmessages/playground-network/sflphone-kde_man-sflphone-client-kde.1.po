#. Tag: title
#: man-sflphone-client-kde.1.docbook:44
#, no-c-format
msgid "Description"
msgstr ""

#. Tag: para
#: man-sflphone-client-kde.1.docbook:45
#, no-c-format
msgid ""
"SFLphone is meant to be a robust enterprise-class desktop phone. It provides "
"functions like call transfer, call hold, multiple lines, multiple accounts "
"support. SFLphone audio layer is built upon a native ALSA interface and a "
"native PulseAudio interface. sflphone-client-kde is a KDE client for "
"SFLphone; "
"it communicates with the core side through D-Bus."
msgstr ""

