#. Tag: menuchoice
#: menu-commands.docbook:274
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Create Checksum</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:280
#, no-c-format
msgid ""
"<link linkend=\"checksum\">Checksum creation</link> on file(s) and/or "
"folder(s)."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:287
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Verify Checksum</guimenuitem>"
msgstr ""

#. Tag: link
#: menu-commands.docbook:294
#, no-c-format
msgid "Verify Checksum"
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:301
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl; <keycap>P</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Split File</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:311
#, no-c-format
msgid ""
"The <link linkend=\"splitter\">Split file</link> function splits a file up "
"into "
"multiple smaller files so that it can be stored on several smaller media "
"(like "
"<hardware>diskettes, zip-drives, ...</hardware>) or sent by e-mail."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:320
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl; <keycap>B</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Combine Files</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:330
#, no-c-format
msgid ""
"The <link linkend=\"splitter\">Combine files</link> function combines "
"multiple "
"files into one file after the <link linkend=\"splitter\">Split file</link> "
"function was used."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:338
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl; <keycap>Q</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:348
#, no-c-format
msgid ""
"Closes &krusader; and cleans up the temporary directory, the same as pressing "
"<keycap>F10</keycap> key."
msgstr ""

#. Tag: title
#: menu-commands.docbook:356
#, no-c-format
msgid "Edit Menu"
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:360
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl; <keycap>X</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Cut</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:370
#, no-c-format
msgid ""
"<link linkend=\"copying\">Cuts</link> the selected file(s) to the clipboard "
"to "
"be moved to another location."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:377
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl; <keycap>C</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Copy</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:387
#, no-c-format
msgid ""
"<link linkend=\"copying\">Copies</link> the selected file(s) to the clipboard "
"to be moved to another location."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:394
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl; <keycap>V</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Paste</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:404
#, no-c-format
msgid ""
"<link linkend=\"copying\">Pastes</link> previously cut or copied items from "
"the "
"clipboard to the current directory."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:412
#, no-c-format
msgid ""
"<shortcut> <keycap>F9</keycap> </shortcut> <guimenu>Edit</guimenu> <"
"guimenuitem>"
"Rename</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:421
#, no-c-format
msgid "<link linkend=\"renaming\">Renames</link> the currently selected file."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:428
#, no-c-format
msgid ""
"<shortcut> <keycap>F8</keycap> </shortcut> <guimenu>Edit</guimenu> <"
"guimenuitem>"
"Delete</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:437
#, no-c-format
msgid ""
"<link linkend=\"deleting\">Deletes</link> the currently selected file(s)."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:444
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl; <keycap>+</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select Group</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:454
#, no-c-format
msgid ""
"Opens a dialog which allows you to select files in the active panel. In the "
"<guilabel>Search for</guilabel> dialog place the main search criteria. Enter "
"a "
"filename, a wildcard ( <literal role=\"extension\">*.o.*</literal>"
", <literal role=\"extension\">*.c</literal> &etc;) or both - separated by a "
"space. When using <literal>'text'</literal>, the results are the same as "
"<literal>'*text*'</literal>. You can exclude files from the search with '|' "
"(&eg; <literal role=\"extension\">'*.cpp *.h | *.moc.cpp'</literal>"
"). With the <link linkend=\"profiles\">profile handler</link> "
"you can manage your selections for future usage. A double-click on a profile "
"is "
"the same as entering the selection and pressing the <guibutton>OK</guibutton> "
"button. More options for <guilabel>Select Group</guilabel> "
"dialog are explained in the <link linkend=\"krusearcher\">Search dialog</link>"
", which are basically almost the same dialogs."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:479
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl; <keycap>-</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Unselect Group</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:489
#, no-c-format
msgid ""
"The opposite of <guimenuitem>Select Group</guimenuitem>"
". The files that match the pattern in the active panel will be deselected."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:497
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt; <keycap>+</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Select All</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:507
#, no-c-format
msgid ""
"Selects all files in the active panel. You can also select all directories by "
"activating the <guilabel>Autoselect directories</guilabel> "
"option in the <link linkend=\"konfig-panel\">Konfigurator Panel page</link>."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:515
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt; <keycap>-</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Unselect All</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:525
#, no-c-format
msgid "Unselects all the files in the active panel."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:530
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt; <keycap>*</keycap></keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Invert Selection<"
"/guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:540
#, no-c-format
msgid ""
"Inverts the selection status of all the files in the active panel (&ie; "
"selected files will become unselected and deselected files will become "
"selected)."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:548
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Restore Selection</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:554
#, no-c-format
msgid "Restore the selection status of previously unselected items."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:559
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;&Shift; <keycap>C</keycap><"
"/keycombo> "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Compare "
"Directories</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:569
#, no-c-format
msgid ""
"Toggles &krusader; <link linkend=\"compare-dir\">Compare Directories</link> "
"function."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:575
#, no-c-format
msgid "<guimenu>Edit</guimenu> <guimenuitem>Compare Setup</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:581
#, no-c-format
msgid "Configures the <guimenuitem>Compare Directories</guimenuitem> function."
msgstr ""

#. Tag: para
#: menu-commands.docbook:585
#, no-c-format
msgid "<guimenuitem>Select Newer and Single</guimenuitem> (default)"
msgstr ""

#. Tag: guimenuitem
#: menu-commands.docbook:590
#, no-c-format
msgid "Select Single"
msgstr ""

#. Tag: guimenuitem
#: menu-commands.docbook:595
#, no-c-format
msgid "Select Newer"
msgstr ""

#. Tag: guimenuitem
#: menu-commands.docbook:600
#, no-c-format
msgid "Select Different and Single"
msgstr ""

#. Tag: guimenuitem
#: menu-commands.docbook:605
#, no-c-format
msgid "Select Different"
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:613
#, no-c-format
msgid ""
"<guimenu>Edit</guimenu> <guimenuitem>Calculate Occupied Space</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:619
#, no-c-format
msgid ""
"<link linkend=\"calculate\">Calculates occupied space</link> "
"of files and folders, archives and remote filesystems."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:627
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt; <keysym>Return</keysym></keycombo>"
" "
"</shortcut> <guimenu>Edit</guimenu> <guimenuitem>Properties</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:637
#, no-c-format
msgid ""
"Opens the properties dialog for the currently selected file. (KP refers to "
"Key "
"Pad.)"
msgstr ""

#. Tag: title
#: menu-commands.docbook:644
#, no-c-format
msgid "Go Menu"
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:648
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt; <keysym>Up</keysym></keycombo> "
"</shortcut> <guimenu>Go</guimenu> <guimenuitem>Up</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:658
#, no-c-format
msgid "Navigates to the parent directory of the active panel."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:664
