#. Tag: menuchoice
#: menu-commands.docbook:32
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Shift; <keycap>F4</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>New Text File</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:42
#, no-c-format
msgid ""
"Creates a new text file in the current directory, unless another directory is "
"specified. The new file is opened for editing after it is created."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:49
#, no-c-format
msgid ""
"<shortcut> <keycap>F7</keycap> </shortcut> <guimenu>File</guimenu> <"
"guimenuitem>"
"New Directory</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:58
#, no-c-format
msgid "Creates a new directory in the current directory."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:64
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\"> &Alt;&Ctrl; <keycap>S</keycap><"
"/keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>New Symlink</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:75
#, no-c-format
msgid "Creates a symbolic link to the currently selected file."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:81
#, no-c-format
msgid ""
"<shortcut> <keycap>F3</keycap> </shortcut> <guimenu>File</guimenu> <"
"guimenuitem>"
"View File</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:90
#, no-c-format
msgid ""
"Opens the currently selected file for <link linkend=\"kredit\">viewing</link>."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:96
#, no-c-format
msgid ""
"<shortcut> <keycap>F4</keycap> </shortcut> <guimenu>File</guimenu> <"
"guimenuitem>"
"Edit File</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:105
#, no-c-format
msgid ""
"Opens the currently selected file for <link linkend=\"kredit\">editing</link>."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:111
#, no-c-format
msgid ""
"<shortcut> <keycap>F5</keycap> </shortcut> <guimenu>File</guimenu> <"
"guimenuitem>"
"Copy to other panel</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:120
#, no-c-format
msgid "Copy the currently selected files or directories to the other panel."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:126
#, no-c-format
msgid ""
"<shortcut> <keycap>F6</keycap> </shortcut> <guimenu>File</guimenu> <"
"guimenuitem>"
"Move</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:135
#, no-c-format
msgid ""
"Opens a dialog to <link linkend=\"copying\">move</link> "
"the currently selected files or directories to a specified location."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:142
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;&Shift; <keycap>P</keycap><"
"/keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Pack</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:152
#, no-c-format
msgid ""
"Creates a <link linkend=\"pack-archive\">new archive</link> "
"of all the selected files and directories in the active panel."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:160
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;&Shift; <keycap>U</keycap><"
"/keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Unpack</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:170
#, no-c-format
msgid ""
"<link linkend=\"unpacking-archives\">Unpacks</link> all the selected files in "
"the active panel."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:177
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Alt;&Shift; <keycap>E</keycap><"
"/keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Test Archive</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:187
#, no-c-format
msgid "<link linkend=\"test-archive\">Tests archive</link> for corruption."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:194
#, no-c-format
msgid "<guimenu>File</guimenu> <guimenuitem>Compare by Content</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:200
#, no-c-format
msgid ""
"Compares two current files by content - one from each panel via an external "
"graphical diff utility. By default &kompare; is used, but you can also use "
"&eg; "
"<ulink url=\"http://furius.ca/xxdiff/\"><application>xxdiff</application>"
"</ulink> or <ulink url=\"http://kdiff3.sourceforge.net\"><application>"
"KDiff3</application></ulink> , change it in the <link "
"linkend=\"konfig-dependencies\">Konfigurator Dependencies page</link>."
msgstr ""

#. Tag: menuchoice
#: menu-commands.docbook:210
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Shift; <keycap>F9</keycap></keycombo> "
"</shortcut> <guimenu>File</guimenu> <guimenuitem>Multi Rename</guimenuitem>"
msgstr ""

#. Tag: para
#: menu-commands.docbook:220
#, no-c-format
msgid ""
"This menu option starts <ulink url=\"http://www.krename.net\"><application>"
"Krename</application></ulink>, a very powerful external batch renamer for "
"&kde; "
"3.x or newer."
msgstr ""

