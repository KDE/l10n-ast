msgstr ""

#. Tag: para
#: menu-commands.docbook:248
#, no-c-format
msgid "Setting access and modification dates"
msgstr ""

#. Tag: para
#: menu-commands.docbook:251
#, no-c-format
msgid "Changing permissions and file ownership"
