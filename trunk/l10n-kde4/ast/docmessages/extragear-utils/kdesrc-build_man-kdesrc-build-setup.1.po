#. Tag: refpurpose
#: man-kdesrc-build-setup.1.docbook:36
#, no-c-format
msgid ""
"Creates a <filename>~/.kdesrc-buildrc</filename> configuration file for "
"<command>kdesrc-build</command>(1)."
msgstr ""

#. Tag: title
#: man-kdesrc-build-setup.1.docbook:47
#, no-c-format
msgid "DESCRIPTION"
msgstr ""

#. Tag: para
#: man-kdesrc-build-setup.1.docbook:49
#, no-c-format
msgid ""
"The <command>kdesrc-build-setup</command> command is used to generate a "
"simple "
"configuration file for <command>kdesrc-build</command>(1)."
msgstr ""

#. Tag: para
#: man-kdesrc-build-setup.1.docbook:52
#, no-c-format
msgid ""
"It requires the <command>dialog</command>(1) script be available, and Perl "
"(just like <command>kdesrc-build</command>)."
msgstr ""

#. Tag: para
#: man-kdesrc-build-setup.1.docbook:55
#, no-c-format
msgid ""
"No command line options are accepted. The operation of the program is instead "
"driven through dialog-style prompts to gather the data required to generate "
"the "
"configuration file. The configuration file can be saved to a location other "
"than <filename>~/.kdesrc-buildrc</filename>."
msgstr ""

#. Tag: title
#: man-kdesrc-build-setup.1.docbook:63
#, no-c-format
msgid "OPTIONS"
msgstr ""

#. Tag: para
#: man-kdesrc-build-setup.1.docbook:65
#, no-c-format
msgid "No command line options are supported for this command."
msgstr ""

#. Tag: title
#: man-kdesrc-build-setup.1.docbook:70
#, no-c-format
msgid "EXIT STATUS"
msgstr ""

#. Tag: emphasis
#: man-kdesrc-build-setup.1.docbook:76
#, no-c-format
msgid "<emphasis>0</emphasis>"
msgstr ""

#. Tag: para
#: man-kdesrc-build-setup.1.docbook:80
#, no-c-format
msgid "Success"
msgstr ""

#. Tag: emphasis
#: man-kdesrc-build-setup.1.docbook:88
#, no-c-format
msgid "Anything else"
msgstr ""

#. Tag: para
#: man-kdesrc-build-setup.1.docbook:92
#, no-c-format
msgid ""
"Either there was an I/O failure of some type (invalid permissions, disk full, "
"etc.), or the user canceled the program by pressing <keysym>ESC</keysym> "
"during a dialog."
msgstr ""

#. Tag: title
#: man-kdesrc-build-setup.1.docbook:104
#, no-c-format
msgid "ENVIRONMENT"
msgstr ""

#. Tag: envar
#: man-kdesrc-build-setup.1.docbook:110
#, no-c-format
msgid "HOME"
msgstr ""

#. Tag: para
#: man-kdesrc-build-setup.1.docbook:114
#, no-c-format
msgid ""
"Used for tilde-expansion of file names, and is the default base for the "
"source, "
"build, and installation directories."
msgstr ""

#. Tag: term
#: man-kdesrc-build-setup.1.docbook:122
#, no-c-format
msgid "<command>dialog</command>(1)"
msgstr ""

#. Tag: para
#: man-kdesrc-build-setup.1.docbook:127
#, no-c-format
msgid ""
"The <command>dialog</command>(1) program is required for the operation of "
"this "
"script and may obey environment variables of its own."
msgstr ""

#. Tag: title
#: man-kdesrc-build-setup.1.docbook:138
#, no-c-format
msgid "FILES"
msgstr ""

#. Tag: para
#: man-kdesrc-build-setup.1.docbook:140
#, no-c-format
msgid ""
"<filename>~/.kdesrc-buildrc</filename> - Default global configuration file, "
"generated by default by this script. If the file already exists, the existing "
"file is moved to <filename>~/.kdesrc-buildrc~</filename> "
"as a backup before generating the configuration."
msgstr ""

#. Tag: para
#: man-kdesrc-build-setup.1.docbook:145
#, no-c-format
msgid ""
"The file generated by this script can be saved to a different name instead."
msgstr ""

