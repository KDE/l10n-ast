msgstr ""

#. Tag: para
#: installation.docbook:162
#, no-c-format
msgid ""
"<ulink url=\"http://pkgsrc.se/sysutils/krusader\"><trademark class="
"\"registered\">NetBSD</trademark></ulink>, <ulink url=\"http://www.lunar-"
