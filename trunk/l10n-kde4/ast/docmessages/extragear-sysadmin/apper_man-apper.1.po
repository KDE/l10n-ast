msgid ""
"<command>apper</command> <group choice=\"opt\"><option>--updates</option> </"
"group> <group choice=\"opt\"><option>--settings</option> </group> <group "
"choice=\"opt\"><option>--backend-details</option> </group> <group choice="
"\"opt\"><option>--install-mime-type</option><replaceable> mime-type</"
"replaceable></group> <group choice=\"opt\"><option>--install-package-name</"
"option><replaceable> name</replaceable></group> <group choice=\"opt"
"\"><option>--install-provide-file</option><replaceable> file</replaceable></"
"group> <group choice=\"opt\"><option>--install-font-resource</"
