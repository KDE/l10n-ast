#: interfaces/kimproxy/interface/dbusinstantmessenger.desktop:4
msgctxt "Comment"
msgid "Instant Messenger with a D-Bus interface"
msgstr "Mensaxería nel intre con interfaz D-Bus"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:2
msgctxt "Name|standard desktop component"
msgid "Instant Messenger"
msgstr "Mensaxeru nel intre"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:58
msgctxt "Comment"
msgid ""
"The instant messenger allows two-way chat between individuals and groups."
msgstr ""
"El mensaxeru nel intre permite charres bidireicionales ente individuos y "
"grupos."

#: interfaces/kspeech/dbustexttospeech.desktop:4
msgctxt "Comment"
msgid "Text-to-Speech Service with a D-Bus interface"
msgstr "Serviciu Testu Faláu con interfaz D-Bus"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:2
msgctxt "Name|standard desktop component"
msgid "Embedded Text Editor"
msgstr "Editor de testu encrustáu"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:57
msgctxt "Comment"
msgid ""
"The text editor service provides applications with a text viewer and editor. "
"KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
"El serviciu d'editor de testu ufre a les aplicaciones un visor y editor de "
"testu. Les aplicaciones KDE qu'ufren facilidáes d'edición de testu habríen "
"d'usar esti serviciu."

#: interfaces/ktexteditor/ktexteditor.desktop:5
msgctxt "Comment"
msgid "Embeddable Text Editor Component (with Doc/View Separation)"
msgstr ""
"Componente encrustable d'edición de testu (con dixebra documentu/vista)"

#: interfaces/ktexteditor/ktexteditor_loadsavefiltercheckplugin.desktop:5
msgctxt "Comment"
msgid "KTextEditor load/save filter/check plugin"
msgstr "Complementu de peñera/comprobación p'abrir/guardar de KTextEditor"

#: interfaces/ktexteditor/ktexteditorplugin.desktop:5
msgctxt "Comment"
msgid "KTextEditor Plugin"
msgstr "Complementu KTextEditor"

#: kate/data/katepart.desktop:2
msgctxt "Name"
msgid "Embedded Advanced Text Editor"
msgstr "Editor de testu avanzáu encrustáu"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:16
msgctxt "Name"
msgid "Autobookmarker"
msgstr "Automarcador"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:97
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"
msgstr ""
"Afita marcadores nes llinies que concasen con un patrón al cargar los "
"documentos"

#: kate/plugins/autobrace/ktexteditor_autobrace.desktop:18
msgctxt "Name"
msgid "AutoBrace"
msgstr "AutoBrace"

#: kate/plugins/autobrace/ktexteditor_autobrace.desktop:49
msgctxt "Comment"
msgid "Insert closing braces on pressing Enter"
msgstr ""

#: kate/plugins/exporter/ktexteditor_exporter.desktop:18
msgctxt "Name"
msgid "Exporter"
msgstr "Exporter"

#: kate/plugins/exporter/ktexteditor_exporter.desktop:50
msgctxt "Comment"
msgid "Export highlighted document to HTML"
msgstr ""

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:17
msgctxt "Name"
msgid "Insert File"
msgstr "Inxertar Ficheru"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:102
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Inxertar un ficheru lleíble na posición del cursor"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:17
msgctxt "Name"
msgid "Data Tools"
msgstr "Ferramientes de datos"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:92
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"
msgstr ""
"Activar ferramientes de datos como'l diccionariu de sinónimos y l'iguador "
"ortográficu (si tan instalaos)"

#: kate/plugins/pythonencoding/ktexteditor_python-encoding.desktop:5
msgctxt "Name"
msgid "Python encoding checker/adder"
msgstr "Verificador/inclusor de la codificación Python"

#: kate/plugins/pythonencoding/ktexteditor_python-encoding.desktop:70
msgctxt "Comment"
msgid "While saving check encoding of python files and add an encoding line"
msgstr ""
"Al guardar comprueba la codificación de los ficheros Python y amesta una "
"llinia de codificación"

#: kate/plugins/timedate/ktexteditor_timedate_config.desktop:7
msgctxt "Name"
msgid "Format of Time & Date insertion"
msgstr "Formatu d'inxertu de la hora y data"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:18
msgctxt "Name"
msgid "Time & Date"
msgstr "Hora y Data"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:101
