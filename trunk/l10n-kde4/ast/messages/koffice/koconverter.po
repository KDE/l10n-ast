#: koconverter.cpp:63
msgid "KOConverter"
msgstr "KOConverter"

#: koconverter.cpp:64
msgid "KOffice Document Converter"
msgstr "Conversor de Documentos de KOffice"

#: koconverter.cpp:66
msgid "(c) 2001-2004 KOffice developers"
msgstr "(c) 2001-2004, los desendolcadores de KOffice"

#: koconverter.cpp:67
msgid "David Faure"
msgstr "David Faure"

#: koconverter.cpp:68
msgid "Nicolas Goutte"
msgstr "Nicolas Goutte"

#: koconverter.cpp:72
msgid "Input file"
msgstr "Archivu d'entrada"

#: koconverter.cpp:73
msgid "Output file"
msgstr "Archivu de salida"

#: koconverter.cpp:74
msgid "Make a backup of the destination file"
msgstr "Facer una copia de respaldu del archivu de destín"

#: koconverter.cpp:75
msgid "Batch mode: do not show dialogs"
msgstr "Móu de procesu por lotes: nun amosa los cuadros de diálogu"

#: koconverter.cpp:76
msgid "Interactive mode: show dialogs (default)"
msgstr "Móu interactivu: amosa los cuadros de diálogu (predefiníu)"

#: koconverter.cpp:77
msgid "Mimetype of the output file"
msgstr "Tipu mime del ficheru de salida"

#: koconverter.cpp:117
#, kde-format
msgid "Mimetype for input file %1 not found!"
msgstr "Tipo mime pa archivu d'entrada %1 non atopáu"

#: koconverter.cpp:127
#, kde-format
msgid "Mimetype not found %1"
msgstr "Tipu mime %1 non atopáu"

#: koconverter.cpp:136
msgid "Mimetype not found, try using the -mimetype option"
msgstr "Tipo mime non atopáu, intente usar la opción -mimetype"

#: koconverter.cpp:150
msgid "*** The conversion failed! ***"
msgstr "*** Falló la conversión. ***"

#: koconverter.cpp:155
msgid "Two arguments required"
msgstr "Necesítense dos argumentos"

