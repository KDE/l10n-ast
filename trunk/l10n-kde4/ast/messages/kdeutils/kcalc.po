msgstr "Si agrupar díxitos."

#. i18n: file: kcalc.kcfg:96
#. i18n: ectx: label, entry (TwosComplement), group (General)
#: rc.cpp:629
msgid "Whether to use Two's Complement for non-decimal numbers."
msgstr "Usu de complementu a dos pa númberos non decimales."

#. i18n: file: kcalc.kcfg:101
#. i18n: ectx: whatsthis, entry (TwosComplement), group (General)
#: rc.cpp:632
msgid ""
"\n"
"        Select to use Two's Complement notation for Binary, Octal\n"
"        and Hexidecimal numbers. This is a common notation to represent\n"
"        negative numbers in computers.\n"
"      "
msgstr ""
"\n"
"        Esbilla l'usu de la notación complementu a dos pa númberos\n"
"        binarios, octales y hexadecimales. Trátase d'una notación típica pa\n"
"        representar númberos negativos en sistemes informáticos.\n"
"      "

