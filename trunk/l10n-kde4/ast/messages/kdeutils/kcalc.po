#. i18n: file: kcalc.kcfg:62
#. i18n: ectx: label, entry (Precision), group (Precision)
#: rc.cpp:156
msgid "Maximum number of digits displayed."
msgstr "Máximu númberu de decimales que s'amuesen."

#. i18n: file: kcalc.kcfg:68
#. i18n: ectx: whatsthis, entry (Precision), group (Precision)
#: rc.cpp:159
msgid ""
"\n"
"\tKCalc can compute with many more digits than the number that\n"
"\tfits on the display. This setting gives the maximum number of\n"
"\tdigits displayed, before KCalc starts using scientific notation,\n"
"\ti.e. notation of the type 2.34e12.\n"
"      "
msgstr ""
"\n"
"\tKCalc pue calcular munchos más decimales que'l númberu que\n"
"\tcueye nel ventanu. Esta configuración da'l máximu númberu de\n"
"\tdecimales que s'amuesen, antes de que KCalc entame a usar\n"
"\tnotación científica, ex. notación del tipo 2.34e12.\n"
"      "

#. i18n: file: kcalc.kcfg:74
