#: kwriteconfig.cpp:34
msgid "KWriteConfig"
msgstr "KWriteConfig"

#: kwriteconfig.cpp:36
msgid "Write KConfig entries - for use in shell scripts"
msgstr ""
"Escribir entraes de KConfig - pa usar en guiones del intérprete d'órdenes"

#: kwriteconfig.cpp:38
msgid "(c) 2001 Red Hat, Inc. & Luís Pedro Coelho"
msgstr "(c) 2001 Red Hat, Inc. & Luís Pedro Coelho"

#: kwriteconfig.cpp:40
msgid "Wrote kreadconfig on which this is based"
msgstr "Escribió kreadconfig, nel que se basa esti programa"

#: kwriteconfig.cpp:46
msgid "Use <file> instead of global config"
msgstr "Usar <ficheru> en llugar de la configuración global"

#: kwriteconfig.cpp:47
msgid "Group to look in. Use repeatedly for nested groups."
msgstr "Grupu nel que guetar. Usar de forma repetida pa grupos anidaos."

#: kwriteconfig.cpp:48
msgid "Key to look for"
msgstr "Clave a guetar"

#: kwriteconfig.cpp:49
msgid ""
"Type of variable. Use \"bool\" for a boolean, otherwise it is treated as a "
"string"
msgstr ""
"Triba de variable. Usa «bool» pa un booleanu, de lo contrario va tratase "
"como una cadena"

#: kwriteconfig.cpp:50
msgid "The value to write. Mandatory, on a shell use '' for empty"
msgstr ""
"El valor a escribir. Obligatoriu, nun intérprete d'órdenes usa '' pa indicar "
"baleru"

