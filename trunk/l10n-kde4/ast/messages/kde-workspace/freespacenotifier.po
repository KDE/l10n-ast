#: freespacenotifier.cpp:90
#, kde-format
msgctxt ""
"Warns the user that the system is running low on space on his home folder, "
"indicating the percentage and absolute MiB size remaining, and asks if the "
"user wants to do something about it"
msgid ""
"You are running low on disk space on your home folder (currently %2%, %1 MiB "
"free).\n"
"Would you like to run a file manager to free some disk space?"
msgstr ""
"Va quedando poco espaciu de discu nel to direutoriu personal (anguaño %2%, "
"%1 MiB llibres).\n"
"¿Quies executar un alministrador de ficheros pa lliberar dalgo d'espaciu del "
"discu?"

#: freespacenotifier.cpp:91
msgctxt "Opens a file manager like dolphin"
msgid "Open File Manager"
msgstr "Abrir l'alministrador de ficheros"

#: freespacenotifier.cpp:91
msgctxt "Closes the notification"
msgid "Do Nothing"
msgstr "Nun facer nada"

#: freespacenotifier.cpp:91
msgctxt "Allows the user to configure the warning notification being shown"
msgid "Configure Warning"
msgstr "Configurar l'avisu"

#: freespacenotifier.cpp:125
msgctxt "The settings dialog main page name, as in 'general settings'"
msgid "General"
msgstr "Xeneral"

#. i18n: ectx: label, entry (minimumSpace), group (General)
#: freespacenotifier.kcfg:9
msgid "Minimum free space before user starts being notified."
msgstr "Espaciu llibre mínimu enantes d'empezar a avisar al usuariu."

#. i18n: ectx: label, entry (enableNotification), group (General)
#: freespacenotifier.kcfg:15
msgid "Is the free space notification enabled."
msgstr "Si ta activáu l'avisu d'espaciu llibre."

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_enableNotification)
#: freespacenotifier_prefs_base.ui:17
msgid "Enable low disk space warning"
msgstr "Activar l'avisu de poco espaciu de discu"

#. i18n: ectx: property (text), widget (QLabel, label_minimumSpace)
#: freespacenotifier_prefs_base.ui:27
msgid "Warn when free space is below:"
msgstr "Avisar cuando l'espaciu llibre sea menor de:"

#. i18n: ectx: property (suffix), widget (QSpinBox, kcfg_minimumSpace)
#: freespacenotifier_prefs_base.ui:37
msgid " MiB"
msgstr " MiB"
