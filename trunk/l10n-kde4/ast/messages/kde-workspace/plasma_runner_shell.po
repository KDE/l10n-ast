#: shellrunner.cpp:73
#, kde-format
msgid "Run %1"
msgstr "Executar %1"

#~ msgid "Enter the user you want to run the application as here."
#~ msgstr "Introduz l'usuariu que quies qu'execute l'aplicación."

#~ msgid "User&name:"
#~ msgstr "&Nome d'usuariu:"

#~ msgid "Enter the password here for the user you specified above."
#~ msgstr "Introduz la contraseña pa l'usuariu qu'especificasti."

#~ msgid "Pass&word:"
#~ msgstr "&Contraseña:"

#~ msgid ""
#~ "Check this option if the application you want to run is a text mode "
#~ "application. The application will then be run in a terminal emulator "
#~ "window."
#~ msgstr ""
#~ "Marca esta opción si l'aplicación que quies executar ye una aplicación en "
#~ "mou testu. L'aplicación va executase nuna ventana de emulador de terminal."

#~ msgid "Run in &terminal window"
#~ msgstr "Executar en ventana de &terminal"

#~ msgid ""
#~ "Check this option if you want to run the application with a different "
#~ "user id. Every process has a user id associated with it. This id code "
#~ "determines file access and other permissions. The password of the user is "
#~ "required to do this."
#~ msgstr ""
#~ "Marca esta opción si quies executar l'aplicación con un id. d'usuariu "
#~ "distintu. Cada procesu tien un id. d'usuariu asociáu con él. Esti códigu "
#~ "d'identificación determina l'accesu a los ficheros y otros permisos. Pa "
#~ "facelo va requerise la contraseña del usuariu."

#~ msgid "Run as a different &user"
#~ msgstr "Executar como un &usuariu diferente"
