#: solid-network.cpp:54
msgid "solid-network"
msgstr "solid-network"

#: solid-network.cpp:56
msgid ""
"KDE tool for querying and controlling your network interfaces from the "
"command line"
msgstr ""
"Ferramienta de KDE pa restolar y controlar les interfaces de rede dende la "
"llinia d'ordes"

#: solid-network.cpp:366
msgid "Syntax Error: Not enough arguments"
msgstr "Fallu de sintaxis: Nun hai bastantes argumentos"

#: solid-network.cpp:372
msgid "Syntax Error: Too many arguments"
msgstr "Fallu de sintaxis: Demasiaos argumentos"

#: solid-network.cpp:384
msgid "Show available commands by domains"
msgstr "Amosar les ordes disponibles por dominiu"

#: solid-network.cpp:386
msgid "Command (see --commands)"
msgstr "Orde (ver --commands)"

#: solid-network.cpp:388
msgid "Arguments for command"
msgstr "Argumentos pa la orde"

#: solid-network.cpp:400
msgid "Syntax:"
msgstr "Sintaxis:"

#: solid-network.cpp:403
msgid "             # List the network devices present.\n"
msgstr "             # Llista de preseos de rede presentes.\n"

#: solid-network.cpp:406
msgid ""
"             # List the networks known to the device specified by 'uni'.\n"
msgstr ""
"             # Llista de les redes conocíes pol preséu especificáu por "
"'uni'.\n"

#: solid-network.cpp:409
msgid ""
"             # Query whether networking features are active or not.\n"
"             # - If the 'status' option is given, return whether\n"
"             # networking is enabled for the system\n"
"             # - If the 'wireless' option is given, return whether\n"
"             # wireless is enabled for the system\n"
"             # - If the 'wireless-hardware' option is given,\n"
"             #  return whether the wireless hardware is enabled\n"
"             # - If the 'interface' option is given, print the\n"
"             # properties of the network interface that 'uni' refers to.\n"
"             # - If the 'network' option is given, print the\n"
"             # properties of the network on 'device-uni' that 'network-uni' "
"refers to.\n"
msgstr ""
"             # Consulta si les carauterístiques de rede tan actives o non.\n"
"             # - Si se da la opción 'status', devuelve si les\n"
"             # redes tan activáes nel sistema\n"
"             # - Si se da la opción 'wireless', devuelve si \n"
"             # l'inalámbricu ta activáu nel sistema\n"
"             # - Si se da la opción 'wireless-hardware', devuelve\n"
"             #  si el hardware inalámbricu ta activáu\n"
"             # - Si se da la opción 'interface', imprenta les\n"
"             # propiedáes de la interfaz de rede a la que se refier 'uni'.\n"
"             # - Si se da la opción 'network', imprenta les\n"
"             # propiedáes de la rede en 'device-uni' a la que se refier "
"'network-uni'.\n"

#: solid-network.cpp:422 solid-network.cpp:425
msgid "             # Enable or disable networking on this system.\n"
msgstr "             # Activar o desactivar les redes nesti sistema.\n"

#: solid-network.cpp:428
msgid ""
"             # Activate the network 'network-uni' on 'device-uni'.\n"
"             # Optionally, use WEP128, open-system encryption with hex key "
"'key'. (Hardcoded)\n"
"             # Where 'authentication' is one of:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 "
"'key' [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
"             # wpaeap UNIMPLEMENTED IN SOLIDSHELL\n"
msgstr ""
"             # Activar la rede 'network-uni' en 'device-uni'.\n"
"             # Opcionalmente, usar WEP128, tapecimientu de sistema abiertu "
"cola clave hex 'key'. (Afitao en códigu)\n"
"             # Onde 'authentication' ye una ente:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 "
"'key' [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes clave\n"
"             # wpaeap NUN IMPLEMENTAO EN SOLIDSHELL\n"

