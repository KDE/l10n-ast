msgstr "Fallu de sintaxis: Opción desconocida '%1'"

#: solid-powermanagement.cpp:306
#, kde-format
msgid "Syntax Error: Unknown command '%1'"
msgstr "Fallu de sintaxis: Orde desconocida '%1'"

#: solid-powermanagement.cpp:355
#, kde-format
msgid "Unsupported suspend method: %1"
msgstr "Métodu de suspensión nun permitíu: %1"

