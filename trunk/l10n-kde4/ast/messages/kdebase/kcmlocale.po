msgstr "Símbolu &decimal:"

#: localenum.cpp:58
msgid "Tho&usands separator:"
msgstr "Sepa&rtador de los miles:"

#: localenum.cpp:68
msgid "Positive si&gn:"
msgstr "Si&gnu positivu:"

#: localenum.cpp:78
msgid "&Negative sign:"
msgstr "Signu &negativu:"

