#: main.cpp:40
msgid "kwinstartmenu"
msgstr "kwinstartmenu"

#: main.cpp:41
msgid "An application to create/update or remove Windows Start Menu entries"
msgstr "Una aplicación pa crear/anovar o desaniciar entraes del menú d'entamu"

#: main.cpp:43
msgid "(C) 2008-2010 Ralf Habacker"
msgstr "(C) 2008-2010 Ralf Habacker"

#: main.cpp:47
msgid "Remove installed Start Menu entries"
msgstr "Desaniciar entraes instalaes del menú d'entamu"

#: main.cpp:48
msgid "Install Start Menu entries (this is also the default when this option is not used)"
msgstr "Instalar entraes del menú d'entamu (ye lo predeterminao cuando nun s'usa esta opción)"

#: main.cpp:49
msgid "query root path of Start Menu entries"
msgstr "pedir camín raíz de les entraes del menú d'entamu"

#: main.cpp:50
msgid "don't use categories for start menu entries"
msgstr "nun usar categoríes pa les entraes del menú d'entamu"

