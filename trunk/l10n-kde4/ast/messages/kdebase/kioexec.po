#: main.cpp:44
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr "KIO Exec - Abre ficheros remotos, controla cambeos, y solicita cargues"

#: main.cpp:52
msgid "'command' expected.\n"
msgstr "esperábase 'comandu'.\n"

#: main.cpp:81
#, kde-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"La URL %1\n"
"ye incorreuta"

#: main.cpp:83
#, kde-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"La URL %1 remota\n"
"nun ta permitida cola opción --tempfiles"

#: main.cpp:216
#, kde-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"El ficheru supuestamente temporal\n"
"%1\n"
"camudó.\n"
"¿Quies desanicialu?"

#: main.cpp:217
#: main.cpp:224
msgid "File Changed"
msgstr "Ficheru camudáu"

#: main.cpp:217
