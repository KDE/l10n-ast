#, kde-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"El ficheru\n"
"%1\n"
"camudó.\n"
"¿Quies xubir los cambeos?"

#: main.cpp:224
msgid "Upload"
msgstr "Xubir"

