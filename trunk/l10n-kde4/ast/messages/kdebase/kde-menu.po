#: kde-menu.cpp:93
#, kde-format
msgid "Menu item '%1' could not be highlighted."
msgstr "L'elementu del menú '%1' nun pudo resaltase."

#: kde-menu.cpp:106
msgid ""
"KDE Menu query tool.\n"
"This tool can be used to find in which menu a specific application is "
"shown.\n"
"The --highlight option can be used to visually indicate to the user where\n"
"in the KDE menu a specific application is located."
msgstr ""
"Ferramienta de solicitú del menú de KDE.\n"
"Esta ferramienta puede usase p'alcontrar el menú nel que s'amuesa "
"l'aplicación específica.\n"
"La opción --highlight puede usase pa conseñar visualmente al\n"
"usuariu au s'alcuentra una aplicación específica nel menú de KDE."

#: kde-menu.cpp:111
msgid "kde-menu"
msgstr "kde-menu"

#: kde-menu.cpp:113
msgid "Copyright © 2003–2011 Waldo Bastian and contributors"
msgstr ""

#: kde-menu.cpp:114
msgid "Waldo Bastian"
msgstr "Waldo Bastian"

#: kde-menu.cpp:114
msgid "Author"
msgstr "Autor"

#: kde-menu.cpp:119
msgid "Output data in UTF-8 instead of local encoding"
msgstr "Datos de salida en UTF8 en llugar de codificación llocal"

#: kde-menu.cpp:120
msgid ""
"Print menu-id of the menu that contains\n"
"the application"
msgstr ""
"Imprentar menú-id del menú que contién\n"
"l'aplicación"

#: kde-menu.cpp:121
msgid ""
"Print menu name (caption) of the menu that\n"
"contains the application"
msgstr ""
"Imprentar el nome del menú (pie) del menú que\n"
"contién l'aplicación"

#: kde-menu.cpp:122
msgid "Highlight the entry in the menu"
msgstr "Resaltar la entrada nel menú"

#: kde-menu.cpp:123
msgid "Do not check if sycoca database is up to date"
msgstr "Nun comprobar si la base de datos sycoca ta anovada"

#: kde-menu.cpp:124
msgid "The id of the menu entry to locate"
msgstr "La id de la entrada del menú a llocalizar"

#: kde-menu.cpp:133
msgid "You must specify an application-id such as 'kde4-konsole.desktop'"
msgstr "Tien d'indicar un ID d'aplicación, talo como «kde4-konsole.desktop»"

#: kde-menu.cpp:142
msgid ""
"You must specify at least one of --print-menu-id, --print-menu-name or --"
"highlight"
msgstr ""
"Tien d'especificar a lo menos una d'éstes:  --print-menu-id, --print-menu-"
"name o --highlight"

#: kde-menu.cpp:164
#, kde-format
msgid "No menu item '%1'."
msgstr "Ensin elementu de menú '%1'."

#: kde-menu.cpp:168
#, kde-format
msgid "Menu item '%1' not found in menu."
msgstr "Elementu de menú '%1' nun alcontráu nel menú."

