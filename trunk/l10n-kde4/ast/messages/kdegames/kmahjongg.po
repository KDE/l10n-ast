#: boardwidget.cpp:411
msgid "Undo operation done successfully."
msgstr "La operación de \"desfacer\" fízose bien."

#: boardwidget.cpp:415
msgid "What do you want to undo? You have done nothing!"
msgstr "¿Qué quies desfacer? ¡Si nun ficisti nada!"

#: boardwidget.cpp:434
msgid "Sorry, you have lost the game."
msgstr "Perdisti la partida. Ye una pena."

#: boardwidget.cpp:479
msgid "Demo mode. Click mousebutton to stop."
msgstr "Mou demostración. Calca un botón del mur pa paralu."

#: boardwidget.cpp:488
msgid "Now it is you again."
msgstr "Agora ye tuyu otra vuelta."

#: boardwidget.cpp:511
msgid "Your computer has lost the game."
msgstr "La to máquina perdió la partida."

#: boardwidget.cpp:606
msgid "Congratulations. You have won!"
msgstr "¡Felicidaes. Ganesti!"

#: boardwidget.cpp:653
msgid "Calculating new game..."
msgstr "Calculando nueva partida..."

#: boardwidget.cpp:658
msgid "Error converting board information!"
msgstr "¡Fallu al convertir la información del tableru!"

#: boardwidget.cpp:684
msgid "Ready. Now it is your turn."
msgstr "Sollerte. Tócate a ti."

#: boardwidget.cpp:692
msgid "Error generating new game!"
msgstr "¡Fallu al xenerar una partida nueva!"

#: boardwidget.cpp:1166
msgid "Game over: You have no moves left."
msgstr "Fin de la partida: nun te queden más movimientos posibles."

