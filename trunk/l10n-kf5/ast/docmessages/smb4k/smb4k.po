msgid ""
"The options located here influence the network communication. You can modify "
"the browsing and display behavior in the <guibutton>Basic Settings</"
"guibutton> tab, the options passed to the underlying "
"<application>libsmbclient</application> library in the <guibutton>Samba "
"Settings</guibutton> tab and enable the Wake-On-LAN features in the "
"<guibutton>Wake-On-LAN Settings</guibutton> tab."
msgstr ""

