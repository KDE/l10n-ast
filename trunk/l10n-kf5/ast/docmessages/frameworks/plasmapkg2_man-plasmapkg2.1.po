#. Tag: title
#: man-plasmapkg2.1.docbook:8
#, no-c-format
msgid "Plasma Package Manager"
msgstr ""

#. Tag: date
#: man-plasmapkg2.1.docbook:9
#, no-c-format
msgid "2014-04-25"
msgstr "2014-04-25"

#. Tag: releaseinfo
#: man-plasmapkg2.1.docbook:10
#, no-c-format
msgid "<releaseinfo>5.0</releaseinfo>"
msgstr ""

#. Tag: productname
#: man-plasmapkg2.1.docbook:11
#, no-c-format
msgid "&kde; plasmapkg2"
msgstr ""

#. Tag: manvolnum
#: man-plasmapkg2.1.docbook:16
#, no-c-format
msgid "<manvolnum>1</manvolnum>"
msgstr ""

#. Tag: refpurpose
#: man-plasmapkg2.1.docbook:21
#, no-c-format
msgid "Install, list, remove Plasma packages"
msgstr ""

#. Tag: cmdsynopsis
#: man-plasmapkg2.1.docbook:25
#, no-c-format
msgid ""
"<command>plasmapkg2</command> <group choice=\"opt\"><option>--hash</option> "
"<replaceable> path</replaceable></group> <group choice=\"opt\"><option>-g, --"
"global</option></group> <group choice=\"opt\"><option>-t, --type</option> "
"<replaceable> type</replaceable></group> <group choice=\"opt\"><option>-i, --"
"install</option> <replaceable> path</replaceable></group> <group choice=\"opt"
"\"><option>-s, --show</option> <replaceable> name</replaceable></group> "
"<group choice=\"opt\"><option>-u, --upgrade</option> <replaceable> path</"
"replaceable></group> <group choice=\"opt\"><option>-l, --list</option></"
"group> <group choice=\"opt\"><option>--list-types</option></group> <group "
"choice=\"opt\"><option>-r, --remove</option> <replaceable> name</"
"replaceable></group> <group choice=\"opt\"><option>-p, --packageroot</"
"option> <replaceable> path</replaceable></group> <arg choice=\"opt\">KDE "
"Generic Options</arg> <arg choice=\"opt\">Qt Generic Options</arg>"
msgstr ""

#. Tag: title
#: man-plasmapkg2.1.docbook:44
#, no-c-format
msgid "Description"
msgstr ""

#. Tag: para
#: man-plasmapkg2.1.docbook:45
#, no-c-format
msgid ""
"<command>plasmapkg2</command> is a command line tool to install, list, "
"remove Plasma packages."
msgstr ""

#. Tag: title
#: man-plasmapkg2.1.docbook:51
#, no-c-format
msgid "Options"
msgstr ""

#. Tag: term
#: man-plasmapkg2.1.docbook:55
#, no-c-format
msgid "<option>--hash</option> <replaceable> path</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmapkg2.1.docbook:56
#, no-c-format
msgid "Generate a SHA1 hash for the package at <quote>path</quote>."
msgstr ""

#. Tag: option
#: man-plasmapkg2.1.docbook:59
#, no-c-format
msgid "-g, --global"
msgstr ""

#. Tag: para
#: man-plasmapkg2.1.docbook:60
#, no-c-format
msgid "For install or remove, operates on packages installed for all users."
msgstr ""

#. Tag: term
#: man-plasmapkg2.1.docbook:63
#, no-c-format
msgid "<option>-t, --type</option> <replaceable> type</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmapkg2.1.docbook:64
#, no-c-format
msgid ""
"The type of package, &eg; theme, wallpaper, plasmoid, dataengine, runner, "
"layout-template, &etc; [plasmoid]."
msgstr ""

#. Tag: term
#: man-plasmapkg2.1.docbook:67
#, no-c-format
msgid "<option>-i, --install</option> <replaceable> path</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmapkg2.1.docbook:68
#, no-c-format
msgid "Install the package at <quote>path</quote>."
msgstr ""

#. Tag: term
#: man-plasmapkg2.1.docbook:71
#, no-c-format
msgid "<option>-s, --show</option> <replaceable> name</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmapkg2.1.docbook:72
#, no-c-format
msgid "Show information of package <quote>name</quote>."
msgstr ""

#. Tag: term
#: man-plasmapkg2.1.docbook:75
#, no-c-format
msgid "<option>-u, --upgrade</option> <replaceable> path</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmapkg2.1.docbook:76
#, no-c-format
msgid "Upgrade the package at <quote>path</quote>."
msgstr ""

#. Tag: option
#: man-plasmapkg2.1.docbook:79
#, no-c-format
msgid "-l, --list"
msgstr ""

#. Tag: para
#: man-plasmapkg2.1.docbook:80
#, no-c-format
msgid "List installed packages."
msgstr ""

#. Tag: option
#: man-plasmapkg2.1.docbook:83
#, no-c-format
msgid "--list-types"
msgstr ""

#. Tag: para
#: man-plasmapkg2.1.docbook:84
#, no-c-format
msgid "Lists all known Package types that can be installed."
msgstr ""

#. Tag: term
#: man-plasmapkg2.1.docbook:87
#, no-c-format
msgid "<option>-r, --remove</option> <replaceable> name</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmapkg2.1.docbook:88
#, no-c-format
msgid "Remove the package named <quote>name</quote>."
msgstr ""

#. Tag: term
#: man-plasmapkg2.1.docbook:91
#, no-c-format
msgid "<option>-p, --packageroot</option> <replaceable> path</replaceable>"
msgstr ""

#. Tag: para
#: man-plasmapkg2.1.docbook:92
#, no-c-format
msgid ""
"Absolute path to the package root. If not supplied, then the standard data "
"directories for this &kde; session will be searched instead."
msgstr ""

#. Tag: title
#: man-plasmapkg2.1.docbook:101
#, no-c-format
msgid "See Also"
msgstr ""

