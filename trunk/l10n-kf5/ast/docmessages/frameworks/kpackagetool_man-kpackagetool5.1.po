#. Tag: title
#: man-kpackagetool5.1.docbook:8
#, no-c-format
msgid "KPackage Manager"
msgstr ""

#. Tag: date
#: man-kpackagetool5.1.docbook:9
#, no-c-format
msgid "2015-07-31"
msgstr ""

#. Tag: releaseinfo
#: man-kpackagetool5.1.docbook:10
#, no-c-format
msgid "Frameworks 5.13"
msgstr ""

#. Tag: productname
#: man-kpackagetool5.1.docbook:11
#, no-c-format
msgid "KDE Frameworks"
msgstr ""

#. Tag: manvolnum
#: man-kpackagetool5.1.docbook:16
#, no-c-format
msgid "<manvolnum>1</manvolnum>"
msgstr ""

#. Tag: refpurpose
#: man-kpackagetool5.1.docbook:21
#, no-c-format
msgid "Install, list, remove Plasma packages"
msgstr ""

#. Tag: cmdsynopsis
#: man-kpackagetool5.1.docbook:25
#, no-c-format
msgid ""
"<command>kpackagetool5</command> <group choice=\"opt\"><option>-v, --"
"version</option></group> <group choice=\"opt\"><option>-h, --help</option></"
"group> <group choice=\"opt\"><option>--hash</option> <replaceable> path</"
"replaceable></group> <group choice=\"opt\"><option>-g, --global</option></"
"group> <group choice=\"opt\"><option>-t, --type</option> <replaceable> type</"
"replaceable></group> <group choice=\"opt\"><option>-i, --install</option> "
"<replaceable> path</replaceable></group> <group choice=\"opt\"><option>-s, --"
"show</option> <replaceable> name</replaceable></group> <group choice=\"opt"
"\"><option>-u, --upgrade</option> <replaceable> path</replaceable></group> "
"<group choice=\"opt\"><option>-l, --list</option></group> <group choice=\"opt"
"\"><option>--list-types</option></group> <group choice=\"opt\"><option>-r, --"
"remove</option> <replaceable> name</replaceable></group> <group choice=\"opt"
"\"><option>-p, --packageroot</option> <replaceable> path</replaceable></"
"group> <group choice=\"opt\"><option>--generate-index</option></group>"
msgstr ""

#. Tag: title
#: man-kpackagetool5.1.docbook:45
#, no-c-format
msgid "Description"
msgstr ""

#. Tag: para
#: man-kpackagetool5.1.docbook:46
#, no-c-format
msgid ""
"<command>kpackagetool5</command> is a command line tool to install, list, "
"remove Plasma packages."
msgstr ""

#. Tag: title
#: man-kpackagetool5.1.docbook:52
#, no-c-format
msgid "Options"
msgstr ""

#. Tag: option
#: man-kpackagetool5.1.docbook:56
#, no-c-format
msgid "-v, --version"
msgstr ""

#. Tag: para
#: man-kpackagetool5.1.docbook:57
#, no-c-format
msgid "Displays version information."
msgstr ""

#. Tag: option
#: man-kpackagetool5.1.docbook:60
#, no-c-format
msgid "-h, --help"
msgstr ""

#. Tag: para
#: man-kpackagetool5.1.docbook:61
#, no-c-format
msgid "Displays this help."
msgstr ""

#. Tag: term
#: man-kpackagetool5.1.docbook:64
#, no-c-format
msgid "<option>--hash</option> <replaceable> path</replaceable>"
msgstr ""

#. Tag: para
#: man-kpackagetool5.1.docbook:65
#, no-c-format
msgid "Generate a SHA1 hash for the package at <quote>path</quote>."
msgstr ""

#. Tag: option
#: man-kpackagetool5.1.docbook:68
#, no-c-format
msgid "-g, --global"
msgstr ""

#. Tag: para
#: man-kpackagetool5.1.docbook:69
#, no-c-format
msgid "For install or remove, operates on packages installed for all users."
msgstr ""

#. Tag: term
#: man-kpackagetool5.1.docbook:72
#, no-c-format
msgid "<option>-t, --type</option> <replaceable> type</replaceable>"
msgstr ""

#. Tag: para
#: man-kpackagetool5.1.docbook:73
#, no-c-format
msgid ""
"The type of package, &eg; theme, wallpaper, plasmoid, dataengine, runner, "
"layout-template, &etc; [plasmoid]."
msgstr ""

#. Tag: term
#: man-kpackagetool5.1.docbook:76
#, no-c-format
msgid "<option>-i, --install</option> <replaceable> path</replaceable>"
msgstr ""

#. Tag: para
#: man-kpackagetool5.1.docbook:77
#, no-c-format
msgid "Install the package at <quote>path</quote>."
msgstr ""

#. Tag: term
#: man-kpackagetool5.1.docbook:80
#, no-c-format
msgid "<option>-s, --show</option> <replaceable> name</replaceable>"
msgstr ""

#. Tag: para
#: man-kpackagetool5.1.docbook:81
#, no-c-format
msgid "Show information of package <quote>name</quote>."
msgstr ""

#. Tag: term
#: man-kpackagetool5.1.docbook:84
#, no-c-format
msgid "<option>-u, --upgrade</option> <replaceable> path</replaceable>"
msgstr ""

#. Tag: para
#: man-kpackagetool5.1.docbook:85
#, no-c-format
msgid "Upgrade the package at <quote>path</quote>."
msgstr ""

#. Tag: option
#: man-kpackagetool5.1.docbook:88
#, no-c-format
msgid "-l, --list"
msgstr ""

#. Tag: para
#: man-kpackagetool5.1.docbook:89
#, no-c-format
msgid "List installed packages."
msgstr ""

#. Tag: option
#: man-kpackagetool5.1.docbook:92
#, no-c-format
msgid "--list-types"
msgstr ""

#. Tag: para
#: man-kpackagetool5.1.docbook:93
#, no-c-format
msgid "Lists all known Package types that can be installed."
msgstr ""

#. Tag: term
#: man-kpackagetool5.1.docbook:96
#, no-c-format
msgid "<option>-r, --remove</option> <replaceable> name</replaceable>"
msgstr ""

#. Tag: para
#: man-kpackagetool5.1.docbook:97
#, no-c-format
msgid "Remove the package named <quote>name</quote>."
msgstr ""

#. Tag: term
#: man-kpackagetool5.1.docbook:100
#, no-c-format
msgid "<option>-p, --packageroot</option> <replaceable> path</replaceable>"
msgstr ""

#. Tag: para
#: man-kpackagetool5.1.docbook:101
#, no-c-format
msgid ""
"Absolute path to the package root. If not supplied, then the standard data "
"directories for this &plasma; session will be searched instead."
msgstr ""

#. Tag: term
#: man-kpackagetool5.1.docbook:105
#, no-c-format
msgid "<option>--generate-index</option> <replaceable> path</replaceable>"
msgstr ""

#. Tag: para
#: man-kpackagetool5.1.docbook:106
#, no-c-format
msgid ""
"Recreate the plugin index. To be used in conjunction with either the option "
"<option>-t</option> or <option>-g</option>. Recreates the index for the "
"given type or package root. Operates in the user directory, unless <option>-"
"g</option> is used"
msgstr ""

#. Tag: title
#: man-kpackagetool5.1.docbook:117
#, no-c-format
msgid "See Also"
msgstr ""

#. Tag: para
#: man-kpackagetool5.1.docbook:119
#, no-c-format
msgid ""
"More detailed user documentation is available from <ulink url=\"help:/plasma-"
"desktop\">help:/plasma-desktop</ulink> (either enter this <acronym>URL</"
"acronym> into &konqueror;, or run <userinput><command>khelpcenter</command> "
"<parameter>help:/plasma-desktop</parameter></userinput>)."
msgstr ""

