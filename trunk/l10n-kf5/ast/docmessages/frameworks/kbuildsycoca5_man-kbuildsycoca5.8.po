#. Tag: refpurpose
#: man-kbuildsycoca5.8.docbook:40
#, no-c-format
msgid "Rebuilds the KService desktop file system configuration cache."
msgstr ""

#. Tag: title
#: man-kbuildsycoca5.8.docbook:44
#, no-c-format
msgid "Synopsis"
msgstr ""

#. Tag: cmdsynopsis
#: man-kbuildsycoca5.8.docbook:46
#, no-c-format
msgid ""
"<command>kbuildsycoca5</command> <group choice=\"opt\" rep=\"repeat"
"\"><replaceable class=\"option\">OPTIONS</replaceable></group>"
msgstr ""

#. Tag: title
#: man-kbuildsycoca5.8.docbook:56
#, no-c-format
msgid "Description"
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:58
#, no-c-format
msgid ""
"<command>kbuildsycoca5</command> builds binary cache of the data stored in "
"<literal role=\"extension\">.desktop</literal> and MIME type <literal role="
"\"extension\">.xml</literal> files that the KService framework uses to find "
"plugins, applications and other services."
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:65
#, no-c-format
msgid ""
"The KService library uses this database to efficiently provide the "
"information requested of it."
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:70
#, no-c-format
msgid ""
"Users do not normally need to run this application directly; KService will "
"run it if necessary, and if KDED is installed and running it will run "
"<command>kbuildsyscoca5</command> whenever any of the files whose data is "
"cached are changed."
msgstr ""

#. Tag: title
#: man-kbuildsycoca5.8.docbook:81
#, no-c-format
msgid "Options"
msgstr ""

#. Tag: option
#: man-kbuildsycoca5.8.docbook:85
#, no-c-format
msgid "--checkstamps"
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:87
#, no-c-format
msgid ""
"Checks the file timestamps of the cache and the resource directories "
"containing the data to be cached, and only updates the database if any of "
"the resource directories have been modified more recently than the cache. "
"Ignored if <option>--nocheckfiles</option> or <option>--noincremental</"
"option> is set."
msgstr ""

#. Tag: option
#: man-kbuildsycoca5.8.docbook:92
#, no-c-format
msgid "--global"
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:94
#, no-c-format
msgid ""
"Ignores any user-set files (in <varname>XDG_DATA_HOME</varname>). This is "
"currently only supported on Unix systems."
msgstr ""

#. Tag: option
#: man-kbuildsycoca5.8.docbook:99
#, no-c-format
msgid "--nocheckfiles"
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:101
#, no-c-format
msgid ""
"Does not rebuild the cache unless something other than a change in the "
"resource files requires it (such as the format of the cache changing, or "
"<varname>XDG_DATA_DIRS</varname> being changed on a Unix system). Ignored if "
"<option>--global</option> is set."
msgstr ""

#. Tag: option
#: man-kbuildsycoca5.8.docbook:106
#, no-c-format
msgid "--noincremental"
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:108
#, no-c-format
msgid ""
"Rather than using the existing cache and only updating the information that "
"has changed or been added, start with an empty cache. Ignored if <option>--"
"global</option> is set."
msgstr ""

#. Tag: option
#: man-kbuildsycoca5.8.docbook:113
#, no-c-format
msgid "--nosignal"
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:115
#, no-c-format
msgid ""
"Ordinarily, <command>kbuildsyscoca5</command> sends a signal over D-Bus once "
"the cache is updated to all the applications that use KService so that they "
"are always working with the latest information. This option suppresses that "
"behaviour."
msgstr ""

#. Tag: option
#: man-kbuildsycoca5.8.docbook:120
#, no-c-format
msgid "--menutest"
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:122
#, no-c-format
msgid ""
"Test the generation of the application menu database. Does not actually "
"build the cache."
msgstr ""

#. Tag: option
#: man-kbuildsycoca5.8.docbook:127
#, no-c-format
msgid "--testmode"
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:129
#, no-c-format
msgid ""
"Use the QStandardPaths \"test mode\" to avoid interfering with user data. "
"This is intended for use with unit tests."
msgstr ""

#. Tag: option
#: man-kbuildsycoca5.8.docbook:134
#, no-c-format
msgid "--track <replaceable>menu-id</replaceable>"
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:136
#, no-c-format
msgid "Track a menu ID for debugging."
msgstr ""

#. Tag: option
#: man-kbuildsycoca5.8.docbook:141
#, no-c-format
msgid "--author"
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:143
#, no-c-format
msgid "Show author information."
msgstr ""

#. Tag: option
#: man-kbuildsycoca5.8.docbook:150
#, no-c-format
msgid "--license"
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:152
#, no-c-format
msgid "Show license information."
msgstr ""

#. Tag: option
#: man-kbuildsycoca5.8.docbook:159
#, no-c-format
msgid "-h, --help"
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:161
#, no-c-format
msgid "Show a brief help text."
msgstr ""

#. Tag: option
#: man-kbuildsycoca5.8.docbook:168
#, no-c-format
msgid "-v , --version"
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:170
#, no-c-format
msgid "Show version information."
msgstr ""

#. Tag: title
#: man-kbuildsycoca5.8.docbook:182
#, no-c-format
msgid "Files"
msgstr ""

#. Tag: filename
#: man-kbuildsycoca5.8.docbook:185
#, no-c-format
msgid "<varname>cachedir</varname>/ksycoca5"
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:187
#, no-c-format
msgid ""
"The KService cache generated by <command>kbuildsycoca5</command>. On Unix "
"systems, <varname>cachedir</varname> is typically <filename class=\"directory"
"\"><envar>XDG_CONFIG_HOME</envar></filename>"
msgstr ""

#. Tag: filename
#: man-kbuildsycoca5.8.docbook:192
#, no-c-format
msgid "<varname>cachedir</varname>/ksycoca5stamp"
msgstr ""

#. Tag: para
#: man-kbuildsycoca5.8.docbook:194
#, no-c-format
msgid ""
"The timestamp and other meta-information about the main cache file. On Unix "
"systems, <varname>cachedir</varname> is typically <filename class=\"directory"
"\"><envar>XDG_CONFIG_HOME</envar></filename>"
msgstr ""

