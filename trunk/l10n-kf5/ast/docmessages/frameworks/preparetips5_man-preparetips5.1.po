msgid "Description"
msgstr ""

#. Tag: para
#: man-preparetips5.1.docbook:48
#, no-c-format
msgid ""
"<command>preparetips5</command> is a script to extract the text from a tips "
"file. It outputs the text so <command>xgettext</command> can add the tips to "
"a PO file. PO files provide a human-readable string format used for "
"translations."
msgstr ""

#. Tag: para
#: man-preparetips5.1.docbook:52
#, no-c-format
msgid ""
"<command>preparetips5</command> looks for <emphasis role=\"underline\">data/"
"tips</emphasis> as tips file."
msgstr ""

