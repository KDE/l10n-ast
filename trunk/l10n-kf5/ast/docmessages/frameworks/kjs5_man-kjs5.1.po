#. Tag: title
#: man-kjs5.1.docbook:108
#, no-c-format
msgid "Usage"
msgstr ""

#. Tag: para
#: man-kjs5.1.docbook:109
#, no-c-format
msgid ""
"<command>kjs5</command> <parameter>file</parameter>, as many other "
"interpreters, when called without parameters uses a line editor to enter "
"statements, showing the prompt <literallayout>JS></literallayout> To exit "
"the line editor type <command>quit()</command> or press <command>Ctrl+D</"
"command>."
msgstr ""

