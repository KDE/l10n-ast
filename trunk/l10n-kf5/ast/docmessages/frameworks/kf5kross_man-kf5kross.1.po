msgid "Synopsis"
msgstr ""

#. Tag: cmdsynopsis
#: man-kf5kross.1.docbook:36
#, no-c-format
msgid ""
"<command>kf5kross</command> <arg choice=\"opt\">--help</arg> <arg choice="
"\"opt\">Generic-options</arg> <arg choice=\"opt\">Qt-options</arg> <arg "
"choice=\"opt\">KDE-options</arg> <arg choice=\"opt\">file ...</arg>"
msgstr ""

#. Tag: title
#: man-kf5kross.1.docbook:48
#, no-c-format
msgid "Description"
msgstr ""

#. Tag: para
#: man-kf5kross.1.docbook:50
#, no-c-format
msgid ""
"<command>kf5kross</command> executes kross scripts written in &kde; "
"Javascript, Python, Ruby, Java and Falcon."
msgstr ""

#. Tag: para
#: man-kf5kross.1.docbook:52
#, no-c-format
msgid ""
"This command line tool is used for any non-GUI scripts, e.g. Calligra Sheets "
"has some of these."
msgstr ""

