#. Tag: title
#: man-kf5kross.1.docbook:132
#, no-c-format
msgid "Usage"
msgstr ""

#. Tag: para
#: man-kf5kross.1.docbook:133
#, no-c-format
msgid ""
"<command>kf5kross</command> <parameter>file</parameter> runs the script in "
"<parameter>file</parameter> after loading the interpreter plugin for the "
"script language (detected by filename suffix)."
msgstr ""

#. Tag: para
#: man-kf5kross.1.docbook:137
#, no-c-format
msgid ""
"To interpret other languages than &kde; Javascript, "
"<replaceable>kdebindings</replaceable> must be installed."
msgstr ""

