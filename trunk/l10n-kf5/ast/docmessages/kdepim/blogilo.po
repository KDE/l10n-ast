#, no-c-format
msgid "<action>Quit</action> &blogilo;"
msgstr ""

#. Tag: menuchoice
#: index.docbook:281
#, no-c-format
msgid "<guimenu>Blog</guimenu> <guimenuitem>Add Blog...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:285
#, no-c-format
msgid "A quick way to add a new blog."
msgstr ""

#. Tag: menuchoice
#: index.docbook:289
#, no-c-format
msgid "<guimenu>Blog</guimenu> <guimenuitem>Upload Media...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:293
#, no-c-format
msgid ""
"Open Media uploader, to upload files such as images to blog or &FTP; server."
msgstr ""

#. Tag: para
#: index.docbook:295
#, no-c-format
msgid ""
"Only MetaWeblog and MovableType and Wordpress APIs support media uploading "
"function."
msgstr ""

#. Tag: menuchoice
#: index.docbook:301
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> </"
"shortcut> <guimenu>Post</guimenu> <guimenuitem>New Post</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:308
#, no-c-format
msgid "Create a new and empty post."
msgstr ""

#. Tag: menuchoice
#: index.docbook:312
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo> </"
"shortcut> <guimenu>Post</guimenu> <guimenuitem>Save Locally</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:319
#, no-c-format
msgid "Save current post locally."
msgstr ""

#. Tag: menuchoice
#: index.docbook:323
#, no-c-format
msgid "<guimenu>Post</guimenu> <guimenuitem>Submit...</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:327
#, no-c-format
msgid ""
"Open the Submit post dialog, to submit the current active post to the "
"current blog."
msgstr ""

#. Tag: para
#: index.docbook:329
#, no-c-format
msgid ""
"In submit post, you can select if this post should submit as a draft or not. "
"And additionally, whether as an edit of the current post, or as a new post."
msgstr ""

#. Tag: menuchoice
#: index.docbook:336
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>T</keycap></keycombo> </"
"shortcut> <guimenu>Settings</guimenu> <guimenuitem>Show Toolbox</guimenuitem>"
msgstr ""

#. Tag: para
#: index.docbook:343
#, no-c-format
msgid "<action>Toggle</action> displaying the toolbox."
msgstr ""

#. Tag: para
#: index.docbook:348
#, no-c-format
msgid ""
"Additionally &blogilo; has the common &kde; <guimenu>Settings</guimenu> and "
"<guimenu>Help</guimenu> menu items, for more information read the sections "
"about the <ulink url=\"help:/fundamentals/ui.html#menus-settings\">Settings "
"Menu</ulink> and <ulink url=\"help:/fundamentals/ui.html#menus-help\">Help "
"Menu</ulink> of the &kde; Fundamentals."
msgstr ""

