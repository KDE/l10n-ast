#: index.docbook:1294
#, no-c-format
msgid "Print difference against repository, &ie; local changes"
msgstr ""

#. Tag: programlisting
#: index.docbook:1295
#, no-c-format
msgid "kdesvn exec diff myfile.c"
msgstr ""

#. Tag: title
#: index.docbook:1298
#, no-c-format
