#: index.docbook:3444
#, no-c-format
msgid "The File Menu"
msgstr ""

#. Tag: menuchoice
#: index.docbook:3449
#, no-c-format
msgid "<guimenu>File</guimenu> <guisubmenu>Profiles</guisubmenu>"
msgstr ""

#. Tag: para
#: index.docbook:3455
#, no-c-format
msgid ""
"Select the profile to use. This menu entry is disabled if the user did not "
"enabled the use of profiles."
msgstr ""

#. Tag: para
