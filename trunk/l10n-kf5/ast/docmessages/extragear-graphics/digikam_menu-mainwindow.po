#: menu-mainwindow.docbook:263
#, no-c-format
msgid "<guimenu>Item</guimenu><guimenuitem>Flip</guimenuitem>"
msgstr ""

#. Tag: action
#: menu-mainwindow.docbook:267
#, no-c-format
msgid ""
