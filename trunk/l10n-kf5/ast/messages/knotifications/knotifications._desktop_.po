#: src/android_defaults.notifyrc:2
msgctxt "Name"
msgid "Fatal Error"
msgstr "Fallu fatal"

#: src/android_defaults.notifyrc:56
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Hebo un fallu grave que causó la salida del programa"

#: src/android_defaults.notifyrc:113
msgctxt "Name"
msgid "Notification"
msgstr "Avisu"

#: src/android_defaults.notifyrc:167
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Asocedió daqué especial nel programa"

#: src/android_defaults.notifyrc:223
msgctxt "Name"
msgid "Warning"
msgstr "Alvertencia"

#: src/android_defaults.notifyrc:277
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Hebo un fallu nel programa que pue causar problemes"

#: src/android_defaults.notifyrc:333
msgctxt "Name"
msgid "Catastrophe"
msgstr "Catástrofe"

#: src/android_defaults.notifyrc:386
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr ""
"Asocedió un fallu pergrave que causó, polo menos, la salida del programa"
