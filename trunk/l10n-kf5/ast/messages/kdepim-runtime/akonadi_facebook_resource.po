msgctxt ""
"This string is appended at the end of Facebook notifications displayed in "
"the system notifications, indicating there are more notifications, which are "
"not displayed."
msgid "...and 1 more"
msgid_plural "...and %1 more"
msgstr[0] ""
msgstr[1] ""

