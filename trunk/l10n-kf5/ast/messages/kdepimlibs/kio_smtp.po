#: command.cpp:149
msgid ""
"The server rejected both EHLO and HELO commands as unknown or "
"unimplemented.\n"
"Please contact the server's system administrator."
msgstr ""
"El sirvidor refugó los comandos EHLO y HELO como desconocíoso ensin "
"implementar.\n"
"Por favor, contauta col alministrador de sistemes del sirvidor."

#: command.cpp:163
#, kde-format
msgid ""
"Unexpected server response to %1 command.\n"
"%2"
msgstr ""
"Rempuesta del sirvidor non esperada del comandu %1\n"
"%2"

#: command.cpp:187
msgid ""
"Your SMTP server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr ""
"El to sirvidor SMTP nun sofita TLS. Deshabilita TLS si quies coneutate ensin "
"cifráu."

#: command.cpp:198
msgid ""
"Your SMTP server claims to support TLS, but negotiation was unsuccessful.\n"
"You can disable TLS in the SMTP account settings dialog."
msgstr ""
"El to sirvidor diz sofitar TLS, pero la negociación nun tuvo ésitu.\n"
"Pues deshabilitar TLS nel diálogu d'axustes de la cuenta SMTP."

#: command.cpp:202
msgid "Connection Failed"
msgstr "Conexón fallida"

#: command.cpp:208
#, kde-format
msgid "An error occurred during authentication: %1"
msgstr "Asocedió un fallu na autenticación: %1"

#: command.cpp:279
msgid "No authentication details supplied."
msgstr "Nun s'apurrieron los detalles de la autenticación."

#: command.cpp:387
msgid "Choose a different authentication method."
msgstr "Escueyi un métodu s'autenticación diferente."

#: command.cpp:389
#, kde-format
msgid "Your SMTP server does not support %1."
msgstr "El to sirvidor SMTP nun sofita %1."

#: command.cpp:390
msgid "Your SMTP server does not support (unspecified method)."
msgstr "El to sirvidor SMTP nun sofita (métodu non especificáu)."

#: command.cpp:394
#, kde-format
msgid ""
"Your SMTP server does not support authentication.\n"
"%1"
msgstr ""
"El to sirvidor SMTP nun sofita l'autenticación.\n"
"%1"

#: command.cpp:399
#, kde-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"%1"
msgstr ""
"Autenticación fallida.\n"
"Quiciabes la contraseña tea mal.\n"
"%1"

#: command.cpp:556
msgid "Could not read data from application."
msgstr "Nun pudieron lleese los datos de l'autenticación."

#: command.cpp:574
#, kde-format
msgid ""
"The message content was not accepted.\n"
"%1"
msgstr ""
"Refugóse'l conteníu del mensaxe.\n"
"%1"

#: response.cpp:112
#, kde-format
msgid ""
"The server responded:\n"
"%1"
msgstr ""
"El sirvidor respondió:\n"
"%1"

#: response.cpp:114
#, kde-format
msgid "The server responded: \"%1\""
msgstr "El sirvidor respondió: \"%1\""

#: response.cpp:117
msgid "This is a temporary failure. You may try again later."
msgstr "Esto ye un fallu temporal. Podríes intentalo de nueves sero."

#: smtp.cpp:148
msgid "The application sent an invalid request."
msgstr "L'aplicación unvió una solicitú non válida."

#: smtp.cpp:208
msgid "The sender address is missing."
msgstr "Falta la direición del emisor."

#: smtp.cpp:215
#, kde-format
msgid "SMTPProtocol::smtp_open failed (%1)"
msgstr "SMTPProtocol::smtp_open falló (%1)"

#: smtp.cpp:223
#, kde-format
msgid ""
"Your server (%1) does not support sending of 8-bit messages.\n"
"Please use base64 or quoted-printable encoding."
msgstr ""
"El to sirvidor (%1) nun sofita l'unviu de mensaxes de 8 bits.\n"
"Por favor, usa la codificación en base64 o quoted-printable."

#: smtp.cpp:273
msgid "Writing to socket failed."
msgstr "Escritura al socket fallida."

#: smtp.cpp:313
#, kde-format
msgid "Invalid SMTP response (%1) received."
msgstr "Recibióse la rempuesta SMTP non válida (%1)."

#: smtp.cpp:542
#, kde-format
msgid ""
"The server (%1) did not accept the connection.\n"
"%2"
msgstr ""
"El sirvidor (%1) refugó la conexón.\n"
"%2"

#: smtp.cpp:608
msgid "Username and password for your SMTP account:"
msgstr "El nome d'usuariu y contraseña pa la to cuenta SMTP:"

#: transactionstate.cpp:51
#, kde-format
msgid ""
"The server did not accept a blank sender address.\n"
"%1"
msgstr ""
"El sirvidor refugó un direición d'emisor balera.\n"
"%1"

#: transactionstate.cpp:54
#, kde-format
msgid ""
"The server did not accept the sender address \"%1\".\n"
"%2"
msgstr ""
"El sirvidor refugó la direición del emisor \"%1\".\n"
"%2"

#: transactionstate.cpp:112
#, kde-format
msgid ""
"Message sending failed since the following recipients were rejected by the "
"server:\n"
"%1"
msgstr ""
"Falló l'unviu del mensaxe darréu que los destinatarios siguientes refugólos "
"el sirvidor:\n"
"%1"

#: transactionstate.cpp:117
#, kde-format
msgid ""
"The attempt to start sending the message content failed.\n"
"%1"
msgstr ""
"L'intentu d'aniciar l'unviu del conteníu del mensaxe falló.\n"
"%1"

#: transactionstate.cpp:122
msgid "Unhandled error condition. Please send a bug report."
msgstr ""
"Condición de fallu que nun pue remanase. Por favor, unvia un informe de "
"fallu."
