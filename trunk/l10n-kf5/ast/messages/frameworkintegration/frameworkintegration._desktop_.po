#: plasma_workspace.notifyrc:3
msgctxt "Comment"
msgid "Plasma Workspace"
msgstr "Estaya de trabayu de Plasma"

#: plasma_workspace.notifyrc:54
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "Papelera balerada"

#: plasma_workspace.notifyrc:103
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "La papelera baleróse"

#: plasma_workspace.notifyrc:156
msgctxt "Name"
msgid "Textcompletion: Rotation"
msgstr ""

#: plasma_workspace.notifyrc:203
msgctxt "Comment"
msgid "The end of the list of matches has been reached"
msgstr "Algamóse la fin de la llista de coincidencies"

#: plasma_workspace.notifyrc:255
msgctxt "Name"
msgid "Textcompletion: No Match"
msgstr "Completáu de testu: Ensin coincidencies"

#: plasma_workspace.notifyrc:303
msgctxt "Comment"
msgid "No matching completion was found"
msgstr "Nun s'alcontró nenguna coincidencia que concasare"

#: plasma_workspace.notifyrc:355
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "Completáu de testu: Coincidencia parcial"

#: plasma_workspace.notifyrc:403
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Hai más d'una coincidencia posible"

#: plasma_workspace.notifyrc:455
msgctxt "Name"
msgid "Fatal Error"
msgstr "Fallu fatal"

#: plasma_workspace.notifyrc:503
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Hebo un fallu grave que fizo que'l programa colare"

#: plasma_workspace.notifyrc:556
msgctxt "Name"
msgid "Notification"
msgstr "Avisu"

#: plasma_workspace.notifyrc:605
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Asocedió daqué especial nel programa"

#: plasma_workspace.notifyrc:657
msgctxt "Name"
msgid "Warning"
msgstr "Alvertencia"

#: plasma_workspace.notifyrc:706
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Hebo un fallu nel programa que podría causar problemes"

#: plasma_workspace.notifyrc:758
msgctxt "Name"
msgid "Catastrophe"
msgstr "Catástrofe"

#: plasma_workspace.notifyrc:806
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr ""
"Asocedió un fallu pergrave que causó que, polo menos, el programa colara"

#: plasma_workspace.notifyrc:858
msgctxt "Name"
msgid "Application Crash"
msgstr "Casque d'aplicación"

#: plasma_workspace.notifyrc:903
msgctxt "Comment"
msgid "An application just closed unexpectedly"
msgstr "Una aplicación ta acabante de zarrase inesperadamente"

#: plasma_workspace.notifyrc:951
msgctxt "Name"
msgid "Login"
msgstr "Aniciu de sesión"

#: plasma_workspace.notifyrc:1000
msgctxt "Comment"
msgid "A new session is starting"
msgstr "Ta aniciándose una sesión nueva"

#: plasma_workspace.notifyrc:1052
msgctxt "Name"
msgid "Logout"
msgstr "Zarru de sesión"

#: plasma_workspace.notifyrc:1101
msgctxt "Comment"
msgid "Session is exiting"
msgstr "La sesión ta colando"

#: plasma_workspace.notifyrc:1154
msgctxt "Name"
msgid "Logout Canceled"
msgstr "Zarru de sesión encaboxáu"

#: plasma_workspace.notifyrc:1203
msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "Encaboxóse'l zarru de sesión de Plasma"

#: plasma_workspace.notifyrc:1255
msgctxt "Name"
msgid "Print Error"
msgstr "Fallu d'imprentación"

#: plasma_workspace.notifyrc:1304
msgctxt "Comment"
msgid "A print error has occurred"
msgstr "Asocedió un fallu d'imprentación"

#: plasma_workspace.notifyrc:1356
msgctxt "Name"
msgid "Information Message"
msgstr "Mensaxe d'información"

#: plasma_workspace.notifyrc:1405
msgctxt "Comment"
msgid "An information message is being shown"
msgstr "Ta amosándose un mensaxe d'información"

#: plasma_workspace.notifyrc:1457
msgctxt "Name"
msgid "Warning Message"
msgstr "Mensaxe d'alvertencia"

#: plasma_workspace.notifyrc:1506
msgctxt "Comment"
msgid "A warning message is being shown"
msgstr "Ta amosándose un mensaxe d'alvertencia"

#: plasma_workspace.notifyrc:1558
msgctxt "Name"
msgid "Critical Message"
msgstr "Mensaxe críticu"

#: plasma_workspace.notifyrc:1607
msgctxt "Comment"
msgid "A critical message is being shown"
msgstr "Ta amosándose un mensaxe críticu"

#: plasma_workspace.notifyrc:1659
msgctxt "Name"
msgid "Question"
msgstr "Entruga"

#: plasma_workspace.notifyrc:1708
msgctxt "Comment"
msgid "A question is being asked"
msgstr "Ta entrugándose daqué"

#: plasma_workspace.notifyrc:1761
msgctxt "Name"
msgid "Beep"
msgstr "Pip"

#: plasma_workspace.notifyrc:1810
msgctxt "Comment"
msgid "Sound bell"
msgstr "Un pitíu"

#: plasma_workspace.notifyrc:1862
msgctxt "Name"
msgid "Widget failed to install"
msgstr "Falló la instalación"

#: plasma_workspace.notifyrc:1907
msgctxt "Comment"
msgid "A widget could not be installed"
msgstr "Un widget nun pudo instalase"

#: plasma_workspace.notifyrc:1955
msgctxt "Name"
msgid "Widget deleted"
msgstr "Widget desaniciáu"

#: plasma_workspace.notifyrc:2001
msgctxt "Comment"
msgid "A widget has been deleted"
msgstr "Desanicióse un widget"
