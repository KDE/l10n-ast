msgid ""
"Resuming videos: Starts playing a video where you were watching it last time"
msgstr ""
"Resume de videos: Anicia la reproducción d'un videu u lu dexesti la cabera "
"vegada"

#. (itstool) path: ul/li
#: org.kde.dragonplayer.appdata.xml:18
msgid ""
"Support for subtitles: Automatically loads subtitles with the matching name"
msgstr ""
"Sofitu pa sotítulos: Carga automáticamente sotítulos que concasen col nome"

#. (itstool) path: ul/li
