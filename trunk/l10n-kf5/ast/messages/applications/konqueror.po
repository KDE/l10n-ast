#: about/konq_aboutpage.cpp:304
#, fuzzy, kde-format
#| msgid ""
#| "Use Internet-Keywords and Web-Shortcuts: by typing \"gg: KDE\" one can "
#| "search the Internet, using Google, for the search phrase \"KDE\". There "
