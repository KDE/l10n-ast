msgid "Password dialog"
msgstr "Diálogu de contraseña"

#: greeter/themes/org.kde.passworddialog/metadata.desktop:40
msgctxt "Comment"
msgid ""
"Screen locker that provides a password dialog and an interface to switch the "
"current user"
msgstr ""
"EL bloquiador de pantalla apurre un diálogu de contraseña y una interfaz pa "
"camudar l'usuariu actual"

