#: package/contents/config/config.qml:25
msgid "General"
msgstr "Xeneral"

#: package/contents/ui/configGeneral.qml:44
msgid "Removable devices only"
msgstr "Namái preseos estrayibles"

#: package/contents/ui/configGeneral.qml:49
msgid "Non-removable devices only"
msgstr "Namái preseos non estrayibles"

#: package/contents/ui/configGeneral.qml:54
msgid "All devices"
msgstr "Tolos preseos"

#: package/contents/ui/DeviceItem.qml:134
#, kde-format
msgctxt "@info:status Free disk space"
msgid "%1 free"
msgstr "%1 llibre"

#: package/contents/ui/DeviceItem.qml:162
msgctxt ""
"Accessing is a less technical word for Mounting; translation should be short "
"and mean 'Currently mounting this device'"
msgid "Accessing..."
msgstr "Accediendo..."

#: package/contents/ui/DeviceItem.qml:162
msgctxt ""
"Removing is a less technical word for Unmounting; translation shoud be short "
"and mean 'Currently unmounting this device'"
msgid "Removing..."
msgstr "Estrayendo..."

#: package/contents/ui/DeviceItem.qml:176
#, kde-format
#| msgid "1 action for this device"
#| msgid_plural "%1 actions for this device"
msgid "1 action for this device"
msgid_plural "%1 actions for this device"
msgstr[0] "Una aición pa esti preséu"
msgstr[1] "%1 aiciones pa esti preséu"

#: package/contents/ui/DeviceItem.qml:209
#| msgid "1 action for this device"
#| msgid_plural "%1 actions for this device"
msgid "Click to mount this device."
msgstr "Primi pa montar esti preséu."

#: package/contents/ui/DeviceItem.qml:211
#| msgid "1 action for this device"
#| msgid_plural "%1 actions for this device"
msgid "Click to eject this disc."
msgstr "Primi pa espulsar esti discu."

#: package/contents/ui/DeviceItem.qml:213
#| msgid "1 action for this device"
#| msgid_plural "%1 actions for this device"
msgid "Click to safely remove this device."
msgstr "Primi pa estrayer con seguridá esti rpeséu."

#: package/contents/ui/DeviceItem.qml:215
msgid "Click to access this device from other applications."
msgstr "Primi p'acceder a esti preséu dende otres aplicaciones."

#: package/contents/ui/DeviceItem.qml:234
#, fuzzy
msgid ""
"It is currently <b>not safe</b> to remove this device: applications may be "
"accessing it. Click the eject button to safely remove this device."
msgstr ""
"Anguaño <b>nun ye seguro</b> estrayer esti preséu: les aplicaciones "
"podríen tar accediendo a elli. Primi'l botón d'estraición pa estrayer con "
"seguridá esti preséu."

#: package/contents/ui/DeviceItem.qml:236
msgid "This device is currently accessible."
msgstr "Anguaño esti preséu ye accesible."

#: package/contents/ui/DeviceItem.qml:241
msgid ""
"It is currently <b>not safe</b> to remove this device: applications may be "
"accessing other volumes on this device. Click the eject button on these "
"other volumes to safely remove this device."
msgstr ""
"Anguaño <b>nun ye seguro</b> estrayer esti preséu: les aplicaciones "
"podríen tar accediendo a otros volúmenes nesti preséu. Primi'l botón "
"d'estraición nesos otros volúmenes pa estrayer con seguridá esti preséu."

#: package/contents/ui/DeviceItem.qml:243
#| msgid "1 action for this device"
#| msgid_plural "%1 actions for this device"
msgid "It is currently safe to remove this device."
msgstr "Anguaño ye seguro desaniciar esti preséu."

#: package/contents/ui/DeviceItem.qml:246
msgid "This device is not currently accessible."
msgstr "Anguaño esti preséu nun ye accesible."

