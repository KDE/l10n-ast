#: downloadjob.cpp:191
#, kde-format
msgid "Access denied."
msgstr "Ñegóse l'accesu."

#: downloadjob.cpp:192
#, kde-format
msgid "Insufficient free space."
msgstr "Nun hai espaciu abondu."

#: downloadjob.cpp:193
#, kde-format
msgid "The file name you have chosen is too long."
msgstr "El nome qu'escoyesti ye perllargu."

#: downloadjob.cpp:194
#, kde-format
msgid "The file is too large to be downloaded."
msgstr "El ficheru ye mui llargu como pa baxalu."

#: downloadjob.cpp:196
#, kde-format
msgid "The file possibly contains malicious contents."
msgstr "El ficheru quiciabes contenga conteníu maliciosu."

#: downloadjob.cpp:197
#, kde-format
msgid "A temporary error has occurred. Please try again later."
msgstr "Asocedió un fallu temporal. Volvi tentalo más sero."

#: downloadjob.cpp:199
#, kde-format
msgid "A network error has occurred."
msgstr "Asocedió un fallu de rede."

#: downloadjob.cpp:200
#, kde-format
msgid "The network operation timed out."
msgstr "Escosó'l tiempu d'espera de la rede."

#: downloadjob.cpp:201
#, kde-format
msgid "The network connection has been lost."
msgstr ""

#: downloadjob.cpp:202
#, kde-format
msgid "The server is no longer reachable."
msgstr "El sirvidor yá nun ye algamable."

#: downloadjob.cpp:204
#, kde-format
msgid "A server error has occurred."
msgstr "Asocedió un fallu del sirvidor."

#: downloadjob.cpp:208
#, kde-format
msgid "The server does not have the requested data."
msgstr "El sirvidor nun tien los datos solicitaos."

#: downloadjob.cpp:210
#, kde-format
msgid "The browser application closed unexpectedly."
msgstr "El restolador zarróse inesperadamente."

#: downloadjob.cpp:217
#, kde-format
msgid "An unknown error occurred while downloading."
msgstr "Asocedió un fallu mentanto se baxaba."

#: downloadjob.cpp:251
#, kde-format
msgctxt "Job heading, like 'Copying'"
msgid "Downloading"
msgstr "Baxando"

#: downloadjob.cpp:252
#, kde-format
msgctxt "The URL being downloaded"
msgid "Source"
msgstr "Orixe"

#: downloadjob.cpp:253
#, kde-format
msgctxt "The location being downloaded to"
msgid "Destination"
msgstr "Destín"
