#: Module.cpp:65
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Kubuntu can collect anonymous information that helps developers improve it. "
"All information collected is covered by our <link url='%1'>privacy policy</"
"link>."
msgstr ""
"Kubuntu pue recoyer información anónima qu'ayuda a los desendolcadores a "
"ayudalu. Tola información recoyida ta na nuesa <link url='%1'>política de "
"privacidá</link>."

#: Module.cpp:123
#, kde-kuit-format
msgctxt "@info"
msgid "<link url='%1'>Previous Reports</link>"
msgstr "<link url='%1'>Informes previos</link>"

#. i18n: ectx: property (text), widget (QCheckBox, crashesCheckBox)
#: Module.ui:27
#, kde-format
msgid "Send error reports to Canonical"
msgstr "Unviar informes de fallu a Canonical"

#. i18n: ectx: property (text), widget (QLabel, crashesDescriptionLabel)
#: Module.ui:57
#, kde-format
msgid ""
"Error reports include information about what a program was doing when it "
"failed. You always have the choice to send or cancel an error report."
msgstr ""
"Los informes de fallu inclúin información tocante a lo que taba faciendo un "
"programa cuando falló. Siempres tienes la escoyeta d'unviar o encaboxar "
"l'informe de fallu."

#. i18n: ectx: property (text), widget (QCheckBox, autoCheckBox)
#: Module.ui:67
#, kde-format
msgid "Send a report automatically if a problem prevents login"
msgstr ""
"Unviar automáticamente informes si un problema evita l'aniciu de sesión"

#. i18n: ectx: property (text), widget (QCheckBox, metricsCheckBox)
#: Module.ui:78
#, kde-format
msgid "Send occasional system information to Canonical"
msgstr "Unviar alcuando información del sistema a Canonical"

#. i18n: ectx: property (text), widget (QLabel, metricsDescriptionLabel)
#: Module.ui:106
#, kde-format
msgid ""
"This includes things like how many programs are running, how much disk space "
"the computer has, and what devices are connected."
msgstr ""
"Esto inclúi coses como cuantos programes tán n'execución, cuando espaciu en "
"discu tien l'ordenador y que preseos tán coneutaos."
