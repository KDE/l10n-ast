#: main.cpp:39
msgid "kwinstartmenu"
msgstr "kwinstartmenu"

#: main.cpp:40
msgid "An application to create/update or remove Windows Start Menu entries"
msgstr ""
"Una aplicación pa crear/anovar o desaniciar entraes del menú d'aniciu de "
"ventanes"

#: main.cpp:42
msgid "(C) 2008-2011 Ralf Habacker"
msgstr "(C) 2008-2010 Ralf Habacker"

#: main.cpp:46
#| msgid "Remove installed Start Menu entries"
msgid "remove installed start menu entries"
msgstr "Desaniciar entraes instalaes del menú d'entamu"

#: main.cpp:47
#| msgid "Remove installed Start Menu entries"
msgid "install start menu entries"
msgstr "Desaniciar entraes instalaes del menú d'entamu"

#: main.cpp:48
#| msgid "query root path of Start Menu entries"
msgid "update start menu entries"
msgstr "anovar entraes de menú d'aniciu"

#: main.cpp:49
msgid "remove start menu entries from unused kde installation"
msgstr "desaniciar entraes del menú d'aniciu d'una instalación KDE ensin usar"

#: main.cpp:51
#| msgid "query root path of Start Menu entries"
msgid "query root path of start menu entries"
msgstr "pidir camín raigañu de les entraes del menú d'aniciu"

#: main.cpp:53
#| msgid "don't use categories for start menu entries"
msgid "use categories for start menu entries (default)"
msgstr "usar estayes pa les entraes del menú d'aniciu (por defeutu)"

#: main.cpp:54
msgid "don't use categories for start menu entries"
msgstr "nun usar estayes pa les entraes del menú d'aniciu"

#: main.cpp:55
#| msgid "don't use categories for start menu entries"
msgid "query current value of categories in start menu"
msgstr "pidir el valor actual de les estayes nel menú d'aniciu"

#: main.cpp:57
#| msgid "don't use categories for start menu entries"
msgid "set custom string for root start menu entry"
msgstr "afitar cadena personalizada pa la entrada del menú d'aniciu root"

#: main.cpp:60
#| msgid "don't use categories for start menu entries"
msgid "remove custom string from root start menu entry"
msgstr "desaniciar la cadena personalizada d'una entrada de menú d'aniciu root"

#: main.cpp:61
msgid "query current value of root start menu entry custom string"
msgstr ""
"pidir el valor actual de la cadena personalizada de la entrada del menú "
"d'aniciu root"

#: main.cpp:63
#| msgid "don't use categories for start menu entries"
msgid "set custom name string for root start menu entry"
msgstr ""
"afitar la cadena del nome personalizáu pa la entrada del menú d'aniciu root"

#: main.cpp:64
#| msgid "don't use categories for start menu entries"
msgid "remove custom name string from root start menu entry"
msgstr ""
"desaniciar la cadena del nome personalizáu d'una entrada del menú d'aniciu "
"root"

#: main.cpp:65
#| msgid "don't use categories for start menu entries"
msgid "query current value of start menu entry custom name string"
msgstr ""
"pidir el valor actual d'una cadena de nome personalizáu de la entrada del "
"menú d'anicu"

#: main.cpp:67
#| msgid "don't use categories for start menu entries"
msgid "set custom version string for root start menu entry"
msgstr ""
"afitar la cadena de versión personalizada pa la entrada del menú d'aniciu "
"root"

#: main.cpp:68
#| msgid "don't use categories for start menu entries"
msgid "remove custom version string from root start menu entry"
msgstr ""
"desaniciar cadena de versión personalizada de la entrada de menú d'aniciu "
"root"

#: main.cpp:69
#| msgid "don't use categories for start menu entries"
msgid "query current value of root start menu entry version string"
msgstr ""
"pidir el valor actual de la cadena de versión de la entrada del menú "
"d'aniciu root"

