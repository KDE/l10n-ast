#: klineal.cpp:101
#, kde-format
msgctxt "@title:window"
msgid "KRuler"
msgstr "KRuler"

#: klineal.cpp:105
#, kde-format
msgid ""
"This is a tool to measure pixel distances and colors on the screen. It is "
"useful for working on layouts of dialogs, web pages etc."
msgstr ""
"Esto ye una ferramienta pa midir les distancies ente píxeles y colores na "
"pantalla. Ye útil pa trabayar coles distribuciones de diálogos, páxines web "
"etc."

#: klineal.cpp:132
#, kde-format
msgid "This is the current distance measured in pixels."
msgstr "Esta ye la distancia actual midida en píxeles."

#: klineal.cpp:138
#, kde-format
msgid ""
"This is the current color in hexadecimal rgb representation as you may use "
"it in HTML or as a QColor name. The rectangles background shows the color of "
"the pixel inside the little square at the end of the line cursor."
msgstr ""
"Esta ye la color actual na representación RGB hexadecimal darréu que podríes "
"usala en HTML o como un nome QColor. El fondu de rectángulos amuesa la color "
"del píxel dientro d'un cuadráu pequeñu al final de la llinia del cursor."

