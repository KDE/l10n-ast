msgstr "Editor hexadecimal"

#. (itstool) path: description/p
#: org.kde.okteta.appdata.xml:9
msgid "Okteta is a simple editor for the raw data of files."
msgstr "Okteta ye un editor cenciellu pa ficheros de datos en brutu."

#. (itstool) path: description/p
#: org.kde.okteta.appdata.xml:10
msgid "Features:"
msgstr "Carauterístiques:"

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:12
msgid ""
"Values and characters shown either in two columns (the traditional display "
"in hex editors) or in rows with the value on top of the character"
msgstr ""
"Los valores y caráuteres amuésense dambos en dos columnes (l'amosanza "
"tradicional nos editores hexadecimales) o en fileres col valor enriba'l "
"caráuter"

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:13
msgid "Editing and navigating similar to a text editor"
msgstr "Edición y navegación similiar a un editor de testu"

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:14
msgid "Customizable data views, with loadable and storable profiles"
msgstr ""
"Vistes de datos personalizaos, con perfiles que puen cargase y atrosaxe"

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:15
msgid "Tools dockable on all sides or floating"
msgstr "Ferramientes que puen flotar o anclase en tolos llaos"

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:16
msgid "Numerical encodings: Hexadecimal, Decimal, Octal, Binary"
msgstr "Codificaciones numbériques: Hexadecimal, decimal, octal, binariu"

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:17
msgid "Character encodings: All 8-bit encodings as supplied by Qt, EBCDIC"
msgstr ""
"Codificación de caráuteres: tola codificación en 8-bits apúrrese pente Qt, "
"EBCDIC"

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:18
msgid "Fast data rendering on screen"
msgstr "Renderizáu de datos rápidu na pantalla"

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:19
msgid "Multiple open files"
msgstr "Apertura múltiple de ficheros"

#. (itstool) path: ul/li
#: org.kde.okteta.appdata.xml:20
msgid "Undo/redo support"
msgstr "Sofitu de desfechura/refechura"

#. (itstool) path: ul/li
