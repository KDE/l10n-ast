#. (itstool) path: component/name
#: knotes.appdata.xml:6
msgid "KNotes"
msgstr "KNotes"

#. (itstool) path: description/p
#: knotes.appdata.xml:8
msgid ""
"KNotes is a program that lets you write the computer equivalent of sticky "
"notes. The notes are saved automatically when you exit the program, and they "
"display when you open the program."
msgstr ""
"KNotes ye un programa que te permite escribir al ordenador l'equivalente a "
"notes pegañoses. Les notes guárdense automáticamente al colar del programa y "
"amuésense al abrilu."

#. (itstool) path: description/p
#: knotes.appdata.xml:12
msgid "Features:"
msgstr "Carauterístiques:"

#. (itstool) path: ul/li
#: knotes.appdata.xml:14
msgid "Write notes in your choice of font and background color"
msgstr "Escribi notes na fonte y color de fondu qu'escueyas"

#. (itstool) path: ul/li
#: knotes.appdata.xml:15
msgid "Use drag and drop to email your notes"
msgstr "Arrastra y suelta les tos notes pa unviales per corréu"

#. (itstool) path: ul/li
#: knotes.appdata.xml:16
msgid "Can be dragged into Calendar to book a time-slot"
msgstr ""

#. (itstool) path: ul/li
#: knotes.appdata.xml:17
msgid "Notes can be printed"
msgstr "Les notes puen imprentase"
