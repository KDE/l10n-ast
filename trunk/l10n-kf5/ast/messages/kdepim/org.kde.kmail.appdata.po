#. (itstool) path: component/name
#: org.kde.kmail.appdata.xml:6
msgid "KMail"
msgstr "KMail"

#. (itstool) path: description/p
#: org.kde.kmail.appdata.xml:8
msgid ""
"KMail is the email component of Kontact, the integrated personal information "
"manager from KDE."
msgstr ""
"KMail ye'l componente de corréu de Kontact, el xestor d'información personal "
"integráu de KDE."

#. (itstool) path: description/p
#: org.kde.kmail.appdata.xml:11
msgid "Features:"
msgstr "Carauterístiques:"

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:13
msgid "Supports the standard mail protocols IMAP, POP3 and SMTP."
msgstr "Sofita los protocolos de correu estándar IMAP, POP3 y SMTP."

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:14
msgid ""
"Supports authentication via NTLM (Microsoft Windows) and GSSAPI (Kerberos)"
msgstr ""
"Sofita l'autenticación per NTLM (Microsoft Windows) y GSSAPI (Kerberos)"

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:15
msgid "Supports plain text and secure logins, using SSL and TLS."
msgstr "Sofita testu planu y anicios de sesión seguros, usando SSL y TLS."

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:16
msgid ""
"Integration of international character sets and spell-checking (as-you-type "
"and on demand)"
msgstr ""
"Integración de conxuntos de carauteres internacionales y comprobación "
"d'escritura (como-escribes y so demanda)"

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:17
msgid "Native support for inline OpenPGP, PGP/MIME, and S/MIME."
msgstr "Sofitu nativu pa OpenPGP, PGP/MIME, y S/MIME en llinia."

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:18
msgid "Reading and writing of HTML mail."
msgstr "Llectura y escritura de corréu HTML."

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:19
msgid "Ability to display plain text only from an HTML mail."
msgstr "L'habilidá d'amosar el testu planu d'un corréu HTML."

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:20
msgid "Allows you to receive and accept invitations."
msgstr "Permítete recibir y aceutar invitaciones."

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:21
msgid ""
"Integration with popular spam checkers, e.g. SpamAssassin, Bogofilter, etc."
msgstr ""
"Integración colos comprobadores d'spam populares exem. SpamAssassin, "
"Bogofilter, etc."

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:22
msgid "An optional spam probability meter can be displayed"
msgstr "Pue amosase un mididor de probabilidá d'spam adicional"

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:23
msgid "Powerful search and filter abilities"
msgstr "Habilidaes poderoses de gueta y peñera"

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:24
msgid "Can import mail from many other clients"
msgstr "Pue importase'l corréu dende munchos otros veceros"

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:25
msgid "Searching in IMAP folders fully supported"
msgstr "Sofítase la gueta en carpetes IMAP dafechu"

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:26
msgid "Highly integrated with other Kontact components"
msgstr "Altamente integráu colos otros componentes de Kontact"

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:27
msgid "Encrypted password saving in KWallet"
msgstr "Les contraseñes cifraes guárdense en KWallet"

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:28
msgid ""
"Flagging and tagging of messages to aid sorting and recovery of information"
msgstr ""
"Marcáu y etiquetáu de mensaxes p'ayudar nel orde y la recuperación "
"d'información"

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:29
msgid "Supports mailing list management features"
msgstr "Sofita carauterístiques de xestión de llistes de corréu"

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:30
msgid "Can replace text smilies with emoticons"
msgstr "Puen trocase fustaxes n'ASCII por fustaxes normales"

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:31
msgid "Displays the sender's picture or avatar if present in the address book"
msgstr ""
"Amuesa la semeya del remitente o avatar si tan disponibles na llibreta de "
"direiciones"

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:32
msgid "Supports X-Face (b/w pictures in messages)"
msgstr "Sofita X-Face (b/w semeyes en mensaxes)"

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:33
msgid "Compression of attachments"
msgstr "Compresion d'axuntos"

#. (itstool) path: ul/li
#: org.kde.kmail.appdata.xml:34
msgid "KMail supports Groupware functionality."
msgstr "KMail sofita la funcionalidá de grupu d'aplicaciones."
