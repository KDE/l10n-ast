msgid ""
"<TABLE>\n"
"<TR>\n"
"<TD>Examples:\n"
"<PRE>\n"
"    http://hostname:631/ipp/\n"
"    http://hostname:631/ipp/port1\n"
"\n"
"    ipp://hostname/ipp/\n"
"    ipp://hostname/ipp/port1\n"
"\n"
"    lpd://hostname/queue\n"
"\n"
"    socket://hostname\n"
"    socket://hostname:9100\n"
"</PRE>\n"
"\n"
"<P>See <A HREF=\"http://localhost:631/help/network.html\" TARGET=\"_blank\">"
"\"Network\n"
"Printers\"</A> for the correct URI to use with your printer.</P>\n"
"</TD>\n"
"</TR>\n"
"</TABLE>"
msgstr ""
"<TABLE>\n"
"<TR>\n"
"<TD>Exemplos:\n"
"<PRE>\n"
"    http://nomeagospiu:631/ipp/\n"
"    http://nomeagospiu:631/ipp/port1\n"
"\n"
"    ipp://nomeagospiu/ipp/\n"
"    ipp://nomeagospiu/ipp/puertu1\n"
"\n"
"    lpd://nomeagospiu/cola\n"
"\n"
"    socket://nomeagospiu\n"
"    socket://nomeagospiu:9100\n"
"</PRE>\n"
"\n"
"<P>Mira «<A HREF=\"http://localhost:631/help/network.html\" TARGET=\"_blank"
"\">Imprentadores\n"
"de rede</A>» pal URI correutu a usar cola to imprentadora.</P>\n"
"</TD>\n"
"</TR>\n"
"</TABLE>"

