#. (itstool) path: component/name
#: org.kde.filelight.appdata.xml:6
msgid "Filelight"
msgstr "Filelight"

#. (itstool) path: component/summary
#: org.kde.filelight.appdata.xml:7
msgid ""
"Filelight creates an interactive map of concentric segmented-rings that helps"
" visualize disk usage on your computer"
msgstr ""
"Filelight crea un mapa interactivu d'aniellos concéntricos y segmentaos"
" qu'ayuda a visualizar l'usu de los discos del ordenador"

#. (itstool) path: description/p
#: org.kde.filelight.appdata.xml:9
msgid ""
"Filelight is an application to visualize the disk usage on your computer"
msgstr ""
"Filelight ye una aplicación pa visualizar l'espaciu en discu del ordenador"

#. (itstool) path: description/p
#: org.kde.filelight.appdata.xml:12
msgid "Features:"
msgstr "Carauterístiques:"

#. (itstool) path: ul/li
#: org.kde.filelight.appdata.xml:14
msgid "Scan local, remote or removable disks"
msgstr "Escanéu de discos llocalles, remotos o estrayibles"

#. (itstool) path: ul/li
#: org.kde.filelight.appdata.xml:15
msgid "Configurable color schemes"
msgstr "Esquemes de colores configurables"

#. (itstool) path: ul/li
#: org.kde.filelight.appdata.xml:16
msgid "File system navigation by mouse clicks"
msgstr "Navegación pelos sistemes de ficheros pente calcos del mur"

#. (itstool) path: ul/li
#: org.kde.filelight.appdata.xml:17
msgid "Information about files and directories on hovering"
msgstr "Información tocante a ficheros y direutorios al pasar penriba'l mur"

#. (itstool) path: ul/li
#: org.kde.filelight.appdata.xml:18
msgid ""
"Files and directories can be copied or removed directly from the context menu"
msgstr ""
"Los ficheros y direutorios puen copiase o desaniciase direutamente dende'l"
" menú contestual"

#. (itstool) path: ul/li
#: org.kde.filelight.appdata.xml:19
msgid "Integration into Konqueror and Krusader"
msgstr "Integración con Konqueror y Krusader"
