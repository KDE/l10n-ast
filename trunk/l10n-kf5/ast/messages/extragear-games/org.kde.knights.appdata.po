#. (itstool) path: component/name
#: org.kde.knights.appdata.xml:6
msgid "KNights"
msgstr "KNights"

#. (itstool) path: component/summary
#: org.kde.knights.appdata.xml:7
msgid "Chess game"
msgstr "Xuegu d'axedrez"

#. (itstool) path: description/p
#: org.kde.knights.appdata.xml:9
msgid ""
"KNights is a chess game. As a player, your goal is to defeat your opponent "
"by checkmating their king."
msgstr ""
"KNights ye un xuegu d'axedrez. Como xugador, la to meta ye vencer al "
"oponente faciéndo-y un xaque mate al so rei."

