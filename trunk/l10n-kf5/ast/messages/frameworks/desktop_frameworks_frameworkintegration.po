#: plasma_workspace.notifyrc:1659
msgctxt "Name"
msgid "Widget deleted"
msgstr "Widget desaniciáu"

#: plasma_workspace.notifyrc:1697
msgctxt "Comment"
msgid "A widget has been deleted"
msgstr "Desanicióse un widget"
