msgstr "Ta amosándose un mensaxe d'información"

#: plasma_workspace.notifyrc:1242
msgctxt "Name"
msgid "Warning Message"
msgstr "Mensaxe d'alvertencia"

#: plasma_workspace.notifyrc:1284
msgctxt "Comment"
msgid "A warning message is being shown"
msgstr "Ta amosándose un mensaxe d'alvertencia"

#: plasma_workspace.notifyrc:1329
msgctxt "Name"
msgid "Critical Message"
msgstr "Mensaxe críticu"

#: plasma_workspace.notifyrc:1371
msgctxt "Comment"
msgid "A critical message is being shown"
msgstr "Ta amosándose un mensaxe críticu"

#: plasma_workspace.notifyrc:1416
msgctxt "Name"
msgid "Question"
msgstr "Entruga"

#: plasma_workspace.notifyrc:1459
msgctxt "Comment"
msgid "A question is being asked"
msgstr "Ta faciéndose una entruga"

#: plasma_workspace.notifyrc:1505
msgctxt "Name"
msgid "Beep"
msgstr "Bip"

#: plasma_workspace.notifyrc:1547
msgctxt "Comment"
msgid "Sound bell"
