#: plasma_workspace.notifyrc:3
msgctxt "Comment"
msgid "Plasma Workspace"
msgstr "Estaya de trabayu de Plasma"

#: plasma_workspace.notifyrc:51
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "Papelera balerada"

#: plasma_workspace.notifyrc:97
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "La papelera baleróse"

#: plasma_workspace.notifyrc:147
msgctxt "Name"
msgid "Textcompletion: Rotation"
msgstr ""

#: plasma_workspace.notifyrc:191
msgctxt "Comment"
msgid "The end of the list of matches has been reached"
msgstr "Algamóse la fin de la llista de coincidencies"

#: plasma_workspace.notifyrc:240
msgctxt "Name"
msgid "Textcompletion: No Match"
msgstr "Completáu de testu: Nun hai coincidencies"

#: plasma_workspace.notifyrc:285
msgctxt "Comment"
msgid "No matching completion was found"
msgstr "Nun s'alcontró denguna coincidencia que concasare"

#: plasma_workspace.notifyrc:334
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "Completáu de testu: Coincidencia parcial"

#: plasma_workspace.notifyrc:379
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Hai más d'una coincidencia posible"

#: plasma_workspace.notifyrc:428
msgctxt "Name"
msgid "Fatal Error"
msgstr "Fallu fatal"

#: plasma_workspace.notifyrc:473
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Hebo un fallu grave que fizo que'l programa colare"

#: plasma_workspace.notifyrc:523
msgctxt "Name"
msgid "Notification"
msgstr "Avisu"

#: plasma_workspace.notifyrc:569
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Asocedió daqué especial nel programa"

#: plasma_workspace.notifyrc:618
msgctxt "Name"
msgid "Warning"
msgstr "Alvertencia"

#: plasma_workspace.notifyrc:664
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr ""

#: plasma_workspace.notifyrc:712
msgctxt "Name"
msgid "Catastrophe"
msgstr "Catástrofe"

#: plasma_workspace.notifyrc:757
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr ""
"Asocedió un fallu pergrave que causó que, polo menos, el programa colara"

#: plasma_workspace.notifyrc:806
msgctxt "Name"
msgid "Application Crash"
msgstr "Casque d'aplicación"

#: plasma_workspace.notifyrc:848
msgctxt "Comment"
msgid "An application just closed unexpectedly"
msgstr "Una aplicación ta acabante de zarrase inesperadamente"

#: plasma_workspace.notifyrc:893
msgctxt "Name"
msgid "Login"
msgstr "Aniciu de sesión"

#: plasma_workspace.notifyrc:939
msgctxt "Comment"
msgid "A new session is starting"
msgstr "Ta aniciándose una sesión nueva"

#: plasma_workspace.notifyrc:988
msgctxt "Name"
msgid "Logout"
msgstr "Zarru de sesión"

#: plasma_workspace.notifyrc:1034
msgctxt "Comment"
msgid "Session is exiting"
msgstr "La sesión ta colando"

#: plasma_workspace.notifyrc:1084
msgctxt "Name"
msgid "Logout Canceled"
msgstr "Zarru de sesión encaboxáu"

#: plasma_workspace.notifyrc:1130
msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "Encaboxóse'l zarru de sesión de Plasma"

#: plasma_workspace.notifyrc:1179
msgctxt "Name"
msgid "Print Error"
msgstr "Fallu d'imprentación"

