#: plasma_workspace.notifyrc:1369
msgctxt "Name"
msgid "Warning Message"
msgstr "Mensaxe d'alvertencia"

#: plasma_workspace.notifyrc:1415
msgctxt "Comment"
msgid "A warning message is being shown"
msgstr "Ta amosándose un mensaxe d'alvertencia"

#: plasma_workspace.notifyrc:1464
msgctxt "Name"
msgid "Critical Message"
msgstr "Mensaxe críticu"

#: plasma_workspace.notifyrc:1510
msgctxt "Comment"
msgid "A critical message is being shown"
msgstr "Ta amosándose un mensaxe críticu"

#: plasma_workspace.notifyrc:1559
msgctxt "Name"
msgid "Question"
msgstr "Entruga"

#: plasma_workspace.notifyrc:1605
msgctxt "Comment"
msgid "A question is being asked"
msgstr "Ta entrugándose daqué"

#: plasma_workspace.notifyrc:1655
msgctxt "Name"
msgid "Beep"
msgstr "Pip"

#: plasma_workspace.notifyrc:1701
msgctxt "Comment"
msgid "Sound bell"
