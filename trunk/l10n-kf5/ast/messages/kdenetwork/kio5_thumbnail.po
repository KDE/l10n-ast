#: jpegcreator.cpp:66
#, kde-format
msgctxt "@option:check"
msgid "Rotate the image automatically"
msgstr "Voltiar la imaxe automática"

#: thumbnail.cpp:187
#, kde-format
msgid "No MIME Type specified."
msgstr "Nun s'especificó triba MIME dala"

#: thumbnail.cpp:196
#, kde-format
msgid "No or invalid size specified."
msgstr "Nun s'especificó nun ye un tamañu válidu."

#: thumbnail.cpp:230
#, kde-format
msgid "Cannot create thumbnail for directory"
msgstr "Nun pue crease la miniatura pal direutoriu"

#: thumbnail.cpp:242
#, kde-format
msgid "No plugin specified."
msgstr "Nun s'especificó complementu dalu"

#: thumbnail.cpp:248
#, kde-format
msgid "Cannot load ThumbCreator %1"
msgstr "Nun pue cargase ThumbCreator %1"

#: thumbnail.cpp:257
#, kde-format
msgid "Cannot create thumbnail for %1"
msgstr "Nun pue crease la miniatura pa %1"

#: thumbnail.cpp:295
#, kde-format
msgid "Failed to create a thumbnail."
msgstr "Fallu al crear una miniatura"

#: thumbnail.cpp:307
#, kde-format
msgid "Could not write image."
msgstr "Nun pudo escribise la imaxe."

#: thumbnail.cpp:332
#, kde-format
msgid "Failed to attach to shared memory segment %1"
msgstr "Fallu al axuntar nel segmentu de memoria compartida %1"

#: thumbnail.cpp:336
#, kde-format
msgid "Image is too big for the shared memory segment"
msgstr "La imaxe ye pergrande pal segmentu de memoria compartida"
