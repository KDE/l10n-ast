#: kio_mtp.cpp:311
#, kde-format
msgid ""
"No Storages found. Make sure your device is unlocked and has MTP enabled in "
"its USB connection settings."
msgstr ""
"Nun s'alcontraron almacenamientos. Asegúrate que'l to preséu ta desbloquiáu "
"y tien el MTP habilitáu nos sos axustes de conexón USB."

#: kio_mtp.cpp:600
#, kde-format
msgid "Cannot copy/move files on the device itself"
msgstr "Nun puen copiase/movese ficheros al preséu mesmu"
