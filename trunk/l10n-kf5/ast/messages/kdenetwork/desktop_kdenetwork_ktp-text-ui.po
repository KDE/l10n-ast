msgid "Text Formatting"
msgstr "Formatéu de testu"

#: filters/formatting/ktptextui_message_filter_formatting.desktop.cmake:49
msgctxt "Comment"
msgid ""
"Use /, _, * and - to make text italic, underlined, bold or strikeout "
