#: kio_sftp.cpp:201
msgid "Incorrect or invalid passphrase"
msgstr "Fras de pasu incorreuta o non válida"

#: kio_sftp.cpp:284 kio_sftp.cpp:286 kio_sftp.cpp:819
msgid "SFTP Login"
msgstr "Aniciu de sesión SFTP"

#: kio_sftp.cpp:301
msgid "Use the username input field to answer this question."
msgstr "Usa'l campu d'entrada de nome d'usuariu pa responder a esta entruga."

#: kio_sftp.cpp:314
msgid "Please enter your password."
msgstr "Introduz la to contraseña, por favor."

#: kio_sftp.cpp:319 kio_sftp.cpp:822
msgid "Site:"
msgstr "Sitiu:"

#: kio_sftp.cpp:469
msgid "Could not allocate callbacks"
msgstr ""

#: kio_sftp.cpp:486
msgid "Could not set log verbosity."
msgstr ""

#: kio_sftp.cpp:492
msgid "Could not set log userdata."
msgstr "Nun pudieron rexistrase los datos del usuariu."

#: kio_sftp.cpp:498
msgid "Could not set log callback."
msgstr ""

#: kio_sftp.cpp:537
msgid "Could not create a new SSH session."
msgstr "Nun pudo crease una sesión SSH nueva."

#: kio_sftp.cpp:548 kio_sftp.cpp:553
msgid "Could not set a timeout."
msgstr "Nun pudo afitase un tiempu escosao"

#: kio_sftp.cpp:560 kio_sftp.cpp:566
msgid "Could not set compression."
msgstr "Nun pudo afitase la compresión."

#: kio_sftp.cpp:573
msgid "Could not set host."
msgstr "Nun pudo afitase l'agospiador."

#: kio_sftp.cpp:580
msgid "Could not set port."
msgstr "Nun pudo afitase'l puertu."

#: kio_sftp.cpp:589
msgid "Could not set username."
msgstr "Nun pudo afitase'l nome d'usuariu"

#: kio_sftp.cpp:597
msgid "Could not parse the config file."
msgstr "Nun pudo analizase'l ficheru de configuración."

#: kio_sftp.cpp:627
#, kde-format
msgid "Opening SFTP connection to host %1:%2"
msgstr "Abriendo conexón SFTP nel agospiu %1:%2"

#: kio_sftp.cpp:684
msgid "Could not create hash from server public key"
msgstr "Nun pudo crease l'hash dende'l sirvidor públicu"

#: kio_sftp.cpp:698
#, kde-format
msgid ""
"The host key for this server was not found, but another type of key exists.\n"
"An attacker might change the default server key to confuse your client into "
"thinking the key does not exist.\n"
"Please contact your system administrator.\n"
"%1"
msgstr ""
"Nun s'alcontró la clave del agospiu pa esti sirvidor pero esiste otra triba "
"clave.\n"
"Quiciabes un atacante camudare la clave por defeutu del sirvidor pa "
"tracamundiar al to sirvidor cuidando que la to clave nun esiste.\n"
"Contauta col to alministrador de sistemes, por favor. %1"

#: kio_sftp.cpp:709
#, kde-format
msgid ""
"The host key for the server %1 has changed.\n"
"This could either mean that DNS SPOOFING is happening or the IP address for "
"the host and its host key have changed at the same time.\n"
"The fingerprint for the key sent by the remote host is:\n"
" %2\n"
"Please contact your system administrator.\n"
"%3"
msgstr ""

#: kio_sftp.cpp:722
msgid "Warning: Cannot verify host's identity."
msgstr "Alvertencia: Nun pudo verificase la identidá del agospiador."

#: kio_sftp.cpp:723
#, kde-format
msgid ""
"The authenticity of host %1 cannot be established.\n"
"The key fingerprint is: %2\n"
"Are you sure you want to continue connecting?"
msgstr ""
"Nun pue afitase l'autenticidá del agospiu %1.\n"
"La buelga clave ye: %2\n"
"¿De xuru que quies siguir cola conexón?"

#: kio_sftp.cpp:754 kio_sftp.cpp:777 kio_sftp.cpp:794 kio_sftp.cpp:810
#: kio_sftp.cpp:865 kio_sftp.cpp:876
msgid "Authentication failed."
msgstr "Falló l'autenticación."

#: kio_sftp.cpp:762
msgid ""
"Authentication failed. The server didn't send any authentication methods"
msgstr ""
"Falló l'autenticación. El sirvidor nun unvió dal métodu d'autenticación"

#: kio_sftp.cpp:820
msgid "Please enter your username and password."
msgstr "Introduz el to nome d'usuariu y contraseña, por favor."

#: kio_sftp.cpp:831
msgid "Incorrect username or password"
msgstr "Nome d'usuariu o contraseña incorreutos"

#: kio_sftp.cpp:885
msgid ""
"Unable to request the SFTP subsystem. Make sure SFTP is enabled on the "
"server."
msgstr ""
"Nun pue solicitase'l sosistema SFTP. Asegúrate que s'habilitó'l SFTP nel "
"sirvidor."

#: kio_sftp.cpp:893
msgid "Could not initialize the SFTP session."
msgstr "Nun pudo aniciase la sesión SFTP."

#: kio_sftp.cpp:898
#, kde-format
msgid "Successfully connected to %1"
msgstr "Coneutóse con ésitu a %1"

#: kio_sftp.cpp:1850
#, kde-format
msgid "Could not read link: %1"
msgstr "Nun pudo lleese l'enllaz: %1"

#: kio_sftp.cpp:2250
#, kde-format
msgid ""
"Could not change permissions for\n"
"%1"
msgstr ""
"Nun pudieron camudase los permisos pa\n"
"%1"
