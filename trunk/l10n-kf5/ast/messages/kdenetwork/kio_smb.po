msgstr "Nun esiste'l ficheru: %1"

#: kio_smb_browse.cpp:221
#, kde-format
msgid ""
"Unable to find any workgroups in your local network. This might be caused by "
"an enabled firewall."
msgstr ""
"Nun puen alcontrase grupos de trabayu dalos na to rede llocal. Esto "
"quiciabes tea causao por un tornafuéu habilitáu."

