msgstr "Usa'l campu d'entrada del nome d'usuariu pa responde esta entruga"

#: kio_sftp.cpp:306
#, kde-format
msgid "Please enter your password."
msgstr "Introduz la to contraseña, por favor."

#: kio_sftp.cpp:311 kio_sftp.cpp:820
