#: other/kcm_grub2.desktop:12
msgctxt "Name"
msgid "GRUB2 Bootloader"
msgstr "Cargador d'arrinque GRUB2"

#: other/kcm_grub2.desktop:51
msgctxt "Comment"
msgid "Customize the GRUB2 bootloader"
msgstr "Personaliza'l cargador d'arrinque GRUB2"

#: other/kcm_grub2.desktop:90
msgctxt "X-KDE-Keywords"
msgid ""
"grub,boot,menu,entries,default,timeout,password,color,splash,image,bootloader"
msgstr ""
"grub,arrinque,arrincar,menú,entrada,entraes,contraseña,color,aspeutu,imaxe,"
"xestor d'arrinque"

#: src/helper/kcmgrub2.actions:2
msgctxt "Name"
msgid "GRUB2 Bootloader Control Module"
msgstr "Módulu de control pal cargador d'arrinque GRUB2"

#: src/helper/kcmgrub2.actions:43
msgctxt "Name"
msgid "Restore the default GRUB2 Bootloader settings"
msgstr ""
"Restauración de los axustes predeterminaos del cargador d'arrinque GRUB2"

#: src/helper/kcmgrub2.actions:81
msgctxt "Description"
msgid ""
"Administrator authorization is required to restore the default GRUB2 "
"Bootloader settings"
msgstr ""
"Ríquese l'autorización del alministrador pa restaurar los axustes "
"predeterminaos del xestor d'arrinque GRUB2"

#: src/helper/kcmgrub2.actions:122
msgctxt "Name"
msgid "Install the GRUB2 Bootloader"
msgstr "Instalación del cargador d'arrinque GRUB2"

#: src/helper/kcmgrub2.actions:161
msgctxt "Description"
msgid "Administrator authorization is required to install the GRUB2 Bootloader"
msgstr ""
"Ríquese l'autorización del alministrador pa instalar el xestor d'arrinque "
"GRUB2"

#: src/helper/kcmgrub2.actions:203
msgctxt "Name"
msgid "Load the GRUB2 Bootloader settings"
msgstr "Carga de los axustes del cargador d'arrinque GRUB2"

#: src/helper/kcmgrub2.actions:242
msgctxt "Description"
msgid ""
"Administrator authorization is required to load the GRUB2 Bootloader settings"
msgstr ""
"Ríquese l'autorización del alministrador pa cargar los axustes "
"predeterminaos del xestor d'arrinque GRUB2"

#: src/helper/kcmgrub2.actions:284
msgctxt "Name"
msgid "Save the GRUB2 Bootloader settings"
msgstr "Guardáu de los axustes del cargador d'arrinque GRUB2"

#: src/helper/kcmgrub2.actions:322
msgctxt "Description"
msgid ""
"Administrator authorization is required to save the GRUB2 Bootloader settings"
msgstr ""
"Ríquese l'autorización del alministrador pa guardar los axustes "
"predeterminaos del xestor d'arrinque GRUB2"
